@inherits StateComponent
@* The last day's Inbox mail from Outlook in the right sidebar, below the appointments (DesktopState.RecentMail: at
   most ten mails received in the last 24 hours, newest first). It shows only while Outlook is on, and renders
   nothing while it loads for the first time. A row shows when the mail came in, the sender and the subject, cleaned
   for one line; rows have no click action. It reads only, and reloads whenever the state changes, keeping the
   shown rows. *@

@if (view is not null && view.Status != OutlookStatus.Off)
{
    <section class="recent-mail" aria-label="Mail">
        <h2 class="recent-mail-heading">Mail</h2>
        @if (OutlookStatusLine.Text(view.Status) is { } line)
        {
            <p class="outlook-status @OutlookStatusLine.Css(view.Status)" role="status">@line</p>
        }
        else if (view.Mails.Count == 0)
        {
            <p class="grey" role="status">No mail in the last day.</p>
        }
        else
        {
            @foreach (MailSummary mail in view.Mails)
            {
                string sender = DesktopText.OneLine(string.IsNullOrWhiteSpace(mail.Sender) ? "(no sender)" : mail.Sender);
                string subject = DesktopText.OneLine(string.IsNullOrWhiteSpace(mail.Subject) ? "(no subject)" : mail.Subject);
                <div class="mail-item" title="@subject">
                    <span class="time">@view.Time(mail)</span>
                    <span class="mail-sender cut">@sender</span>
                    <span class="mail-subject cut">@subject</span>
                </div>
            }
        }
    </section>
}

@code {
    private RecentMailView? view;
    private int request;

    protected override Task OnInitializedAsync() => Load();

    protected override async Task OnStateChangedAsync()
    {
        await Load();
        StateHasChanged();
    }

    // Keeps the shown rows while it reloads; only the newest request's result is used.
    private async Task Load()
    {
        int mine = ++request;
        RecentMailView result = await State.RecentMail();
        if (mine == request)
        {
            view = result;
        }
    }
}
