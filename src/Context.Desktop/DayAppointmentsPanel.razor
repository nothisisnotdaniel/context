@inherits StateComponent
@* The shown day's appointments at the top of the right sidebar (DesktopState.DayAppointments: the calendar files,
   the feed's cached copy and Outlook when it is on, never a download). On today it lists the last past appointment
   and every one not yet past (AppointmentList.Shown), on any other day all of them. The arrows step the day, the
   heading opens a month calendar (DayPicker) to jump to any day, and Today comes back to today; a click
   on an appointment asks Main to show its appointment page. Below the list, on every day, how reading Outlook went
   and the Exchange feed's status from the snapshot's current view (offline or failed; the link is never shown). It
   reads only, and reloads whenever the state changes, keeping the shown rows. *@

<section class="day-appointments" aria-label="Appointments">
    <div class="day-appointments-bar">
        <button type="button" class="day-prev" aria-label="Previous day" title="Previous day" disabled="@(Shown <= First)" @onclick="Previous"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg></button>
        <h2 class="day-appointments-day cut" title="@FullDay"><button type="button" class="day-appointments-open" aria-haspopup="dialog" aria-expanded="@(pickOpen ? "true" : "false")" @ref="openButton" @onclick="TogglePick">@Heading</button></h2>
        <button type="button" class="day-next" aria-label="Next day" title="Next day" disabled="@(Shown >= Last)" @onclick="Next"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg></button>
        @if (Shown != Today)
        {
            <button type="button" class="day-today" title="Back to today" @onclick="BackToToday">Today</button>
        }
    </div>
    @if (pickOpen)
    {
        <DayPicker Today="Today" Selected="Shown" OnPick="PickAsync" OnClose="ClosePick" OnToday="PickTodayAsync" />
    }
    @if (view is null)
    {
        <p class="grey" role="status">Loading…</p>
    }
    else
    {
        IReadOnlyList<Appointment> shown = AppointmentList.Shown(view.Appointments, view.LocalNow, view.Day == Today);
        DateTime from = view.Day.ToDateTime(TimeOnly.MinValue);
        @if (view.Failed)
        {
            <p class="red" role="status">Can't read the calendar.</p>
        }
        else if (shown.Count == 0)
        {
            <p class="grey" role="status">No appointments.</p>
        }
        else
        {
            <ul class="appointment-items">
                @foreach (Appointment appointment in shown)
                {
                    string rawTitle = appointment.Title;
                    string title = DesktopText.OneLine(rawTitle.Length == 0 ? "(no title)" : rawTitle);
                    string time = CurrentView.Time(appointment, from, from.AddDays(1));
                    DateOnly day = view.Day;
                    <li>
                        <button type="button" class="appointment-item" title="@title" @onclick="() => OnOpen.InvokeAsync((rawTitle, day))">
                            <span class="time">@time</span>
                            <span class="appointment-title cut">@title</span>
                        </button>
                    </li>
                }
            </ul>
        }
        @foreach (string name in view.Unreadable)
        {
            <p class="red" role="status">Can't read @CalendarStore.FolderName/@DesktopText.OneLine(name)</p>
        }
        @if (OutlookStatusLine.Text(view.Outlook) is { } outlookLine)
        {
            <p class="outlook-status @OutlookStatusLine.Css(view.Outlook)" role="status">@outlookLine</p>
        }
        @if (Snapshot?.Current is { } current)
        {
            @if (current.Status == CalendarFeedStatus.Stale && current.CachedAtUtc is { } cachedAt)
            {
                <p class="grey feed">Exchange calendar offline, showing the copy from @CacheTime(current, cachedAt).</p>
            }
            else if (current.Status == CalendarFeedStatus.Failed)
            {
                <p class="red feed">Can't download the Exchange calendar (@DesktopText.OneLine(current.Reason ?? string.Empty)).</p>
            }
        }
    }
</section>

@code {
    /// <summary>The earliest day the arrows reach.</summary>
    internal static readonly DateOnly First = new(1900, 1, 1);

    /// <summary>The latest day the arrows reach.</summary>
    internal static readonly DateOnly Last = new(2100, 12, 31);

    private DayAppointmentsView? view;
    private DateOnly? loaded;
    private int request;

    // The day the arrows or the calendar chose; null follows the snapshot's today.
    private DateOnly? chosen;

    private bool pickOpen;
    private bool focusOpenButton;
    private ElementReference openButton;

    /// <summary>The heading button, which takes the focus back when the calendar closes (for tests).</summary>
    internal ElementReference OpenButtonReference => openButton;

    /// <summary>Called with an appointment's raw title and the shown day when it is clicked.</summary>
    [Parameter]
    public EventCallback<(string Title, DateOnly Day)> OnOpen { get; set; }

    private DateOnly Today => Snapshot?.Today ?? First;

    private DateOnly Shown => chosen ?? Today;

    private string Heading => Shown == Today
        ? "Today"
        : Shown.ToString("dddd, d MMM yyyy", CultureInfo.InvariantCulture);

    // The shown day's full name, today too: the heading's title.
    private string FullDay => Shown.ToString("dddd, d MMMM yyyy", CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The calendar just closed (or Today went away): the focus goes back to the heading button, never to the page.
        if (focusOpenButton && !pickOpen)
        {
            focusOpenButton = false;
            await openButton.FocusAsync();
        }
    }

    protected override Task OnParametersSetAsync() => LoadIfMoved();

    protected override async Task OnStateChangedAsync()
    {
        if (loaded != Shown)
        {
            await LoadIfMoved();
        }
        else
        {
            await Load();
        }

        StateHasChanged();
    }

    private Task Previous() => Step(-1);

    private Task Next() => Step(1);

    private Task Step(int days)
    {
        DateOnly shown = Shown;
        if ((days < 0 && shown <= First) || (days > 0 && shown >= Last))
        {
            return Task.CompletedTask;
        }

        return ShowDay(shown.AddDays(days));
    }

    // The heading opens the calendar (a new DayPicker on the shown day each time) or closes it.
    private void TogglePick()
    {
        pickOpen = !pickOpen;
        focusOpenButton = false;
    }

    private void ClosePick()
    {
        if (!pickOpen)
        {
            return;
        }

        pickOpen = false;
        focusOpenButton = true;
    }

    // A day was picked: the calendar closes and the panel shows that day, as the arrows do (today follows the
    // snapshot again). A second event for the same choice finds the calendar closed and does nothing.
    private Task PickAsync(DateOnly day)
    {
        if (!pickOpen || day < First || day > Last)
        {
            return Task.CompletedTask;
        }

        ClosePick();
        return ShowDay(day);
    }

    private Task PickTodayAsync() => pickOpen ? PickAsync(Today) : Task.CompletedTask;

    // The Today button goes away with the click, so the focus moves to the heading button instead of the page.
    private Task BackToToday()
    {
        focusOpenButton = true;
        return ShowDay(Today);
    }

    private Task ShowDay(DateOnly day)
    {
        chosen = day == Today ? null : day;
        return LoadIfMoved();
    }

    // Another day: its rows are not known yet, so the old ones go.
    private Task LoadIfMoved()
    {
        if (loaded == Shown)
        {
            return Task.CompletedTask;
        }

        loaded = Shown;
        view = null;
        return Load();
    }

    // The time of the feed's cached copy in the calendar's zone.
    private static string CacheTime(CurrentView current, DateTime cachedAtUtc)
    {
        DateTime local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(cachedAtUtc, DateTimeKind.Utc), current.Zone);
        return local.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    // Keeps the shown rows while it reloads. A result for another day, or an older request's result, is dropped.
    private async Task Load()
    {
        int mine = ++request;
        DateOnly day = Shown;
        DayAppointmentsView result = await State.DayAppointments(day);
        if (mine == request && result.Day == Shown)
        {
            view = result;
        }
    }
}
