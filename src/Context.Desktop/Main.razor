    // Asked before a capture (the palette and the top bar): the open inbox has unsaved changes, which a capture would
    // leave stuck behind "changed on disk". Null when the capture may run.
    private async Task<string?> CaptureHeld()
    {
        if (InboxOpen() && openName is { } name && await KeptUnsaved())
        {
            return $"Save {name} first.";
        }

        return null;
    }

    // The one capture flow (the palette's /capture <text> and the top bar's Capture popover): the open-inbox guard,
    // the action and its answer in the main status line, then the editor reload. True when the text was captured.
    private async Task<bool> CaptureAsync(string text)
    {
        // The top bar calls this through a plain Func (it needs the result), which re-renders only the top bar, so
        // every answer re-renders Main itself.
        if (await CaptureHeld() is { } held)
        {
            ShowStatus(DesktopText.OneLine(held), "red");
            StateHasChanged();
            return false;
        }

        if (running)
        {
            return false;
        }

        running = true;
        ActionResult captured;
        try
        {
            captured = await Actions.CaptureText(text);
        }
        finally
        {
            running = false;
        }

        ShowStatus(DesktopText.OneLine(captured.Text), captured.Kind == ActionKind.Done ? "accent" : "red");
        StateHasChanged();
        if (captured.Kind != ActionKind.Done)
        {
            return false;
        }

        await Captured();
        return true;
    }

    // After a capture: an open inbox shows the new line, and its next save starts from the file as it is now. Text
    // typed into the editor since the check is kept instead.
    private async Task Captured()
    {
        if (InboxOpen() && editor is not null && !await editor.IsDirtyAsync())
        {
            await editor.ReloadAsync();
        }
    }

    // Asked before a triage action (target: the existing note it adds to, or null): the open inbox or the open target
    // has unsaved changes, which the write would leave stuck behind "changed on disk". Null when the action may run.
    private async Task<string?> TriageHeld(string? target)
    {
        if (openName is not { } name || editor is null)
        {
            return null;
        }

        bool touched = InboxOpen() || (target is not null && string.Equals(name, target, StringComparison.Ordinal));
        if (touched && await KeptUnsaved())
        {
            return $"Save {name} first.";
        }

        return null;
    }

    // After a triage action: an open inbox and an open target show what was written, unless text was typed into the
    // editor since the check. A sensitive target shows the note as re-sealed (still held by the session).
    private async Task Triaged(string target)
    {
        if (openName is not { } name || editor is null || await editor.IsDirtyAsync())
        {
            return;
        }

        if (target.Length > 0 && string.Equals(name, target, StringComparison.Ordinal))
        {
            if (openSensitive)
            {
                if (State.Session.Note is { } saved && string.Equals(saved.Name, name, StringComparison.Ordinal))
                {
                    await editor.ShowSavedAsync(saved);
                }
            }
            else
            {
                await editor.ReloadAsync();
            }
        }
        else if (InboxOpen())
        {
            await editor.ReloadAsync();
        }
    }

