    // Asked before a capture (the palette and the top bar): the open inbox has unsaved changes, which a capture would
    // leave stuck behind "changed on disk". Null when the capture may run.
    private async Task<string?> CaptureHeld()
    {
        if (InboxOpen() && openName is { } name && await KeptUnsaved())
        {
            return $"Save {name} first.";
        }

        return null;
    }

    // The one capture flow (the palette's /capture <text> and the top bar's Capture popover): the open-inbox guard,
    // the action and its answer in the main status line, then the editor reload. True when the text was captured.
    private async Task<bool> CaptureAsync(string text)
    {
        // The top bar calls this through a plain Func (it needs the result), which re-renders only the top bar, so
        // every answer re-renders Main itself.
        if (await CaptureHeld() is { } held)
        {
            ShowStatus(DesktopText.OneLine(held), "red");
            StateHasChanged();
            return false;
        }

        if (running)
        {
            return false;
        }

        running = true;
        ActionResult captured;
        try
        {
            captured = await Actions.CaptureText(text);
        }
        finally
        {
            running = false;
        }

        ShowStatus(DesktopText.OneLine(captured.Text), captured.Kind == ActionKind.Done ? "accent" : "red");
        StateHasChanged();
        if (captured.Kind != ActionKind.Done)
        {
            return false;
        }

        await Captured();
        return true;
    }

    // The command bar's Context lines (job 282), the bar window's Enter key: todo, capture and note with the palette's
    // rules and guards, run on this page's dispatcher. todo is /todo's parsing and action, capture /capture's guard
    // and action, note appends a timed line to today's note (saved first when it is open with unsaved changes, and
    // reloaded after when it is clean). Called on the bar host's thread.
    private async Task<CommandBarResult> RunFromBar(string line)
    {
        CommandBarResult result = CommandBarResult.Error(CommandBarContext.NotReadyText);
        await InvokeAsync(async () =>
        {
            string trimmed = line.Trim();
            int split = trimmed.IndexOfAny([' ', '\t']);
            string word = split < 0 ? trimmed : trimmed[..split];
            string rest = split < 0 ? string.Empty : trimmed[(split + 1)..].Trim();
            if (Snapshot is null)
            {
                return;
            }

            if (running)
            {
                result = CommandBarResult.Error(DesktopActions.BusyText);
                return;
            }

            if (string.Equals(word, "todo", StringComparison.OrdinalIgnoreCase))
            {
                if (!TodoCommand.TryParse(rest, Snapshot.Today, out TodoCommand? todo, out string usage) || todo is null)
                {
                    result = CommandBarResult.Error("Type " + usage + ".");
                    return;
                }

                running = true;
                try
                {
                    ActionResult added = await Actions.AddTodo(todo.Text, todo.Due, todo.Repeat, todo.Time);
                    result = added.Kind == ActionKind.Done
                        ? CommandBarResult.Done($"Added: {DesktopText.OneLine(added.Text)}")
                        : CommandBarResult.Error(DesktopText.OneLine(added.Text));
                }
                finally
                {
                    running = false;
                }
            }
            else if (string.Equals(word, "capture", StringComparison.OrdinalIgnoreCase))
            {
                if (await CaptureHeld() is { } held)
                {
                    result = CommandBarResult.Error(DesktopText.OneLine(held));
                    return;
                }

                running = true;
                ActionResult captured;
                try
                {
                    captured = await Actions.CaptureText(rest);
                }
                finally
                {
                    running = false;
                }

                result = new CommandBarResult(captured.Kind == ActionKind.Done, DesktopText.OneLine(captured.Text));
                if (captured.Kind == ActionKind.Done)
                {
                    await Captured();
                }
            }
            else if (string.Equals(word, "note", StringComparison.OrdinalIgnoreCase))
            {
                string daily = Actions.DailyNoteName();
                bool dailyOpen = openName is { } shown && string.Equals(shown, daily, StringComparison.OrdinalIgnoreCase);
                if (dailyOpen && !openSensitive && await KeptUnsaved())
                {
                    result = CommandBarResult.Error($"Save {DesktopText.OneLine(openName ?? daily)} first.");
                    return;
                }

                running = true;
                ActionResult noted;
                try
                {
                    noted = await Actions.NoteToday(rest);
                }
                finally
                {
                    running = false;
                }

                result = new CommandBarResult(noted.Kind == ActionKind.Done, DesktopText.OneLine(noted.Text));
                if (noted.Kind == ActionKind.Done
                    && openName is { } open && string.Equals(open, noted.Name, StringComparison.OrdinalIgnoreCase)
                    && !openSensitive && editor is not null && !await editor.IsDirtyAsync())
                {
                    await editor.ReloadAsync();
                }
            }
            else
            {
                result = CommandBarResult.Error("Unknown command.");
            }

            StateHasChanged();
        });
        return result;
    }

