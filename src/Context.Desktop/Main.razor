    // The shown page's actions for the top bar's More actions menu: a plain or sensitive note's, End the day on today's
    // view, none on another day or on a page (Triage, Tags, Settings).
    private IReadOnlyList<PageAction> PageActionsFor(DesktopSnapshot snapshot)
    {
        if (page != Page.None)
        {
            return [];
        }

        if (openName is null)
        {
            return shownDay is { } day && day != snapshot.Today ? [] : [new PageAction("end-day", "End the day")];
        }

        PageAction[] common =
        [
            new PageAction("rename", "Rename"),
            new PageAction("delete", "Delete"),
            new PageAction("history", "History", historyShown),
        ];
        if (openSensitive)
        {
            return [.. common, new PageAction("make-plain", "Make plain"), new PageAction("lock", "Lock")];
        }

        PageAction[] plain =
        [
            .. common,
            new PageAction("new-subpage", "New subpage"),
            new PageAction("move", "Move"),
            new PageAction("open-external", "Open in default editor"),
            new PageAction("export", "Export"),
        ];
        return snapshot.SensitiveSupported ? [.. plain, new PageAction("mark-sensitive", "Mark sensitive")] : plain;
    }

    // A More actions item: the same handlers the toolbar buttons and End the day used to call. Open in default editor,
    // Export and End the day call the actions here, so every Actions call stays in a bound handler.
    private async Task RunPageAction(string id)
    {
        switch (id)
        {
            case "rename":
                await StartRename();
                break;
            case "delete":
                AskDelete();
                break;
            case "history":
                ToggleHistory();
                break;
            case "new-subpage":
                await StartSubpage();
                break;
            case "move":
                await StartMove();
                break;
            case "mark-sensitive":
                await AskMark();
                break;
            case "make-plain":
                await AskMakePlain();
                break;
            case "lock":
                await LockOpen();
                break;
            case "open-external":
            {
                if (openName is not { } name || running)
                {
                    return;
                }

                running = true;
                ActionResult opened;
                try
                {
                    opened = await Actions.OpenExternally(name);
                }
                finally
                {
                    running = false;
                }

                if (opened.Kind == ActionKind.Done)
                {
                    ShowStatus(string.Empty, string.Empty);
                }
                else
                {
                    ShowStatus(DesktopText.OneLine(opened.Text), "red");
                }

                break;
            }
            case "export":
            {
                if (await ExportTarget() is not { } chosen)
                {
                    return;
                }

                running = true;
                try
                {
                    ShowExported(await Actions.ExportNote(chosen.Name, chosen.Target));
                }
                finally
                {
                    running = false;
                }

                break;
            }
            case "end-day":
            {
                if (running || openName is not null || Snapshot is not { } snapshot || (shownDay is { } day && day != snapshot.Today))
                {
                    return;
                }

                running = true;
                ActionResult ended;
                try
                {
                    ended = await Actions.EndDay(snapshot.Today);
                }
                finally
                {
                    running = false;
                }

                bool ok = ended.Kind == ActionKind.Done && ended.Reason is ActionReason.None or ActionReason.Unchanged;
                ShowStatus(DesktopText.OneLine(ended.Text), ok ? "grey" : "red");
                break;
            }
        }
    }

    // The open note and where to write it, or null (with the reason in the status line) when there is nothing to
    // write: no note open, a sensitive note, unsaved changes, or the dialog was cancelled.
    private async Task<(string Name, string Target)?> ExportTarget()
    {
        if (openName is not { } name)
        {
            ShowStatus("Open a note first.", "red");
            return null;
        }

        if (running)
        {
            return null;
        }

        if (openSensitive)
        {
            ShowStatus(DesktopActions.ExportSensitiveText(DesktopText.OneLine(name)), "red");
            return null;
        }

        if (await KeptUnsaved())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return null;
        }

        string? target = Dialog.SaveExportFile(name[(name.LastIndexOf('/') + 1)..] + ".md");
        return target is null ? null : (name, target);
    }

    private void ShowExported(ActionResult exported) =>
        ShowStatus(DesktopText.OneLine(exported.Text), exported.Kind == ActionKind.Done ? "accent" : "red");

    // Splits "/new" text at its first "--template" token (a whitespace-separated word, ignoring case): the trimmed
    // title before it and the trimmed template name after it, or null when there is no such token.
    private static (string Title, string Template)? SplitTemplate(string text)
    {
        const string Flag = "--template";
        int i = 0;
        while (i < text.Length)
        {
            if (char.IsWhiteSpace(text[i]))
            {
                i++;
                continue;
            }

            int end = i;
            while (end < text.Length && !char.IsWhiteSpace(text[end]))
            {
                end++;
            }

            if (end - i == Flag.Length && string.Compare(text, i, Flag, 0, Flag.Length, StringComparison.OrdinalIgnoreCase) == 0)
            {
                return (text[..i].Trim(), text[end..].Trim());
            }

            i = end;
        }

        return null;
    }

    private void ShowStatus(string text, string cssClass)
    {
        statusText = text;
        statusClass = cssClass;
    }
}
