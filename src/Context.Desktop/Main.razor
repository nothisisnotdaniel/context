@inherits StateComponent

@if (Snapshot is { } snapshot)
{
    @if (snapshot.Failed)
    {
        <p class="red failed" role="alert">Can't read the data folder.</p>
    }
    else
    {
        <div class="layout" @onkeydown="OpenPalette">
            <aside class="notes-region">
                <NotesPanel @ref="notesPanel" OpenName="@openName" OnOpen="RequestOpen" OnTags="ShowTags" OnSettings="ShowSettings" />
            </aside>
            <main class="current-region">
                <CaptureBox Guard="CaptureHeld" OnCaptured="Captured" />
                @if (settingsShown)
                {
                    <SettingsPanel OnClose="CloseSettings" />
                }
                @if (tagsShown)
                {
                    <TagsPanel Selected="@tagShown" OnTag="ShowTag" OnClose="CloseTags" />
                }
                @if (tagShown is { } tag)
                {
                    <TagPanel Tag="@tag" OnOpen="RequestOpen" OnClose="CloseTag" />
                }
                <p class="main-status cut @statusClass" role="status" title="@statusText">@statusText</p>
                @if (openName is { } name)
                {
                    @if (name.Contains('/'))
                    {
                        <nav class="breadcrumb" aria-label="Breadcrumb">
                            <ol>
                                @foreach ((string ancestor, string segment) in Ancestors(name))
                                {
                                    string ancestorShown = DesktopText.OneLine(ancestor);
                                    string segmentShown = DesktopText.OneLine(segment);
                                    <li>
                                        <button type="button" class="crumb cut" title="@ancestorShown" @onclick="() => RequestOpen(ancestor)">@segmentShown</button>
                                    </li>
                                }
                                @{
                                    string currentShown = DesktopText.OneLine(name[(name.LastIndexOf('/') + 1)..]);
                                    string fullShown = DesktopText.OneLine(name);
                                }
                                <li><span class="crumb-current cut" aria-current="page" title="@fullShown">@currentShown</span></li>
                            </ol>
                        </nav>
                    }
                    <div class="note-toolbar">
                        @if (subpaging)
                        {
                            <input type="text" class="subpage-title" value="@subpageText" maxlength="200" disabled="@running"
                                   aria-label="Subpage title" @ref="subpageField" @oninput="SubpageTyped" @onkeydown="e => CreateSubpage(e)" />
                            <button type="button" class="create-subpage" disabled="@running" @onclick="() => CreateSubpage(null)">Create subpage</button>
                            <button type="button" class="cancel-subpage" disabled="@running" @onclick="CancelSubpage">Cancel</button>
                        }
                        else if (moving)
                        {
                            <input type="text" class="move-parent" value="@moveText" maxlength="500" disabled="@running"
                                   aria-label="New parent" placeholder="Empty: top level" @ref="moveField" @oninput="MoveTyped" @onkeydown="e => MoveHere(e)" />
                            <button type="button" class="move-here" disabled="@running" @onclick="() => MoveHere(null)">Move here</button>
                            <button type="button" class="cancel-move" disabled="@running" @onclick="CancelMove">Cancel</button>
                        }
                        else if (renaming)
                        {
                            <input type="text" class="rename-title" value="@renameText" maxlength="200" disabled="@running"
                                   aria-label="New name" @ref="renameField" @oninput="RenameTyped" @onkeydown="e => SaveName(e)" />
                            <button type="button" class="save-name" disabled="@running" @onclick="() => SaveName(null)">Save name</button>
                            <button type="button" class="cancel-rename" disabled="@running" @onclick="CancelRename">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="rename" disabled="@running" @onclick="StartRename">Rename</button>
                            <button type="button" class="delete" disabled="@running" @onclick="AskDelete">Delete</button>
                            @if (openSensitive)
                            {
                                <button type="button" class="make-plain" disabled="@running" @onclick="AskMakePlain">Make plain</button>
                                <button type="button" class="lock" disabled="@running" @onclick="LockOpen">Lock</button>
                            }
                            else
                            {
                                <button type="button" class="new-subpage" disabled="@running" @onclick="StartSubpage">New subpage</button>
                                <button type="button" class="move" disabled="@running" @onclick="StartMove">Move</button>
                                <button type="button" class="open-external" disabled="@running" @onclick="OpenOutside">Open in default editor</button>
                                <button type="button" class="export" disabled="@running" @onclick="Export">Export</button>
                                @if (snapshot.SensitiveSupported)
                                {
                                    <button type="button" class="mark-sensitive" disabled="@running" @onclick="AskMark">Mark sensitive</button>
                                }
                            }
                        }
                    </div>
                    <NoteEditor @key="(name, openSensitive)" @ref="editor" Name="@name" Sensitive="openSensitive"
                                OnTag="ShowTag" OnOpenNote="RequestOpen" OnIdle="LockOpen" OnLocked="Locked" />
                    <LinksPanel Name="@name" Sensitive="openSensitive" OnOpen="RequestOpen" OnTag="ShowTag" />
                }
                else
                {
                    <CurrentPanel />
                }
            </main>
            <aside class="todos-region">
                <TodoPanel />
            </aside>
        </div>
        @if (discarding)
        {
            <ConfirmDialog Question="@($"Discard changes to {DesktopText.OneLine(openName ?? string.Empty)}?")" ConfirmLabel="Discard"
                           OnConfirm="Discard" OnCancel="KeepEditing" />
        }
        @if (deleting && openName is { } doomed)
        {
            <ConfirmDialog Question="@DeleteQuestion(doomed)" ConfirmLabel="Delete"
                           Busy="running" OnConfirm="DeleteConfirmed" OnCancel="CancelDelete" />
        }
        @if (marking && openName is { } sealing)
        {
            <ConfirmDialog Question="@($"Mark {DesktopText.OneLine(sealing)} sensitive? It will open only in this app, with this machine's key or the recovery file.")"
                           ConfirmLabel="Mark sensitive" Busy="running" OnConfirm="MarkConfirmed" OnCancel="CancelSensitive" />
        }
        @if (unsealing && openName is { } plain)
        {
            <ConfirmDialog Question="@($"Make {DesktopText.OneLine(plain)} plain? It will be stored as readable text again.")"
                           ConfirmLabel="Make plain" Busy="running" OnConfirm="MakePlainConfirmed" OnCancel="CancelSensitive" />
        }
        @if (paletteOpen)
        {
            <CommandPalette OnRun="RunCommand" OnClose="ClosePalette" />
        }
    }
}
else
{
    <p class="grey loading" role="status">Loading…</p>
}

@code {
    private string? openName;
    private NoteEditor? editor;
    private string? tagShown;
    private bool tagsShown;
    private bool settingsShown;
    private bool discarding;
    private string? pendingName;
    private bool paletteOpen;
    private bool running;
    private string statusText = string.Empty;
    private string statusClass = string.Empty;
    private bool renaming;
    private string renameText = string.Empty;
    private ElementReference renameField;
    private bool focusRename;
    private bool deleting;
    private bool openSensitive;
    private bool marking;
    private bool unsealing;
    private NotesPanel? notesPanel;
    private bool subpaging;
    private string subpageText = string.Empty;
    private ElementReference subpageField;
    private bool moving;
    private string moveText = string.Empty;
    private ElementReference moveField;
    private bool focusField;

    /// <summary>The OS file dialogs.</summary>
    [Inject]
    internal IFileDialog Dialog { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusRename && renaming)
        {
            focusRename = false;
            await renameField.FocusAsync();
        }

        if (focusField && (subpaging || moving))
        {
            focusField = false;
            await (subpaging ? subpageField : moveField).FocusAsync();
        }
    }

    private void OpenPalette(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && string.Equals(e.Key, "k", StringComparison.OrdinalIgnoreCase) && !discarding && !deleting
            && !marking && !unsealing)
        {
            paletteOpen = true;
        }
    }

    private void ClosePalette() => paletteOpen = false;

    private void ShowTag(string tag)
    {
        tagShown = TagIndex.NormalizeTag(tag);
    }

    private void CloseTag() => tagShown = null;

    // The tags view: every tag with its note count; a click on one shows the tag panel below it.
    private void ShowTags() => tagsShown = true;

    private void CloseTags()
    {
        tagsShown = false;
        tagShown = null;
    }

    // The settings: shown at the top of the main region until closed or until a note or the current view opens.
    private void ShowSettings() => settingsShown = true;

    private void CloseSettings() => settingsShown = false;

    // Opens the note called name (null: the current view), asking first when the open note has unsaved changes.
    private async Task RequestOpen(string? name)
    {
        if (name is not null && string.Equals(name, openName, StringComparison.Ordinal))
        {
            settingsShown = false;
            return;
        }

        if (editor is not null && openName is not null && await editor.IsDirtyAsync())
        {
            pendingName = name;
            discarding = true;
            return;
        }

        ShowNote(name);
    }

    private void Discard(Confirmation confirmed)
    {
        discarding = false;
        ShowNote(pendingName);
    }

    private void KeepEditing()
    {
        discarding = false;
        pendingName = null;
    }

    private void ShowNote(string? name)
    {
        openName = name;
        openSensitive = name is not null
            && Snapshot is { } snapshot
            && snapshot.Sensitive.Any(n => string.Equals(n.Name, name, StringComparison.Ordinal));
        pendingName = null;
        tagShown = null;
        tagsShown = false;
        settingsShown = false;
        renaming = false;
        subpaging = false;
        moving = false;
        deleting = false;
        marking = false;
        unsealing = false;
        if (name is null)
        {
            editor = null;
        }

        ShowStatus(string.Empty, string.Empty);
    }

    // Runs a palette command; the palette closes first.
    private async Task RunCommand(string line)
    {
        paletteOpen = false;
        string trimmed = line.Trim();
        int space = trimmed.IndexOfAny([' ', '\t']);
        string command = (space < 0 ? trimmed : trimmed[..space]).ToLowerInvariant();
        string rest = space < 0 ? string.Empty : trimmed[(space + 1)..].Trim();
        switch (command)
        {
            case "/capture":
                if (rest.Length == 0)
                {
                    ShowStatus("Type /capture <text>.", "red");
                }
                else if (await CaptureHeld() is { } held)
                {
                    ShowStatus(DesktopText.OneLine(held), "red");
                }
                else if (!running)
                {
                    running = true;
                    ActionResult captured;
                    try
                    {
                        captured = await Actions.CaptureText(rest);
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowStatus(DesktopText.OneLine(captured.Text), captured.Kind == ActionKind.Done ? "accent" : "red");
                    if (captured.Kind == ActionKind.Done)
                    {
                        await Captured();
                    }
                }

                break;
            case "/current":
                await RequestOpen(null);
                break;
            case "/open":
                string? found = rest.Length == 0 ? null : State.ResolveNote(rest);
                if (rest.Length == 0)
                {
                    ShowStatus("Type /open <note>.", "red");
                }
                else if (found is null)
                {
                    ShowStatus($"No note named {DesktopText.OneLine(rest)}.", "grey");
                }
                else
                {
                    await RequestOpen(found);
                }

                break;
            case "/import":
                // What was typed after the command is ignored: the files come from the OS dialog only.
                if (notesPanel is not null)
                {
                    await notesPanel.Import();
                }

                break;
            case "/export":
                // As above: the target comes from the OS save dialog only.
                if (await ExportTarget() is { } chosen)
                {
                    running = true;
                    try
                    {
                        ShowExported(await Actions.ExportNote(chosen.Name, chosen.Target));
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            case "/new":
                if (rest.Length == 0)
                {
                    ShowStatus("Type /new <title>.", "red");
                }
                else if (!running)
                {
                    running = true;
                    ActionResult made;
                    try
                    {
                        made = await Actions.CreateNote(rest);
                    }
                    finally
                    {
                        running = false;
                    }

                    if (made.Kind == ActionKind.Done)
                    {
                        await RequestOpen(made.Text);
                        ShowStatus($"Created {DesktopText.OneLine(made.Text)}", "accent");
                    }
                    else
                    {
                        ShowStatus(DesktopText.OneLine(made.Text), "red");
                    }
                }

                break;
            case "/save":
                if (editor is null || openName is null)
                {
                    ShowStatus("No note is open.", "grey");
                }
                else if (await editor.PrepareSaveAsync() is { } request && !running)
                {
                    running = true;
                    try
                    {
                        ActionResult saved = await Actions.SaveNote(request.Note, request.Text);
                        await editor.ApplySaveAsync(saved);
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            case "/settings":
                ShowSettings();
                break;
            case "/tags":
                if (rest.Length == 0)
                {
                    ShowTags();
                }
                else
                {
                    ShowTag(rest);
                }

                break;
            case "/todo":
                int split = rest.IndexOfAny([' ', '\t']);
                if (split < 0 || !DesktopText.TryParseDue(rest[..split], Snapshot?.Today ?? default, out DateOnly due))
                {
                    ShowStatus("Type /todo <yyyy-MM-dd|today|tomorrow> <text>.", "red");
                    break;
                }

                if (!running)
                {
                    running = true;
                    try
                    {
                        ActionResult added = await Actions.AddTodo(rest[(split + 1)..], due);
                        ShowStatus(
                            added.Kind == ActionKind.Done ? $"Added: {DesktopText.OneLine(added.Text)}" : DesktopText.OneLine(added.Text),
                            added.Kind == ActionKind.Done ? "accent" : "red");
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            default:
                ShowStatus("Unknown command.", "red");
                break;
        }
    }

    // True when the note in the editor is the plain inbox note, the one a capture appends to.
    private bool InboxOpen() =>
        openName is { } name
        && !openSensitive
        && string.Equals(name, State.ResolveNote(Inbox.NoteName) ?? Inbox.NoteName, StringComparison.OrdinalIgnoreCase);

    // Asked before a capture (the box and the palette): the open inbox has unsaved changes, which a capture would
    // leave stuck behind "changed on disk". Null when the capture may run.
    private async Task<string?> CaptureHeld()
    {
        if (InboxOpen() && openName is { } name && editor is not null && await editor.IsDirtyAsync())
        {
            return $"Save {name} first.";
        }

        return null;
    }

    // After a capture: an open inbox shows the new line, and its next save starts from the file as it is now. Text
    // typed into the editor since the check is kept instead.
    private async Task Captured()
    {
        if (InboxOpen() && editor is not null && !await editor.IsDirtyAsync())
        {
            await editor.ReloadAsync();
        }
    }

    // Rename: refused while the editor has unsaved changes, otherwise swaps the toolbar for a name field.
    private async Task StartRename()
    {
        if (openName is not { } name || running)
        {
            return;
        }

        if (editor is not null && await editor.IsDirtyAsync())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return;
        }

        renameText = name[(name.LastIndexOf('/') + 1)..];
        subpaging = false;
        moving = false;
        renaming = true;
        focusRename = true;
        ShowStatus(string.Empty, string.Empty);
    }

    private void RenameTyped(ChangeEventArgs e) => renameText = e.Value?.ToString() ?? string.Empty;

    private void CancelRename()
    {
        if (!running)
        {
            renaming = false;
        }
    }

    // Enter in the name field or Save name; Esc cancels. After a rename the editor opens the note under its new name.
    private async Task SaveName(KeyboardEventArgs? key)
    {
        if (key is not null && key.Key == "Escape")
        {
            if (!running)
            {
                renaming = false;
            }

            return;
        }

        if ((key is not null && key.Key != "Enter") || running || openName is not { } name)
        {
            return;
        }

        if (editor is not null && await editor.IsDirtyAsync())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return;
        }

        running = true;
        ActionResult renamed;
        try
        {
            renamed = await Actions.RenameNote(name, renameText);
        }
        finally
        {
            running = false;
        }

        if (renamed.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(renamed.Text), "red");
            return;
        }

        renaming = false;
        if (renamed.Reason == ActionReason.Unchanged)
        {
            ShowStatus(string.Empty, string.Empty);
            return;
        }

        ShowNote(renamed.Text);
        ShowStatus($"Renamed to {DesktopText.OneLine(renamed.Text)}", "accent");
    }

    private void AskDelete()
    {
        if (openName is not null && !running)
        {
            renaming = false;
            subpaging = false;
            moving = false;
            deleting = true;
        }
    }

    // Each ancestor of a subpage, from the top: its full name and its own title.
    private static IEnumerable<(string Name, string Title)> Ancestors(string name)
    {
        int start = 0;
        for (int slash = name.IndexOf('/'); slash > 0; slash = name.IndexOf('/', slash + 1))
        {
            yield return (name[..slash], name[start..slash]);
            start = slash + 1;
        }
    }

    // The delete question: a note with subpages names how many go with it.
    private string DeleteQuestion(string name)
    {
        string prefix = name + "/";
        int below = Snapshot?.Notes.Count(n => n.Name.StartsWith(prefix, StringComparison.Ordinal)) ?? 0;
        string shown = DesktopText.OneLine(name);
        return below switch
        {
            0 => $"Delete {shown}? This can't be undone.",
            1 => $"Delete {shown} and its 1 subpage? This can't be undone.",
            _ => $"Delete {shown} and its {below} subpages? This can't be undone.",
        };
    }

    // New subpage and Move: like Rename, refused while the editor has unsaved changes, otherwise a field replaces
    // the toolbar's buttons.
    private async Task StartSubpage()
    {
        if (await CleanForField())
        {
            subpageText = string.Empty;
            subpaging = true;
            focusField = true;
        }
    }

    private async Task StartMove()
    {
        if (await CleanForField() && openName is { } name)
        {
            int slash = name.LastIndexOf('/');
            moveText = slash < 0 ? string.Empty : name[..slash];
            moving = true;
            focusField = true;
        }
    }

    private async Task<bool> CleanForField()
    {
        if (openName is not { } name || running || openSensitive)
        {
            return false;
        }

        if (editor is not null && await editor.IsDirtyAsync())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return false;
        }

        renaming = false;
        subpaging = false;
        moving = false;
        ShowStatus(string.Empty, string.Empty);
        return true;
    }

    private void SubpageTyped(ChangeEventArgs e) => subpageText = e.Value?.ToString() ?? string.Empty;

    private void MoveTyped(ChangeEventArgs e) => moveText = e.Value?.ToString() ?? string.Empty;

    private void CancelSubpage()
    {
        if (!running)
        {
            subpaging = false;
        }
    }

    private void CancelMove()
    {
        if (!running)
        {
            moving = false;
        }
    }

    // Enter in the title field or Create subpage; Esc cancels. The new page opens through RequestOpen, so a dirty
    // editor asks first.
    private async Task CreateSubpage(KeyboardEventArgs? key)
    {
        if (key is not null && key.Key == "Escape")
        {
            CancelSubpage();
            return;
        }

        if ((key is not null && key.Key != "Enter") || running || openName is not { } name)
        {
            return;
        }

        running = true;
        ActionResult made;
        try
        {
            made = await Actions.CreateSubpage(name, subpageText);
        }
        finally
        {
            running = false;
        }

        if (made.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(made.Text), "red");
            return;
        }

        subpaging = false;
        await RequestOpen(made.Text);
        ShowStatus($"Created {DesktopText.OneLine(made.Text)}", "accent");
    }

    // Enter in the parent field or Move here; Esc cancels. The parent is matched against the note list only. After a
    // move the editor opens the note under its new name.
    private async Task MoveHere(KeyboardEventArgs? key)
    {
        if (key is not null && key.Key == "Escape")
        {
            CancelMove();
            return;
        }

        if ((key is not null && key.Key != "Enter") || running || openName is not { } name)
        {
            return;
        }

        if (editor is not null && await editor.IsDirtyAsync())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return;
        }

        running = true;
        ActionResult moved;
        try
        {
            moved = await Actions.MoveNote(name, moveText);
        }
        finally
        {
            running = false;
        }

        if (moved.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(moved.Text), "red");
            return;
        }

        moving = false;
        if (moved.Reason == ActionReason.Unchanged)
        {
            ShowStatus(string.Empty, string.Empty);
            return;
        }

        ShowNote(moved.Text);
        ShowStatus($"Moved to {DesktopText.OneLine(moved.Text)}", "accent");
    }

    private void CancelDelete()
    {
        if (!running)
        {
            deleting = false;
        }
    }

    // Confirmed in the dialog: deletes the open note and shows the current view again.
    private async Task DeleteConfirmed(Confirmation confirmed)
    {
        if (openName is not { } name || running)
        {
            return;
        }

        running = true;
        ActionResult deleted;
        try
        {
            deleted = await Actions.DeleteNote(name, confirmed);
        }
        finally
        {
            running = false;
            deleting = false;
        }

        if (deleted.Kind == ActionKind.Done)
        {
            ShowNote(null);
            ShowStatus($"Deleted {DesktopText.OneLine(deleted.Text)}", "accent");
        }
        else
        {
            ShowStatus(DesktopText.OneLine(deleted.Text), "red");
        }
    }

    // Mark sensitive and Make plain: refused while the editor has unsaved changes, otherwise asked in a dialog.
    private async Task AskMark()
    {
        if (await CleanForSensitive())
        {
            marking = true;
        }
    }

    private async Task AskMakePlain()
    {
        if (await CleanForSensitive())
        {
            unsealing = true;
        }
    }

    private async Task<bool> CleanForSensitive()
    {
        if (openName is not { } name || running)
        {
            return false;
        }

        if (editor is not null && await editor.IsDirtyAsync())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return false;
        }

        renaming = false;
        ShowStatus(string.Empty, string.Empty);
        return true;
    }

    private void CancelSensitive()
    {
        if (!running)
        {
            marking = false;
            unsealing = false;
        }
    }

    // Confirmed in the dialog: seals the open note and shows the current view; the note is then locked.
    private async Task MarkConfirmed(Confirmation confirmed)
    {
        if (openName is not { } name || running)
        {
            return;
        }

        running = true;
        ActionResult marked;
        try
        {
            marked = await Actions.MarkSensitive(name, confirmed);
        }
        finally
        {
            running = false;
            marking = false;
        }

        if (marked.Kind == ActionKind.Done)
        {
            ShowNote(null);
            ShowStatus($"Marked {DesktopText.OneLine(marked.Text)} sensitive.", "accent");
        }
        else
        {
            ShowStatus(DesktopText.OneLine(marked.Text), "red");
        }
    }

    // Confirmed in the dialog: writes the open sensitive note as a plain note and opens that.
    private async Task MakePlainConfirmed(Confirmation confirmed)
    {
        if (openName is not { } name || running)
        {
            return;
        }

        running = true;
        ActionResult made;
        try
        {
            made = await Actions.MakePlain(name, confirmed);
        }
        finally
        {
            running = false;
            unsealing = false;
        }

        if (made.Kind == ActionKind.Done)
        {
            ShowNote(made.Text);
            ShowStatus($"Made {DesktopText.OneLine(made.Text)} plain.", "accent");
        }
        else
        {
            ShowStatus(DesktopText.OneLine(made.Text), "red");
        }
    }

    // The Lock button, and the editor's idle signal: unsaved changes are saved first; when that save is refused the
    // note stays open and the editor shows why.
    private async Task LockOpen()
    {
        if (openName is null || !openSensitive || running)
        {
            return;
        }

        if (editor is not null && await editor.IsDirtyAsync() && await editor.PrepareSaveAsync() is { } request)
        {
            running = true;
            ActionResult saved;
            try
            {
                saved = await Actions.SaveNote(request.Note, request.Text);
                await editor.ApplySaveAsync(saved);
            }
            finally
            {
                running = false;
            }

            if (saved.Kind != ActionKind.Done)
            {
                return;
            }
        }

        State.Session.Lock();
        Locked();
    }

    // The session locked (Lock, idle, the window closing): the editor is taken down, and with it the note's text.
    private void Locked()
    {
        if (openName is not { } name || !openSensitive)
        {
            return;
        }

        ShowNote(null);
        ShowStatus($"Locked {DesktopText.OneLine(name)}.", "grey");
    }

    private async Task OpenOutside()
    {
        if (openName is not { } name || running)
        {
            return;
        }

        running = true;
        ActionResult opened;
        try
        {
            opened = await Actions.OpenExternally(name);
        }
        finally
        {
            running = false;
        }

        if (opened.Kind == ActionKind.Done)
        {
            ShowStatus(string.Empty, string.Empty);
        }
        else
        {
            ShowStatus(DesktopText.OneLine(opened.Text), "red");
        }
    }

    // The toolbar's button: writes the open plain note's saved text to the file chosen in the OS save dialog.
    private async Task Export()
    {
        if (await ExportTarget() is not { } chosen)
        {
            return;
        }

        running = true;
        try
        {
            ShowExported(await Actions.ExportNote(chosen.Name, chosen.Target));
        }
        finally
        {
            running = false;
        }
    }

    // The open note and where to write it, or null (with the reason in the status line) when there is nothing to
    // write: no note open, a sensitive note, unsaved changes, or the dialog was cancelled.
    private async Task<(string Name, string Target)?> ExportTarget()
    {
        if (openName is not { } name)
        {
            ShowStatus("Open a note first.", "red");
            return null;
        }

        if (running)
        {
            return null;
        }

        if (openSensitive)
        {
            ShowStatus(DesktopActions.ExportSensitiveText(DesktopText.OneLine(name)), "red");
            return null;
        }

        if (editor is not null && await editor.IsDirtyAsync())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return null;
        }

        string? target = Dialog.SaveExportFile(name[(name.LastIndexOf('/') + 1)..] + ".md");
        return target is null ? null : (name, target);
    }

    private void ShowExported(ActionResult exported) =>
        ShowStatus(DesktopText.OneLine(exported.Text), exported.Kind == ActionKind.Done ? "accent" : "red");

    private void ShowStatus(string text, string cssClass)
    {
        statusText = text;
        statusClass = cssClass;
    }
}
