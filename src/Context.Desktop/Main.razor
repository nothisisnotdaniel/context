    // As above, or at decision (its marker token, jobs 343 and 349) when heading is null.
    private async Task RequestOpen(string? name, string? heading, string? decision)
    {
        if (name is not null && string.Equals(name, openName, StringComparison.Ordinal))
        {
            if (page == Page.Search)
            {
                searchShown = null;
                searchFocus = null;
            }

            page = Page.None;
            reviewShown = false;
            if (heading is not null && editor is not null)
            {
                await editor.JumpToHeadingAsync(heading);
            }
            else if (decision is string token && editor is not null)
            {
                await editor.JumpToDecisionAsync(token);
            }

            return;
        }

        if (await KeptUnsaved())
        {
            pendingName = name;
            pendingHeading = heading;
            pendingDecision = decision;
            pendingPerson = null;
            pendingLink = null;
            pendingAppointment = null;
            discarding = true;
            return;
        }

        ShowNote(name, heading, decision: decision);
    }

