    // 238: the open note's direct children from the in-memory snapshot (no disk access), ordered like NoteStore.List()
    // siblings (Title ignoring case, then ordinal), each with the count of its own direct children.
    private static IReadOnlyList<(NoteInfo Child, int Below)> Children(DesktopSnapshot? snapshot, string name)
    {
        if (snapshot is null)
        {
            return [];
        }

        return snapshot.Notes
            .Where(n => string.Equals(n.Parent, name, StringComparison.Ordinal))
            .OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase)
            .ThenBy(n => n.Title, StringComparer.Ordinal)
            .Select(n => (n, snapshot.Notes.Count(g => string.Equals(g.Parent, n.Name, StringComparison.Ordinal))))
            .ToList();
    }

    // Each ancestor of a subpage, from the top: its full name and its own title.
    private static IEnumerable<(string Name, string Title)> Ancestors(string name)
    {
        int start = 0;
        for (int slash = name.IndexOf('/'); slash > 0; slash = name.IndexOf('/', slash + 1))
        {
            yield return (name[..slash], name[start..slash]);
            start = slash + 1;
        }
    }

    // The delete question: a note with subpages names how many go with it.
    private string DeleteQuestion(string name)
    {
        string prefix = name + "/";
        int below = Snapshot?.Notes.Count(n => n.Name.StartsWith(prefix, StringComparison.Ordinal)) ?? 0;
        string shown = DesktopText.OneLine(name);
        return below switch
        {
            0 => $"Delete {shown}? This can't be undone.",
            1 => $"Delete {shown} and its 1 subpage? This can't be undone.",
            _ => $"Delete {shown} and its {below} subpages? This can't be undone.",
        };
    }

