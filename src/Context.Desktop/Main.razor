        if (editor is not null && await editor.IsDirtyAsync())
        {
            running = true;
            ActionResult? saved;
            try
            {
                saved = await editor.SaveAsync(false);
            }
            finally
            {
                running = false;
            }

            if (saved is null || saved.Kind != ActionKind.Done)
            {
                return;
            }
        }

        State.Session.Lock();
        Locked();
    }

