    // The session locked (Lock, idle, the window closing): the editor is taken down, and with it the note's text.
    private void Locked()
    {
        if (openName is not { } name || !openSensitive)
        {
            return;
        }

        // ShowNote(null) also drops openHeading and pendingHeading: no heading text of the locked note stays here.
        ShowNote(null);
        ShowStatus($"Locked {DesktopText.OneLine(name)}.", "grey");
    }

    // The editor's drop: stores the dropped files next to the open note, then the editor inserts the links (unsaved).
    private async Task AttachDropped(DroppedFiles dropped)
    {
        if (openName is not { } name)
        {
            return;
        }

        ActionResult attached = await Actions.AttachFiles(name, dropped.Count, dropped.Files);
        if (editor is not null && string.Equals(openName, name, StringComparison.Ordinal))
        {
            await editor.ShowAttachedAsync(attached);
        }
    }

    // A click on an attachment PDF link in the editor: opens it in the system viewer (a dirty editor is fine).
    private async Task OpenAttachment(string href)
    {
        if (openName is not { } name)
        {
            return;
        }

        ActionResult opened = await Actions.OpenAttachment(name, href);
        if (!string.Equals(openName, name, StringComparison.Ordinal))
        {
            return;
        }

        if (opened.Kind == ActionKind.Done)
        {
            ShowStatus(string.Empty, string.Empty);
        }
        else
        {
            ShowStatus(DesktopText.OneLine(opened.Text), "red");
        }
    }

    // The shown page's actions for the top bar's More actions menu: a plain or sensitive note's, with End the day
    // and Standup first on today's daily note; none with no note open or on a page (Triage, People, Tags, Settings, an appointment).
    private IReadOnlyList<PageAction> PageActionsFor(DesktopSnapshot snapshot)
    {
        if (page != Page.None || openName is not { } name)
        {
            return [];
        }

        IReadOnlyList<PageAction> actions = NoteActionsFor(snapshot);
        return string.Equals(name, DailyNote.NameFor(snapshot.Today), StringComparison.Ordinal)
            ? [new PageAction("end-day", "End the day"), new PageAction("standup", "Standup"), .. actions]
            : actions;
    }

    // A plain or sensitive note's More actions.
    private IReadOnlyList<PageAction> NoteActionsFor(DesktopSnapshot snapshot)
    {
        PageAction[] common =
        [
            new PageAction("rename", "Rename"),
            new PageAction("delete", "Delete"),
            new PageAction("history", "History", historyShown),
            new PageAction("pin", "Pinned", openName is { } open && State.Pinned.Contains(open, StringComparer.Ordinal)),
        ];
        if (openSensitive)
        {
            return [.. common, new PageAction("make-plain", "Make plain"), new PageAction("lock", "Lock")];
        }

        // 338: a person page is a flat page, so it has no New subpage and no Move.
        bool person = openName is { } shown && People.PersonOf(shown) is not null;
        PageAction[] plain =
        [
            .. common,
            .. person ? Array.Empty<PageAction>() : [new PageAction("new-subpage", "New subpage"), new PageAction("move", "Move")],
            new PageAction("open-external", "Open in default editor"),
            new PageAction("export", "Export"),
            new PageAction("share", "Share"),
        ];
        return snapshot.SensitiveSupported ? [.. plain, new PageAction("mark-sensitive", "Mark sensitive")] : plain;
    }

    // A More actions item: the same handlers the toolbar buttons used to call. Open in default editor, Export and End
    // the day call the actions here, so every Actions call stays in a bound handler.
    private async Task RunPageAction(string id)
    {
        switch (id)
        {
            case "rename":
                await StartRename();
                break;
            case "delete":
                AskDelete();
                break;
            case "history":
                ToggleHistory();
                break;
            case "new-subpage":
                await StartSubpage();
                break;
            case "move":
                await StartMove();
                break;
            case "mark-sensitive":
                await AskMark();
                break;
            case "make-plain":
                await AskMakePlain();
                break;
            case "lock":
                await LockOpen();
                break;
            case "share":
                await AskShare();
                break;
            case "pin":
            {
                if (openName is not { } name || running)
                {
                    return;
                }

                bool pin = !State.Pinned.Contains(name, StringComparer.Ordinal);
                running = true;
                ActionResult pinned;
                try
                {
                    pinned = await Actions.SetPinned(name, pin);
                }
                finally
                {
                    running = false;
                }

                if (pinned.Kind == ActionKind.Done)
                {
                    ShowStatus(string.Empty, string.Empty);
                }
                else
                {
                    ShowStatus(DesktopText.OneLine(pinned.Text), "red");
                }

                break;
            }
            case "open-external":
            {
                if (openName is not { } name || running)
                {
                    return;
                }

                running = true;
                ActionResult opened;
                try
                {
                    opened = await Actions.OpenExternally(name);
                }
                finally
                {
                    running = false;
                }

                if (opened.Kind == ActionKind.Done)
                {
                    ShowStatus(string.Empty, string.Empty);
                }
                else
                {
                    ShowStatus(DesktopText.OneLine(opened.Text), "red");
                }

                break;
            }
            case "export":
            {
                if (await ExportTarget() is not { } chosen)
                {
                    return;
                }

                running = true;
                try
                {
                    ShowExported(await Actions.ExportNote(chosen.Name, chosen.Target));
                }
                finally
                {
                    running = false;
                }

                break;
            }
            case "end-day":
            {
                // Today's daily note only. Unsaved text is saved first, so the day's end never meets a changed note on
                // disk; afterwards the editor shows the new sections and a later save is not refused as changed.
                if (running || page != Page.None || openName is not { } name || Snapshot is not { } snapshot
                    || !string.Equals(name, DailyNote.NameFor(snapshot.Today), StringComparison.Ordinal))
                {
                    return;
                }

                if (await KeptUnsaved())
                {
                    ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
                    return;
                }

                if (running || !string.Equals(openName, name, StringComparison.Ordinal))
                {
                    return;
                }

                running = true;
                ActionResult ended;
                try
                {
                    ended = await Actions.EndDay(snapshot.Today);
                }
                finally
                {
                    running = false;
                }

                bool ok = ended.Kind == ActionKind.Done && ended.Reason is ActionReason.None or ActionReason.Unchanged;
                ShowStatus(DesktopText.OneLine(ended.Text), ok ? "grey" : "red");
                if (editor is not null && string.Equals(openName, name, StringComparison.Ordinal))
                {
                    await editor.ReloadAsync();
                }

                break;
            }
            case "standup":
            {
                // Today's daily note only, like end-day: unsaved text is saved first, then the section is written and
                // the editor reloads to show it.
                if (running || page != Page.None || openName is not { } name || Snapshot is not { } snapshot
                    || !string.Equals(name, DailyNote.NameFor(snapshot.Today), StringComparison.Ordinal))
                {
                    return;
                }

                if (await KeptUnsaved())
                {
                    ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
                    return;
                }

                if (running || !string.Equals(openName, name, StringComparison.Ordinal))
                {
                    return;
                }

                running = true;
                ActionResult written;
                try
                {
                    written = await Actions.WriteStandup(snapshot.Today);
                }
                finally
                {
                    running = false;
                }

                ShowStandup(written);
                if (editor is not null && string.Equals(openName, name, StringComparison.Ordinal))
                {
                    await editor.ReloadAsync();
                }

                break;
            }
        }
    }

    // The standup's answer in the main status line: grey when written, else red.
    private void ShowStandup(ActionResult written)
    {
        bool ok = written.Kind == ActionKind.Done && (written.Reason is ActionReason.None or ActionReason.Unchanged);
        ShowStatus(DesktopText.OneLine(written.Text), ok ? "grey" : "red");
    }

    // The open note and where to write it, or null (with the reason in the status line) when there is nothing to
    // write: no note open, a sensitive note, unsaved changes, or the dialog was cancelled.
    private async Task<(string Name, string Target)?> ExportTarget()
    {
        if (openName is not { } name)
        {
            ShowStatus("Open a note first.", "red");
            return null;
        }

        if (running)
        {
            return null;
        }

        if (openSensitive)
        {
            ShowStatus(DesktopActions.ExportSensitiveText(DesktopText.OneLine(name)), "red");
            return null;
        }

        if (await KeptUnsaved())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return null;
        }

        string? target = Dialog.SaveExportFile(name[(name.LastIndexOf('/') + 1)..] + ".md");
        return target is null ? null : (name, target);
    }

    // Share: refused with no note open, for a sensitive note (as Export) or with unsaved changes, otherwise asked in
    // ShareDialog.
    private async Task AskShare()
    {
        if (openName is not { } name)
        {
            ShowStatus("Open a note first.", "red");
            return;
        }

        if (running)
        {
            return;
        }

        if (openSensitive)
        {
            ShowStatus(DesktopActions.ExportSensitiveText(DesktopText.OneLine(name)), "red");
            return;
        }

        if (await KeptUnsaved())
        {
            ShowStatus($"Save {DesktopText.OneLine(name)} first.", "red");
            return;
        }

        renaming = false;
        ShowStatus(string.Empty, string.Empty);
        sharing = true;
    }

    private void CancelShare()
    {
        if (!running)
        {
            sharing = false;
        }
    }

    // Choose file in ShareDialog: asks where to write the page, then writes it. Cancelling the save dialog writes
    // nothing and shows no status.
    private async Task ShareChosen(bool leaveOutPrivate)
    {
        if (openName is not { } name || running || openSensitive)
        {
            return;
        }

        string? target = Dialog.SaveShareFile(name[(name.LastIndexOf('/') + 1)..] + ".html");
        sharing = false;
        if (target is null)
        {
            return;
        }

        running = true;
        try
        {
            ShowExported(await Actions.ShareNote(name, target, leaveOutPrivate));
        }
        finally
        {
            running = false;
        }
    }

    private void ShowExported(ActionResult exported) =>
        ShowStatus(DesktopText.OneLine(exported.Text), exported.Kind == ActionKind.Done ? "accent" : "red");

    // Splits "/new" text at its first "--template" token (a whitespace-separated word, ignoring case): the trimmed
    // title before it and the trimmed template name after it, or null when there is no such token.
    private static (string Title, string Template)? SplitTemplate(string text)
    {
        const string Flag = "--template";
        int i = 0;
        while (i < text.Length)
        {
            if (char.IsWhiteSpace(text[i]))
            {
                i++;
                continue;
            }

            int end = i;
            while (end < text.Length && !char.IsWhiteSpace(text[end]))
            {
                end++;
            }

            if (end - i == Flag.Length && string.Compare(text, i, Flag, 0, Flag.Length, StringComparison.OrdinalIgnoreCase) == 0)
            {
                return (text[..i].Trim(), text[end..].Trim());
            }

            i = end;
        }

        return null;
    }

    private void ShowStatus(string text, string cssClass)
    {
        statusText = text;
        statusClass = cssClass;
    }
}
