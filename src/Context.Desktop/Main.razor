    // The window close's save failed: the same question as when leaving the note; Discard closes the window.
    private void AskDiscardForClose()
    {
        KeepEditing();
        pendingClose = true;
        discarding = true;
        StateHasChanged();
    }

    private async Task Discard(Confirmation confirmed)
    {
        discarding = false;
        if (pendingClose)
        {
            pendingClose = false;
            Guard.Discard();
            return;
        }

        if (pendingBriefing)
        {
            pendingBriefing = false;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult briefing;
            try
            {
                briefing = await Actions.OpenBriefing();
            }
            finally
            {
                running = false;
            }

            ShowDaily(briefing);
            return;
        }

        if (pendingToday)
        {
            pendingToday = false;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult daily;
            try
            {
                daily = await Actions.OpenDailyNote();
            }
            finally
            {
                running = false;
            }

            ShowDaily(daily);
            return;
        }

        if (pendingPickedDay is { } picked)
        {
            pendingPickedDay = null;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult daily;
            try
            {
                daily = await Actions.OpenDailyNote(picked);
            }
            finally
            {
                running = false;
            }

            ShowDaily(daily);
            return;
        }

        if (pendingMeeting is { } meeting)
        {
            pendingMeeting = null;
            pendingAppointment = null;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult meetingNote;
            try
            {
                meetingNote = await Actions.OpenMeetingNote(meeting);
            }
            finally
            {
                running = false;
            }

            ShowDaily(meetingNote);
            return;
        }

        if (pendingAppointment is { } appointment)
        {
            // The unsaved changes go with the editor; the page shows with no note open.
            ShowNote(null);
            ShowAppointment(appointment);
            return;
        }

        if (pendingLink is { } link)
        {
            pendingLink = null;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult created;
            try
            {
                created = await Actions.CreateLinkedNote(link);
            }
            finally
            {
                running = false;
            }

            ShowDaily(created);
            return;
        }

        if (pendingPerson is not { } person)
        {
            ShowNote(pendingName, pendingHeading, decision: pendingDecision);
            return;
        }

        pendingPerson = null;
        pendingLink = null;
        if (running)
        {
            return;
        }

        running = true;
        ActionResult opened;
        try
        {
            opened = await Actions.OpenPerson(person);
        }
        finally
        {
            running = false;
        }

        ShowPerson(opened);
    }

    private void KeepEditing()
    {
        discarding = false;
        pendingClose = false;
        pendingPickedDay = null;
        pendingName = null;
        pendingHeading = null;
        pendingDecision = null;
        pendingPerson = null;
        pendingLink = null;
        pendingToday = false;
        pendingBriefing = false;
        pendingMeeting = null;
        pendingAppointment = null;
        pendingSearchBack = null;
    }

    // Opens the person page Actions gave, or shows why there is none.
    private void ShowPerson(ActionResult opened)
    {
        if (opened.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(opened.Text), "red");
