@inherits StateComponent

@if (Snapshot is { } snapshot)
{
    @if (snapshot.Failed)
    {
        <p class="red failed" role="alert">Can't read the data folder.</p>
    }
    else
    {
        <div class="layout" @onkeydown="OpenPalette">
            <aside class="notes-region">
                <NotesPanel @ref="notesPanel" OpenName="@openName" OnOpen="RequestOpen" OnTags="ShowTags" OnSettings="ShowSettings" />
            </aside>
            <main class="current-region">
                <CaptureBox Guard="CaptureHeld" OnCaptured="Captured" />
                @if (settingsShown)
                {
                    <SettingsPanel OnClose="CloseSettings" />
                }
                @if (reviewShown)
                {
                    <ReviewPanel OnOpen="RequestOpen" OnClose="CloseReview" />
                }
                @if (tagsShown)
                {
                    <TagsPanel Selected="@tagShown" OnTag="ShowTag" OnClose="CloseTags" />
                }
                @if (tagShown is { } tag)
                {
                    <TagPanel Tag="@tag" OnOpen="RequestOpen" OnClose="CloseTag" />
                }
                @if (findShown is { } find)
                {
                    <FindPanel Key="@find.Key" Value="@find.Value" OnOpen="RequestOpen" OnClose="CloseFind" />
                }
                @if (searchShown is { } search)
                {
                    <SearchPanel Text="@search" OnOpen="RequestOpen" OnClose="CloseSearch" />
                }
                <p class="main-status cut @statusClass" role="status" title="@statusText">@statusText</p>
                @if (openName is { } name)
                {
                    @if (name.Contains('/'))
                    {
                        <nav class="breadcrumb" aria-label="Breadcrumb">
                            <ol>
                                @foreach ((string ancestor, string segment) in Ancestors(name))
                                {
                                    string ancestorShown = DesktopText.OneLine(ancestor);
                                    string segmentShown = DesktopText.OneLine(segment);
                                    <li>
                                        <button type="button" class="crumb cut" title="@ancestorShown" @onclick="() => RequestOpen(ancestor)">@segmentShown</button>
                                    </li>
                                }
                                @{
                                    string currentShown = DesktopText.OneLine(name[(name.LastIndexOf('/') + 1)..]);
                                    string fullShown = DesktopText.OneLine(name);
                                }
                                <li><span class="crumb-current cut" aria-current="page" title="@fullShown">@currentShown</span></li>
                            </ol>
                        </nav>
                    }
                    <div class="note-toolbar">
                        @if (subpaging)
                        {
                            <input type="text" class="subpage-title" value="@subpageText" maxlength="200" disabled="@running"
                                   aria-label="Subpage title" @ref="subpageField" @oninput="SubpageTyped" @onkeydown="e => CreateSubpage(e)" />
                            <button type="button" class="create-subpage" disabled="@running" @onclick="() => CreateSubpage(null)">Create subpage</button>
                            <button type="button" class="cancel-subpage" disabled="@running" @onclick="CancelSubpage">Cancel</button>
                        }
                        else if (moving)
                        {
                            <input type="text" class="move-parent" value="@moveText" maxlength="500" disabled="@running"
                                   aria-label="New parent" placeholder="Empty: top level" @ref="moveField" @oninput="MoveTyped" @onkeydown="e => MoveHere(e)" />
                            <button type="button" class="move-here" disabled="@running" @onclick="() => MoveHere(null)">Move here</button>
                            <button type="button" class="cancel-move" disabled="@running" @onclick="CancelMove">Cancel</button>
                        }
                        else if (renaming)
                        {
                            <input type="text" class="rename-title" value="@renameText" maxlength="200" disabled="@running"
                                   aria-label="New name" @ref="renameField" @oninput="RenameTyped" @onkeydown="e => SaveName(e)" />
                            <button type="button" class="save-name" disabled="@running" @onclick="() => SaveName(null)">Save name</button>
                            <button type="button" class="cancel-rename" disabled="@running" @onclick="CancelRename">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="rename" disabled="@running" @onclick="StartRename">Rename</button>
                            <button type="button" class="delete" disabled="@running" @onclick="AskDelete">Delete</button>
                            <button type="button" class="history" disabled="@running" aria-pressed="@(historyShown ? "true" : "false")" @onclick="ToggleHistory">History</button>
                            @if (openSensitive)
                            {
                                <button type="button" class="make-plain" disabled="@running" @onclick="AskMakePlain">Make plain</button>
                                <button type="button" class="lock" disabled="@running" @onclick="LockOpen">Lock</button>
                            }
                            else
                            {
                                <button type="button" class="new-subpage" disabled="@running" @onclick="StartSubpage">New subpage</button>
                                <button type="button" class="move" disabled="@running" @onclick="StartMove">Move</button>
                                <button type="button" class="open-external" disabled="@running" @onclick="OpenOutside">Open in default editor</button>
                                <button type="button" class="export" disabled="@running" @onclick="Export">Export</button>
                                @if (snapshot.SensitiveSupported)
                                {
                                    <button type="button" class="mark-sensitive" disabled="@running" @onclick="AskMark">Mark sensitive</button>
                                }
                            }
                        }
                    </div>
                    <NoteEditor @key="(name, openSensitive)" @ref="editor" Name="@name" Sensitive="openSensitive"
                                OnTag="ShowTag" OnOpenNote="RequestOpen" OnPerson="OpenMention" OnIdle="LockOpen" OnLocked="Locked" />
                    @if (historyShown)
                    {
                        <HistoryPanel Name="@name" Sensitive="openSensitive" OnRestore="AskRestore" OnClose="CloseHistory" />
                    }
                    @if (People.PersonOf(name) is { } person)
                    {
                        <PersonPanel Person="@person" OnOpen="RequestOpen" />
                    }
                    <LinksPanel Name="@name" Sensitive="openSensitive" OnOpen="RequestOpen" OnTag="ShowTag" />
                }
                else
                {
                    <CurrentPanel OnOpen="RequestOpen" />
                }
            </main>
            <aside class="todos-region">
                <TodoPanel @ref="todoPanel" OnPerson="OpenMention" />
            </aside>
        </div>
        @if (discarding)
        {
            <ConfirmDialog Question="@($"Discard changes to {DesktopText.OneLine(openName ?? string.Empty)}?")" ConfirmLabel="Discard"
                           OnConfirm="Discard" OnCancel="KeepEditing" />
        }
        @if (deleting && openName is { } doomed)
        {
            <ConfirmDialog Question="@DeleteQuestion(doomed)" ConfirmLabel="Delete"
                           Busy="running" OnConfirm="DeleteConfirmed" OnCancel="CancelDelete" />
        }
        @if (marking && openName is { } sealing)
        {
            <ConfirmDialog Question="@($"Mark {DesktopText.OneLine(sealing)} sensitive? It will open only in this app, with this machine's key or the recovery file.")"
                           ConfirmLabel="Mark sensitive" Busy="running" OnConfirm="MarkConfirmed" OnCancel="CancelSensitive" />
        }
        @if (unsealing && openName is { } plain)
        {
            <ConfirmDialog Question="@($"Make {DesktopText.OneLine(plain)} plain? It will be stored as readable text again. Its history will be removed.")"
                           ConfirmLabel="Make plain" Busy="running" OnConfirm="MakePlainConfirmed" OnCancel="CancelSensitive" />
        }
        @if (restoring is { } version && openName is { } restored)
        {
            <ConfirmDialog Question="@($"Restore {DesktopText.OneLine(restored)} to the version from {HistoryPanel.TimeText(version.SavedUtc, State.Zone)}? The current text is kept as a version.")"
                           ConfirmLabel="Restore" Busy="running" OnConfirm="RestoreConfirmed" OnCancel="CancelRestore" />
        }
        @if (paletteOpen)
        {
            <CommandPalette OnRun="RunCommand" OnClose="ClosePalette" />
        }
    }
}
else
{
    <p class="grey loading" role="status">Loading…</p>
}

@code {
    private string? openName;
    private NoteEditor? editor;
    private string? tagShown;
    private bool tagsShown;
    private bool reviewShown;
    private (string Key, string Value)? findShown;
    private string? searchShown;
    private bool settingsShown;
    private bool discarding;
    private string? pendingName;
    private string? pendingPerson;
    private bool pendingToday;
    private bool pendingBriefing;
    private Appointment? pendingMeeting;
    private bool paletteOpen;
    private bool running;
    private string statusText = string.Empty;
    private string statusClass = string.Empty;
    private bool renaming;
    private string renameText = string.Empty;
    private ElementReference renameField;
    private bool focusRename;
    private bool deleting;
    private bool openSensitive;
    private bool marking;
    private bool unsealing;
    private bool historyShown;
    private (string Id, DateTime SavedUtc)? restoring;
    private NotesPanel? notesPanel;
    private TodoPanel? todoPanel;
    private bool subpaging;
    private string subpageText = string.Empty;
    private ElementReference subpageField;
    private bool moving;
    private string moveText = string.Empty;
    private ElementReference moveField;
    private bool focusField;

    /// <summary>The status line when the automatic briefing was written while a note had unsaved changes.</summary>
    internal static string BriefingReadyText(string name) =>
        $"Today's briefing is ready: {DesktopText.OneLine(name)}. Type /briefing to open it.";

    /// <summary>The OS file dialogs.</summary>
    [Inject]
    internal IFileDialog Dialog { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (State.TakeBriefing() is { } offered)
        {
            ShowNote(offered);
        }
    }

    // A briefing the automatic write offered opens when no note has unsaved changes and nothing is being asked or
    // typed; otherwise the editor is left alone and the status line points to /briefing.
    protected override async Task OnStateChangedAsync()
    {
        if (State.TakeBriefing() is not { } offered || string.Equals(offered, openName, StringComparison.Ordinal))
        {
            return;
        }

        bool busy = discarding || renaming || subpaging || moving || deleting || marking || unsealing || running
            || (editor is not null && openName is not null && await editor.IsDirtyAsync());
        if (busy)
        {
            ShowStatus(BriefingReadyText(offered), "accent");
        }
        else
        {
            ShowNote(offered);
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusRename && renaming)
        {
            focusRename = false;
            await renameField.FocusAsync();
        }

        if (focusField && (subpaging || moving))
        {
            focusField = false;
            await (subpaging ? subpageField : moveField).FocusAsync();
        }
    }

    private void OpenPalette(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && string.Equals(e.Key, "k", StringComparison.OrdinalIgnoreCase) && !discarding && !deleting
            && !marking && !unsealing)
        {
            paletteOpen = true;
        }
    }

    private void ClosePalette() => paletteOpen = false;

    private void ShowTag(string tag)
    {
        tagShown = TagIndex.NormalizeTag(tag);
    }

    private void CloseTag() => tagShown = null;

    private void CloseFind() => findShown = null;

    private void CloseSearch() => searchShown = null;

    // The tags view: every tag with its note count; a click on one shows the tag panel below it.
    private void ShowTags() => tagsShown = true;

    private void CloseTags()
    {
        tagsShown = false;
        tagShown = null;
    }

    // The weekly review: shown at the top of the main region until closed or until a note or the current view opens.
    private void ShowReview() => reviewShown = true;

    private void CloseReview() => reviewShown = false;

    // The settings: shown at the top of the main region until closed or until a note or the current view opens.
    private void ShowSettings() => settingsShown = true;

    private void CloseSettings() => settingsShown = false;

    // Opens the note called name (null: the current view), asking first when the open note has unsaved changes.
    private async Task RequestOpen(string? name)
    {
        if (name is not null && string.Equals(name, openName, StringComparison.Ordinal))
        {
            settingsShown = false;
            reviewShown = false;
            return;
        }

        if (editor is not null && openName is not null && await editor.IsDirtyAsync())
        {
            pendingName = name;
            pendingPerson = null;
            discarding = true;
            return;
        }

        ShowNote(name);
    }

    // A mention was clicked in the editor or in the todo list: opens the person's page, making it (and people) on this click only.
    // Asks first when the open note has unsaved changes, like RequestOpen.
    private async Task OpenMention(string person)
    {
        if (editor is not null && openName is not null && await editor.IsDirtyAsync())
        {
            pendingName = null;
            pendingPerson = person;
            discarding = true;
            return;
        }

        if (running)
        {
            return;
        }

        running = true;
        ActionResult opened;
        try
        {
            opened = await Actions.OpenPerson(person);
        }
        finally
        {
            running = false;
        }

        ShowPerson(opened);
    }

    private async Task Discard(Confirmation confirmed)
    {
        discarding = false;
        if (pendingBriefing)
        {
            pendingBriefing = false;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult briefing;
            try
            {
                briefing = await Actions.OpenBriefing();
            }
            finally
            {
                running = false;
            }

            ShowDaily(briefing);
            return;
        }

        if (pendingToday)
        {
            pendingToday = false;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult daily;
            try
            {
                daily = await Actions.OpenDailyNote();
            }
            finally
            {
                running = false;
            }

            ShowDaily(daily);
            return;
        }

        if (pendingMeeting is { } meeting)
        {
            pendingMeeting = null;
            if (running)
            {
                return;
            }

            running = true;
            ActionResult meetingNote;
            try
            {
                meetingNote = await Actions.OpenMeetingNote(meeting);
            }
            finally
            {
                running = false;
            }

            ShowDaily(meetingNote);
            return;
        }

        if (pendingPerson is not { } person)
        {
            ShowNote(pendingName);
            return;
        }

        pendingPerson = null;
        if (running)
        {
            return;
        }

        running = true;
        ActionResult opened;
        try
        {
            opened = await Actions.OpenPerson(person);
        }
        finally
        {
            running = false;
        }

        ShowPerson(opened);
    }

    private void KeepEditing()
    {
        discarding = false;
        pendingName = null;
        pendingPerson = null;
        pendingToday = false;
        pendingBriefing = false;
        pendingMeeting = null;
    }

    // Opens the person page Actions gave, or shows why there is none.
    private void ShowPerson(ActionResult opened)
    {
        if (opened.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(opened.Text), "red");
            return;
        }

        if (!string.Equals(opened.Text, openName, StringComparison.Ordinal))
        {
            ShowNote(opened.Text);
        }
    }

    // Opens the daily or meeting note Actions gave (Created after a create), or shows why there is none.
    private void ShowDaily(ActionResult daily)
    {
        if (daily.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(daily.Text), "red");
            return;
        }

        if (string.Equals(daily.Text, openName, StringComparison.Ordinal))
        {
            settingsShown = false;
        }
        else
        {
            ShowNote(daily.Text);
        }

        if (daily.Reason != ActionReason.Unchanged)
        {
            ShowStatus($"Created {DesktopText.OneLine(daily.Text)}", "accent");
        }
    }

    private void ShowNote(string? name)
    {
        openName = name;
        openSensitive = name is not null
            && Snapshot is { } snapshot
            && snapshot.Sensitive.Any(n => string.Equals(n.Name, name, StringComparison.Ordinal));
        pendingName = null;
        pendingPerson = null;
        pendingToday = false;
        pendingBriefing = false;
        pendingMeeting = null;
        tagShown = null;
        tagsShown = false;
        reviewShown = false;
        findShown = null;
        searchShown = null;
        settingsShown = false;
        renaming = false;
        subpaging = false;
        moving = false;
        deleting = false;
        marking = false;
        unsealing = false;
        historyShown = false;
        restoring = null;
        if (name is null)
        {
            editor = null;
        }

        ShowStatus(string.Empty, string.Empty);
    }

    // Runs a palette command; the palette closes first.
    private async Task RunCommand(string line)
    {
        paletteOpen = false;
        string trimmed = line.Trim();
        int space = trimmed.IndexOfAny([' ', '\t']);
        string command = (space < 0 ? trimmed : trimmed[..space]).ToLowerInvariant();
        string rest = space < 0 ? string.Empty : trimmed[(space + 1)..].Trim();
        switch (command)
        {
            case "/capture":
                if (rest.Length == 0)
                {
                    ShowStatus("Type /capture <text>.", "red");
                }
                else if (await CaptureHeld() is { } held)
                {
                    ShowStatus(DesktopText.OneLine(held), "red");
                }
                else if (!running)
                {
                    running = true;
                    ActionResult captured;
                    try
                    {
                        captured = await Actions.CaptureText(rest);
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowStatus(DesktopText.OneLine(captured.Text), captured.Kind == ActionKind.Done ? "accent" : "red");
                    if (captured.Kind == ActionKind.Done)
                    {
                        await Captured();
                    }
                }

                break;
            case "/current":
                await RequestOpen(null);
                break;
            case "/open":
                string? found = rest.Length == 0 ? null : State.ResolveNote(rest);
                if (rest.Length == 0)
                {
                    ShowStatus("Type /open <note>.", "red");
                }
                else if (found is null)
                {
                    ShowStatus($"No note named {DesktopText.OneLine(rest)}.", "grey");
                }
                else
                {
                    await RequestOpen(found);
                }

                break;
            case "/find":
                // The attribute key, then the value: /find role Bereichsleiter. Read only.
                int keyEnd = rest.IndexOfAny([' ', '\t']);
                string? findKey = keyEnd < 0 ? null : AttributeParser.NormalizeKey(rest[..keyEnd]);
                string findValue = keyEnd < 0 ? string.Empty : TagParser.CollapseWhitespace(rest[(keyEnd + 1)..]);
                if (findKey is null || findValue.Length == 0)
                {
                    ShowStatus("Type /find <attribute> <value>.", "red");
                }
                else
                {
                    findShown = (findKey, findValue);
                    ShowStatus(string.Empty, string.Empty);
                }

                break;
            case "/search":
                // The text to look for in every plain note: /search budget 2027. Read only; SearchPanel shows the
                // usage line for a blank or bad text.
                searchShown = rest;
                ShowStatus(string.Empty, string.Empty);
                break;
            case "/import":
                // What was typed after the command is ignored: the files come from the OS dialog only.
                if (notesPanel is not null)
                {
                    await notesPanel.Import();
                }

                break;
            case "/export":
                // As above: the target comes from the OS save dialog only.
                if (await ExportTarget() is { } chosen)
                {
                    running = true;
                    try
                    {
                        ShowExported(await Actions.ExportNote(chosen.Name, chosen.Target));
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            case "/new":
                (string Title, string Template)? fromTemplate = SplitTemplate(rest);
                if (rest.Length == 0)
                {
                    ShowStatus("Type /new <title>.", "red");
                }
                else if (fromTemplate is { } typed && (typed.Title.Length == 0 || typed.Template.Length == 0))
                {
                    ShowStatus("Type /new <title> --template <template>.", "red");
                }
                else if (!running)
                {
                    running = true;
                    ActionResult made;
                    try
                    {
                        made = fromTemplate is { } named
                            ? await Actions.CreateNoteFromTemplate(named.Title, named.Template)
                            : await Actions.CreateNote(rest);
                    }
                    finally
                    {
                        running = false;
                    }

                    if (made.Kind == ActionKind.Done)
                    {
                        await RequestOpen(made.Text);
                        ShowStatus($"Created {DesktopText.OneLine(made.Text)}", "accent");
                    }
                    else
                    {
                        ShowStatus(DesktopText.OneLine(made.Text), "red");
                    }
                }

                break;
            case "/save":
                if (editor is null || openName is null)
                {
                    ShowStatus("No note is open.", "grey");
                }
                else if (await editor.PrepareSaveAsync() is { } request && !running)
                {
                    running = true;
                    try
                    {
                        ActionResult saved = await Actions.SaveNote(request.Note, request.Text);
                        await editor.ApplySaveAsync(saved);
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            case "/review":
                // The argument is ignored.
                ShowReview();
                break;
            case "/settings":
                ShowSettings();
                break;
            case "/tags":
                if (rest.Length == 0)
                {
                    ShowTags();
                }
                else
                {
                    ShowTag(rest);
                }

                break;
            case "/briefing":
                // The argument is ignored. A dirty editor asks first, unless it already shows today's briefing.
                if (editor is not null && openName is not null
                    && !string.Equals(openName, Actions.BriefingName(), StringComparison.Ordinal)
                    && await editor.IsDirtyAsync())
                {
                    pendingName = null;
                    pendingPerson = null;
                    pendingToday = false;
                    pendingMeeting = null;
                    pendingBriefing = true;
                    discarding = true;
                    break;
                }

                if (!running)
                {
                    running = true;
                    ActionResult briefing;
                    try
                    {
                        briefing = await Actions.OpenBriefing();
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowDaily(briefing);
                }

                break;
            case "/today":
                // The argument is ignored. A dirty editor asks first, unless it already shows today's note.
                if (editor is not null && openName is not null
                    && !string.Equals(openName, Actions.DailyNoteName(), StringComparison.Ordinal)
                    && await editor.IsDirtyAsync())
                {
                    pendingName = null;
                    pendingPerson = null;
                    pendingToday = true;
                    pendingBriefing = false;
                    pendingMeeting = null;
                    discarding = true;
                    break;
                }

                if (!running)
                {
                    running = true;
                    ActionResult daily;
                    try
                    {
                        daily = await Actions.OpenDailyNote();
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowDaily(daily);
                }

                break;
            case "/meeting":
                // The number of today's appointment in the shown current view, counting the ones behind "… N more".
                if (!MeetingNote.TryParseNumber(rest, out int meetingNumber))
                {
                    ShowStatus("Type /meeting <number>.", "red");
                    break;
                }

                Appointment? appointment = MeetingNote.Pick(
                    Snapshot?.Current?.Appointments ?? [], meetingNumber, out string? meetingError);
                if (appointment is null)
                {
                    ShowStatus(DesktopText.OneLine(meetingError ?? MeetingNote.NoAppointmentsText), "red");
                    break;
                }

                // A dirty editor asks first, unless it already shows this meeting's note.
                if (editor is not null && openName is not null
                    && !string.Equals(openName, MeetingNote.NameFor(appointment), StringComparison.Ordinal)
                    && await editor.IsDirtyAsync())
                {
                    pendingName = null;
                    pendingPerson = null;
                    pendingToday = false;
                    pendingBriefing = false;
                    pendingMeeting = appointment;
                    discarding = true;
                    break;
                }

                if (!running)
                {
                    running = true;
                    ActionResult meetingNote;
                    try
                    {
                        meetingNote = await Actions.OpenMeetingNote(appointment);
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowDaily(meetingNote);
                }

                break;
            case "/done":
                PickDone(rest);
                break;
            case "/todo":
                int split = rest.IndexOfAny([' ', '\t']);
                TodoRepeat? repeat = null;
                DateOnly due;
                if (string.Equals(split < 0 ? rest : rest[..split], "every", StringComparison.OrdinalIgnoreCase))
                {
                    // /todo every <unit> <text>: the unit is the next word, the text the rest.
                    string every = split < 0 ? string.Empty : rest[(split + 1)..].TrimStart();
                    int unitEnd = every.IndexOfAny([' ', '\t']);
                    if (unitEnd < 0 || every[(unitEnd + 1)..].Trim().Length == 0
                        || !TodoInput.TryParseRepeat(every[..unitEnd], Snapshot?.Today ?? default, out TodoRepeat parsed, out due))
                    {
                        ShowStatus("Type /todo every <weekday|day|month> <text>.", "red");
                        break;
                    }

                    repeat = parsed;
                    rest = every;
                    split = unitEnd;
                }
                else if (split < 0 || !DesktopText.TryParseDue(rest[..split], Snapshot?.Today ?? default, out due))
                {
                    ShowStatus("Type /todo <yyyy-MM-dd|today|tomorrow> <text>.", "red");
                    break;
                }

                if (!running)
                {
                    running = true;
                    try
                    {
                        ActionResult added = await Actions.AddTodo(rest[(split + 1)..], due, repeat);
                        ShowStatus(
                            added.Kind == ActionKind.Done ? $"Added: {DesktopText.OneLine(added.Text)}" : DesktopText.OneLine(added.Text),
                            added.Kind == ActionKind.Done ? "accent" : "red");
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            default:
                ShowStatus("Unknown command.", "red");
                break;
        }
    }

    // /done <text>: picks the open todo by its text like context todo done and asks the todo panel's dialog to
    // confirm; nothing is written until the user confirms there.
    private void PickDone(string query)
    {
        if (query.Length == 0)
        {
            ShowStatus("Type /done <text>.", "red");
            return;
        }

        if (Snapshot is not { } snapshot || snapshot.TodosUnreadable)
        {
            ShowStatus(DesktopActions.TodosUnreadableText, "red");
            return;
        }

        if (snapshot.Todos.Count == 0)
        {
            ShowStatus(TodoPicker.NoTodosText, "red");
            return;
        }

        TodoPick pick = TodoPicker.Pick(snapshot.Todos, query);
        if (pick.Todo is not { } todo)
        {
            ShowStatus(TodoPicker.NoPickText(pick, DesktopText.OneLine(query)), "red");
            return;
        }

        ShowStatus(string.Empty, string.Empty);
        todoPanel?.AskDone(todo);
    }

    // True when the note in the editor is the plain inbox note, the one a capture appends to.
    private bool InboxOpen() =>
        openName is { } name
        && !openSensitive
        && string.Equals(name, State.ResolveNote(Inbox.NoteName) ?? Inbox.NoteName, StringComparison.OrdinalIgnoreCase);

    // Asked before a capture (the box and the palette): the open inbox has unsaved changes, which a capture would
    // leave stuck behind "changed on disk". Null when the capture may run.
    private async Task<string?> CaptureHeld()
    {
        if (InboxOpen() && openName is { } name && editor is not null && await editor.IsDirtyAsync())
        {
            return $"Save {name} first.";
        }

        return null;
    }

    // After a capture: an open inbox shows the new line, and its next save starts from the file as it is now. Text
    // typed into the editor since the check is kept instead.
    private async Task Captured()
    {
        if (InboxOpen() && editor is not null && !await editor.IsDirtyAsync())
