@inherits StateComponent
@implements IAsyncDisposable

<CrashHintBar />
@if (Snapshot is { } snapshot)
{
    @if (snapshot.Failed)
    {
        <p class="red failed" role="alert">Can't read the data folder.</p>
    }
    else
    {
        <div class="layout" @onkeydown="OpenPalette">
            <aside class="notes-region">
                <NotesPanel @ref="notesPanel" OpenName="@openName" OnOpen="RequestOpen" OnTags="ShowTags" OnSettings="ShowSettings" OnTriage="ShowTriage" OnPeople="ShowPeople" OnTodos="ShowTodos" OnSearch="ShowSearch" />
            </aside>
            <main class="current-region">
                <TopBar Today="@snapshot.Today" Selected="@SelectedDay()" OnToday="ShowToday" OnPick="PickDay" OnCapture="CaptureAsync" OnSearch="ShowSearch" PageActions="@PageActionsFor(snapshot)"
                        PageActionsDisabled="@(running || renaming || subpaging || moving)" OnPageAction="RunPageAction" />
                @if (State.DecisionNumbersRanOut)
                {
                    <p class="red decision-notice" role="alert">@DesktopActions.DecisionNumbersRanOutText</p>
                }
                @if (State.DecisionFolderUnreadable)
                {
                    <p class="red decision-folder-unreadable" role="alert">@DecisionFolder.UnreadableText</p>
                }
                @foreach (DecisionFolderAlias clash in decisionClashes)
                {
                    <p class="decision-clash" role="status" @key="clash.Guid">@ClashText(clash)<button type="button" @onclick="() => DismissClash(clash)">Dismiss</button></p>
                }
                @if (page == Page.Triage)
                {
                    <TriagePanel Guard="TriageHeld" OnTriaged="Triaged" OnClose="CloseTriage" />
                }
                @if (page == Page.Done)
                {
                    <DonePanel OnClose="CloseDone" />
                }
                @if (page == Page.MailDigest)
                {
                    <MailDigestPanel OnClose="CloseMailDigest" />
                }
                @if (page == Page.Settings)
                {
                    <SettingsPanel OnClose="CloseSettings" OnThemeChanged="ApplySavedTheme" />
                }
                @if (page == Page.Appointment && appointmentShown is { } shownAppointment)
                {
                    <AppointmentPanel Title="@shownAppointment.Title" Day="@shownAppointment.Day" OnOpen="RequestOpen" OnCreate="CreateAppointmentNote" OnClose="CloseAppointment" />
                }
                @if (reviewShown)
                {
                    <ReviewPanel OnOpen="RequestOpen" OnClose="CloseReview" />
                }
                @if (page == Page.Board && boardShown is { } boardTag)
                {
                    <BoardPanel Tag="@boardTag" OnOpen="RequestOpen" OnClose="CloseBoard" />
                }
                @if (page == Page.People)
                {
                    <PeoplePanel OnOpen="RequestOpen" OnClose="ClosePeople" />
                }
                @if (page == Page.Todos)
                {
                    <AllTodosPanel OnOpen="RequestOpen" OnMeeting="OpenAppointment" OnPerson="OpenMention" OnClose="CloseTodos" />
                }
                @if (page == Page.Tags)
                {
                    <TagsPanel Selected="@tagShown" OnTag="ShowTag" OnClose="CloseTags" />
                }
                @if (tagShown is { } tag)
                {
                    <TagPanel Tag="@tag" OnOpen="RequestOpen" OnBoard="ShowBoard" OnClose="CloseTag" />
                }
                @if (findShown is { } find)
                {
                    <FindPanel Key="@find.Key" Value="@find.Value" OnOpen="RequestOpen" OnClose="CloseFind" />
                }
                @if (page == Page.Search && searchShown is { } search)
                {
                    <SearchPanel Text="@search" Request="@searchRequest" Focus="@searchFocus" OnOpen="OpenFromSearch" OnClose="CloseSearch" />
                }
                @if (decisionsShown is { } decisionsTag)
                {
                    <DecisionsPanel Tag="@decisionsTag" OnOpen="RequestOpen" OnOpenDecision="OpenDecision" OnClose="CloseDecisions" />
                }
                @if (similarShown)
                {
                    <SimilarPanel OnOpen="RequestOpen" OnClose="CloseSimilar" Guard="MergeHeld" OnMerged="Merged" />
                }
                <p class="main-status cut @statusClass" role="status" title="@statusText">@statusText</p>
                <div class="note-area" hidden="@(page != Page.None)">
                    @if (openName is { } name)
                    {
                        @if (searchBack is { } back && string.Equals(back.Note, name, StringComparison.Ordinal))
                        {
                            <button type="button" class="search-back" @onclick="BackToSearch">Back to search</button>
                        }
                        @if (name.Contains('/'))
                        {
                            <nav class="breadcrumb" aria-label="Breadcrumb">
                                <ol>
                                    @foreach ((string ancestor, string segment) in Ancestors(name))
                                    {
                                        string ancestorShown = DesktopText.OneLine(ancestor);
                                        string segmentShown = DesktopText.OneLine(segment);
                                        <li>
                                            <button type="button" class="crumb cut" title="@ancestorShown" @onclick="() => RequestOpen(ancestor)">@segmentShown</button>
                                        </li>
                                    }
                                    @{
                                        string currentShown = DesktopText.OneLine(name[(name.LastIndexOf('/') + 1)..]);
                                        string fullShown = DesktopText.OneLine(name);
                                    }
                                    <li><span class="crumb-current cut" aria-current="page" title="@fullShown">@currentShown</span></li>
                                </ol>
                            </nav>
                        }
                        @if (renaming || subpaging || moving)
                        {
                            <div class="note-toolbar">
                                @if (subpaging)
                                {
                                    <input type="text" class="subpage-title" value="@subpageText" maxlength="200" disabled="@running"
                                           aria-label="Subpage title" placeholder="Subpage title" @ref="subpageField" @oninput="SubpageTyped" @onkeydown="e => CreateSubpage(e)" />
                                    <button type="button" class="cancel-subpage" disabled="@running" @onclick="CancelSubpage">Cancel</button>
                                }
                                else if (moving)
                                {
                                    <input type="text" class="move-parent" value="@moveText" maxlength="500" disabled="@running"
                                           aria-label="New parent" placeholder="Empty: top level" @ref="moveField" @oninput="MoveTyped" @onkeydown="e => MoveHere(e)" />
                                    <button type="button" class="cancel-move" disabled="@running" @onclick="CancelMove">Cancel</button>
                                }
                                else if (renaming)
                                {
                                    <input type="text" class="rename-title" value="@renameText" maxlength="200" disabled="@running"
                                           aria-label="New name" placeholder="New name" @ref="renameField" @oninput="RenameTyped" @onkeydown="e => SaveName(e)" />
                                    <button type="button" class="cancel-rename" disabled="@running" @onclick="CancelRename">Cancel</button>
                                }
                            </div>
                        }
                        @if (DesktopState.MeetingNoteDay(name) is { } meetingDay)
                        {
                            @* A meeting note's tied todos (job 287); the panel shows nothing unless one of the day's
                               appointments has this note. *@
                            <MeetingTodosPanel @key="name" Day="meetingDay" NoteName="@name" />
                        }
                        int shownEditor = editorGeneration;
                        <NoteEditor @key="(name, openSensitive)" @ref="editor" Name="@name" Sensitive="openSensitive"
                                    OnTag="ShowTag" OnOpenNote="RequestOpen" OnOpenHeading="OpenHeading" OnCreateNote="CreateLinked" Heading="@openHeading" Decision="@openDecision" OnOpenDecision="OpenDecision" OnPerson="OpenMention" OnIdle="LockOpen" OnLocked="Locked"
                                    OnAttach="AttachDropped" OnOpenAttachment="OpenAttachment"
                                    OnOutline="OutlineReport(shownEditor)" />
                        @* 338: a person page is a flat page, so it shows no Subpages section. *@
                        @if (People.PersonOf(name) is null && Children(Snapshot, name) is { Count: > 0 } children)
                        {
                            <nav class="subpages" aria-label="Subpages">
                                <h2>Subpages</h2>
                                <ul>
                                    @foreach ((NoteInfo child, int below) in children)
                                    {
                                        string childName = child.Name;
                                        <li>
                                            <button type="button" class="subpage-link cut" title="@DesktopText.OneLine(childName)" @onclick="() => RequestOpen(childName)">@DesktopText.NoteName(child.Title)</button>
                                            @if (below > 0)
                                            {
                                                <span class="subpage-count">@(below == 1 ? "1 subpage" : $"{below} subpages")</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                        @if (historyShown)
                        {
                            <HistoryPanel Name="@name" Sensitive="openSensitive" OnRestore="AskRestore" OnClose="CloseHistory" />
                        }
                        @if (People.PersonOf(name) is { } person)
                        {
                            <PersonPanel Person="@person" OnOpen="RequestOpen" />
                        }
                        @if (WorkItems.ItemOf(name) is { } item)
                        {
                            <ItemPanel Item="item" OnOpen="RequestOpen" OnPerson="OpenMention" />
                        }
                        <LinksPanel Name="@name" Sensitive="openSensitive" OnOpen="RequestOpen" OnTag="ShowTag" />
                    }
                    else
                    {
                        <p class="grey no-note">No note open. Click Today to open today's note.</p>
                    }
                </div>
            </main>
            <aside class="todos-region">
                <DayAppointmentsPanel OnOpen="OpenAppointment" />
                <TimesTodayPanel />
                @if (openName is not null && page == Page.None)
                {
                    <OutlinePanel Headings="outline" OnJump="JumpToOutline" />
                }
                <TodoPanel @ref="todoPanel" OnPerson="OpenMention" OnOpen="RequestOpen" />
                <ToReviewPanel Guard="ReviewHeld" OnReviewed="Reviewed" OnOpen="RequestOpen" />
            </aside>
        </div>
        @if (discarding)
        {
            <ConfirmDialog Question="@($"Discard changes to {DesktopText.OneLine(openName ?? string.Empty)}?")" ConfirmLabel="Discard"
                           OnConfirm="Discard" OnCancel="KeepEditing" />
        }
        @if (deleting && openName is { } doomed)
        {
            <ConfirmDialog Question="@DeleteQuestion(doomed)" ConfirmLabel="Delete"
                           Busy="running" OnConfirm="DeleteConfirmed" OnCancel="CancelDelete" />
        }
        @if (renameAsk is { } ask && openName is { } renamingName)
        {
            <ConfirmDialog Question="@DesktopActions.RenameQuestion(renamingName, ask.NewName, ask.Count)" ConfirmLabel="Rename"
                           Busy="running" OnConfirm="RenameConfirmed" OnCancel="CancelRenameAsk" />
        }
        @if (marking && openName is { } sealing)
        {
            <ConfirmDialog Question="@($"Mark {DesktopText.OneLine(sealing)} sensitive? It will open only in this app, with this machine's key or the recovery file.")"
                           ConfirmLabel="Mark sensitive" Busy="running" OnConfirm="MarkConfirmed" OnCancel="CancelSensitive" />
        }
        @if (unsealing && openName is { } plain)
        {
            <ConfirmDialog Question="@($"Make {DesktopText.OneLine(plain)} plain? It will be stored as readable text again. Its history will be removed.")"
                           ConfirmLabel="Make plain" Busy="running" OnConfirm="MakePlainConfirmed" OnCancel="CancelSensitive" />
        }
        @if (sharing && openName is { } shared)
        {
            <ShareDialog Name="@shared" Busy="running" OnChoose="ShareChosen" OnCancel="CancelShare" />
        }
        @if (restoring is { } version && openName is { } restored)
        {
            <ConfirmDialog Question="@($"Restore {DesktopText.OneLine(restored)} to the version from {HistoryPanel.TimeText(version.SavedUtc, State.Zone)}? The current text is kept as a version.")"
                           ConfirmLabel="Restore" Busy="running" OnConfirm="RestoreConfirmed" OnCancel="CancelRestore" />
        }
        @if (paletteOpen)
        {
            <CommandPalette OnRun="RunCommand" OnClose="ClosePalette" />
        }
    }
}
else
{
    <p class="grey loading" role="status">Loading…</p>
}

@code {
    private string? openName;
    private NoteEditor? editor;

    // The open note's outline, as the current editor last reported it (shown in the right sidebar). Each editor is
    // handed the generation it was rendered with; a report from an older editor (another note opened, the note closed
    // or locked) carries an older one and is ignored. Bumped, and the list cleared, whenever the editor changes.
    private IReadOnlyList<OutlineHeading> outline = [];
    private int editorGeneration;

    // The receiver of the editors' outline reports: not a component, so a report renders this page only when it
    // changes what the sidebar shows (ShowOutline), not after every save.
    private readonly object outlineReceiver = new();
    private string? tagShown;
    private Page page;
    private bool reviewShown;
    private (string Key, string Value)? findShown;
    private string? searchShown;

    // Bumped each time the search panel is asked for, so asking again for the same text starts it over.
    private int searchRequest;

    // The note whose row Back to search focuses on the shown Search page (null: its input).
    private string? searchFocus;

    // While set, the open note came from the Search page with this query: Back to search shows it again (job 285).
    private (string Note, string Text)? searchBack;

    // A search result whose opening waits for the unsaved-changes dialog.
    private (string Note, string Text)? pendingSearchBack;
    private string? decisionsShown;
    private bool similarShown;
    private enum Page { None, Triage, People, Tags, Settings, Appointment, Board, Search, MailDigest, Done, Todos }

    // The board's tag (normalized) while Page.Board is shown (job 242).
    private string? boardShown;

    // The appointment page's title (raw) and day while Page.Appointment is shown.
    private (string Title, DateOnly Day)? appointmentShown;

    // An appointment page that opens once the unsaved-changes dialog is confirmed.
    private (string Title, DateOnly Day)? pendingAppointment;
    private bool discarding;
    private bool pendingClose;
    private string? pendingName;
    private string? pendingHeading;
    // The heading a [[Note#Heading]] link opened the note at; the new editor jumps there once, after its mount.
    private string? openHeading;
    // Job 343: the decision a reference or the log opened the note at; the new editor jumps there once, after its mount.
    private string? pendingDecision;
    private string? openDecision;
    private string? pendingPerson;
    private string? pendingLink;
    private bool pendingToday;
    // A day picked in the top bar whose daily note opens once the unsaved-changes dialog is confirmed.
    private DateOnly? pendingPickedDay;
    private bool pendingBriefing;
    private Appointment? pendingMeeting;
    private bool paletteOpen;
    private bool running;
    private string statusText = string.Empty;
    private string statusClass = string.Empty;
    private bool renaming;
    private string renameText = string.Empty;
    private ElementReference renameField;
    private bool focusRename;
    // While set, the rename question is open: the new full name and how many notes' links change.
    private (string NewName, int Count)? renameAsk;
    private bool deleting;
    private bool openSensitive;
    private bool marking;
    private bool unsealing;
    private bool sharing;
    private bool historyShown;
    private (string Id, DateTime SavedUtc)? restoring;
    private NotesPanel? notesPanel;
    private TodoPanel? todoPanel;
    private bool subpaging;
    private string subpageText = string.Empty;
    private ElementReference subpageField;
    private bool moving;
    private string moveText = string.Empty;
    private ElementReference moveField;
    private bool focusField;

    /// <summary>The status line when the automatic briefing was written while a note had unsaved changes.</summary>
    internal static string BriefingReadyText(string name) =>
        $"Today's briefing is ready: {DesktopText.OneLine(name)}. Type /briefing to open it.";

    /// <summary>Applies the theme to the page (job 341); this component mounts no editor through it.</summary>
    [Inject]
    internal EditorInterop ThemeInterop { get; set; } = null!;

    /// <summary>The OS file dialogs.</summary>
    [Inject]
    internal IFileDialog Dialog { get; set; } = null!;

    /// <summary>Asked by the window's closing handler; this page saves first and asks to discard when that failed.</summary>
    [Inject]
    internal CloseGuard Guard { get; set; } = null!;

    /// <summary>The command bar's way in (job 282): this page runs its todo, note and capture lines.</summary>
    [Inject]
    internal CommandBarContext CommandBar { get; set; } = null!;

    // The runner registered with CommandBar, kept so DisposeAsync clears exactly this one.
    private Func<string, Task<CommandBarResult>>? barRunner;

    public ValueTask DisposeAsync()
    {
        Guard.Detach();
        if (barRunner is not null)
        {
            CommandBar.Unregister(barRunner);
        }

        Dispose();
        return ValueTask.CompletedTask;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Guard.Attach(
            () => editor?.HasUnsaved ?? false,
            SaveFirstForCloseAsync,
            () => InvokeAsync(AskDiscardForClose));
        barRunner = RunFromBar;
        CommandBar.Register(barRunner);
        TakeStartNote();
        if (State.TakeBriefing() is { } offered)
        {
            ShowNote(offered);
        }

        TakeConversion();

        _ = TakeItemPage();
        if (State.DecisionClashesDue)
        {
            ShowDecisionClashesLater();
        }
    }

    // Job 349: reads the clash lines off the dispatcher and redraws once one was added; nothing waits for it. It runs
    // only while one is due (DesktopState.DecisionClashesDue), so a start or state change without a clash reads nothing.
    private void ShowDecisionClashesLater() => _ = InvokeAsync(async () =>
    {
        if (await TakeDecisionClashesAsync())
        {
            StateHasChanged();
        }
    });

    // Job 349: the clash lines shown (a foreign folder whose notes use the own decision prefix), each once: taking it
    // marks it warned in the index; Dismiss hides it.
    private List<DecisionFolderAlias> decisionClashes = [];

    internal static string ClashText(DecisionFolderAlias clash) =>
        $"Notes from another folder also use the decision prefix {clash.Prefix}. Here they show as {clash.Alias}.";

    private void DismissClash(DecisionFolderAlias clash) => decisionClashes = [.. decisionClashes.Where(c => c.Guid != clash.Guid)];

    // Adds the clashes not shown yet; true when one was added.
    private async Task<bool> TakeDecisionClashesAsync()
    {
        IReadOnlyList<DecisionFolderAlias> fresh = await State.TakeDecisionClashes();
        List<DecisionFolderAlias> added = [.. fresh.Where(clash => !decisionClashes.Any(c => c.Guid == clash.Guid))];
        decisionClashes = [.. decisionClashes, .. added];
        return added.Count > 0;
    }

    // A work item page asked for from the command line (job 280, DesktopActions.OpenRequestedItem) opens like a click
    // on a note name: the open note's unsaved changes are saved first, and when that fails the discard dialog asks.
    // While that dialog is already open, or before the first snapshot, the offer waits for the next state change.
    // True when it was taken.
    private async Task<bool> TakeItemPage()
    {
        if (Snapshot is null || discarding)
        {
            return false;
        }

        if (State.TakeItemPage() is not { } itemPage)
        {
            return false;
        }

        await RequestOpen(itemPage, null);
        return true;
    }

    // The start-up todo marker conversion's result (job 329) shows in the status line like an action's: accent when
    // lines changed, red when only notes were skipped. True when one was shown.
    private bool TakeConversion()
    {
        if (State.TakeConversion() is not { } converted)
        {
            return false;
        }

        ShowStatus(converted.Text, converted.Kind == ActionKind.Done ? "accent" : "red");
        return true;
    }

    // Today's note offered at start opens only while no note is open and no page, dialog or edit field is shown;
    // otherwise the offer is dropped. Before the first snapshot the offer waits (a sensitive note must be known as
    // one before its editor opens). True when the note was opened.
    private bool TakeStartNote()
    {
        if (Snapshot is null || State.TakeStartNote() is not { } start)
        {
            return false;
        }

        bool shown = openName is not null || page != Page.None || reviewShown || tagShown is not null
            || findShown is not null || searchShown is not null || decisionsShown is not null || similarShown || paletteOpen
            || discarding || renaming || subpaging || moving || deleting || renameAsk is not null || marking
            || unsealing || sharing || restoring is not null || running;
        if (shown)
        {
            return false;
        }

        ShowNote(start);
        return true;
    }

    // Today's note offered at start opens as in TakeStartNote. A briefing the automatic write offered opens when no
    // note has unsaved changes and nothing is being asked or typed; otherwise the editor is left alone and the status
    // line points to /briefing.
    protected override async Task OnStateChangedAsync()
    {
        // Job 349: a clash line is taken apart from the rest, only when the index saw one not yet shown, so a state
        // change never waits on the index for it.
        if (State.DecisionClashesDue)
        {
            ShowDecisionClashesLater();
        }

        bool started = TakeConversion();
        started |= TakeStartNote();
        started |= await TakeItemPage();
        if (State.TakeBriefing() is not { } offered || string.Equals(offered, openName, StringComparison.Ordinal))
        {
            if (started)
            {
                StateHasChanged();
            }

            return;
        }

        bool busy = discarding || renaming || subpaging || moving || deleting || marking || unsealing || sharing || running
            || (editor is not null && openName is not null && await editor.IsDirtyAsync());
        if (busy)
        {
            ShowStatus(BriefingReadyText(offered), "accent");
        }
        else
        {
            ShowNote(offered);
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplySavedTheme();
        }

        if (focusRename && renaming)
        {
            focusRename = false;
            await renameField.FocusAsync();
        }

        if (focusField && (subpaging || moving))
        {
            focusField = false;
            await (subpaging ? subpageField : moveField).FocusAsync();
        }
    }

    private void OpenPalette(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && string.Equals(e.Key, "k", StringComparison.OrdinalIgnoreCase) && !discarding && !deleting
            && !marking && !unsealing && !sharing)
        {
            paletteOpen = true;
        }
    }

    private void ClosePalette() => paletteOpen = false;

    private void ShowTag(string tag)
    {
        tagShown = TagIndex.NormalizeTag(tag);
    }

    private void CloseTag() => tagShown = null;

    private void CloseFind() => findShown = null;

    private void CloseSearch()
    {
        page = Page.None;
        searchShown = null;
        searchFocus = null;
    }

    // The Search page with <paramref name="text"/> (the text typed in the top bar's Search popover, possibly empty,
    // a saved search's query, or the text after /search), in place of the note area; its input gets the focus.
    private void ShowSearch(string text) => ShowSearchPage(text, null);

    // The Search page for text; focus names the note whose row takes the focus (Back to search), null the input.
    private void ShowSearchPage(string text, string? focus)
    {
        OpenPage(Page.Search);
        searchShown = text;
        searchFocus = focus;
        searchRequest++;
        ShowStatus(string.Empty, string.Empty);
    }

    // A result on the Search page: opens the note like a click on its name (saving first, or asking to discard);
    // once it shows, Back to search above it returns to that query's results.
    private async Task OpenFromSearch((string Note, string Text) hit)
    {
        if (string.Equals(hit.Note, openName, StringComparison.Ordinal))
        {
            await RequestOpen(hit.Note);
            searchBack = hit;
            return;
        }

        pendingSearchBack = hit;
        await RequestOpen(hit.Note);
        if (!discarding)
        {
            pendingSearchBack = null;
        }
    }

    // Back to search: the Search page again for the query the open note was opened from, read again, with that
    // note's row focused. The note stays open behind it, unsaved text included.
    private void BackToSearch()
    {
        if (searchBack is not { } back)
        {
            return;
        }

        ShowSearchPage(back.Text, back.Note);
    }

    private void CloseDecisions() => decisionsShown = null;

    private void CloseSimilar() => similarShown = false;

    // The tags view: every tag with its note count; a click on one shows the tag panel below it.
    private void ShowTags() => OpenPage(Page.Tags);

    private void CloseTags()
    {
        page = Page.None;
        tagShown = null;
    }

    // Triage, People, Tags, Settings and Search are pages: one at a time, in place of the note area. Any page, or
    // going back to the note, ends Back to search.
    private void OpenPage(Page next)
    {
        if (page == Page.Tags && next != Page.Tags)
        {
            tagShown = null;
        }

        if (page == Page.Search && next != Page.Search)
        {
            searchShown = null;
            searchFocus = null;
        }

        searchBack = null;
        page = next;
    }

    // The weekly review: shown at the top of the main region until closed or until a note opens.
    private void ShowReview() => reviewShown = true;

    private void CloseReview() => reviewShown = false;

    // Inbox triage: shown under the capture box until closed or until a note opens.
    private void ShowTriage() => OpenPage(Page.Triage);

    private void CloseTriage() => page = Page.None;

    // The done log (job 293): done.md grouped by week, a page in place of the note area.
    private void ShowDone() => OpenPage(Page.Done);

    private void CloseDone() => page = Page.None;

    // The Mail digest (job 286): suggestions from recent Outlook mail, read only on its Read mail button.
    private void ShowMailDigest() => OpenPage(Page.MailDigest);

    private void CloseMailDigest() => page = Page.None;

    // The people view (job 239): every person page by name; a click opens it through RequestOpen.
    private void ShowPeople() => OpenPage(Page.People);

    private void ClosePeople() => page = Page.None;

    // The Todos page (job 331): every open global todo grouped by due date, in place of the note area.
    private void ShowTodos() => OpenPage(Page.Todos);

    private void CloseTodos() => page = Page.None;

    // The settings: shown at the top of the main region until closed or until a note opens.
    private void ShowSettings() => OpenPage(Page.Settings);

    private void CloseSettings() => page = Page.None;

    // Job 341: the saved theme, at first render and after each theme saved in Settings; the page only ever gets a fixed
    // name, and an unreadable settings.json gives System.
    private async Task ApplySavedTheme() => await ThemeInterop.SetThemeAsync(await State.ThemeSetting());

