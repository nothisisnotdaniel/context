    // Opens the daily, meeting or linked note Actions gave (Created after a create), or shows why there is none.
    private void ShowDaily(ActionResult daily)
    {
        if (daily.Kind != ActionKind.Done)
        {
            ShowStatus(DesktopText.OneLine(daily.Text), "red");
            return;
        }

        if (string.Equals(daily.Text, openName, StringComparison.Ordinal))
        {
            // The editor stays, unsaved text included; a shown page (Triage, People, Tags, Settings, an appointment) closes.
            OpenPage(Page.None);
            appointmentShown = null;
        }
        else
        {
            ShowNote(daily.Text);
        }

        if (daily.Reason != ActionReason.Unchanged)
        {
            ShowStatus($"Created {DesktopText.OneLine(daily.Text)}", "accent");
        }
    }

    // record false: the open note was just renamed or moved, and the action already changed its recent entry in place.
    private void ShowNote(string? name, string? heading = null, bool record = true, string? decision = null)
    {
        (string? Name, bool Sensitive) before = (openName, openSensitive);
        if (record && name is not null && !string.Equals(name, openName, StringComparison.Ordinal))
        {
            // Never throws, never Busy; the sidebar lists the note first (job 240).
            _ = Actions.RecordOpened(name);
        }

        openName = name;
        openHeading = name is null ? null : heading;
        openDecision = name is null || heading is not null ? null : decision;
        pendingHeading = null;
        pendingDecision = null;
        openSensitive = name is not null
            && Snapshot is { } snapshot
            && snapshot.Sensitive.Any(n => string.Equals(n.Name, name, StringComparison.Ordinal));
        if (name is null || before != (openName, openSensitive))
        {
            // A new editor (or none): the old one's outline goes, and its later reports are ignored.
            editorGeneration++;
            outline = [];
        }
        pendingName = null;
        pendingPerson = null;
        pendingLink = null;
        pendingToday = false;
        pendingPickedDay = null;
        pendingBriefing = false;
        pendingMeeting = null;
        pendingAppointment = null;
        appointmentShown = null;
        tagShown = null;
        page = Page.None;
        reviewShown = false;
        findShown = null;
        searchShown = null;
        searchFocus = null;
        searchBack = pendingSearchBack is { } fromSearch && string.Equals(fromSearch.Note, name, StringComparison.Ordinal)
            ? fromSearch
            : null;
        pendingSearchBack = null;
        decisionsShown = null;
        similarShown = false;
        renaming = false;
        subpaging = false;
        moving = false;
        deleting = false;
        renameAsk = null;
        marking = false;
        unsealing = false;
        sharing = false;
        historyShown = false;
        restoring = null;
        if (name is null)
        {
            editor = null;
        }

        ShowStatus(string.Empty, string.Empty);
    }

    // Runs a palette command; the palette closes first.
    private async Task RunCommand(string line)
    {
        paletteOpen = false;
        string trimmed = line.Trim();
        int space = trimmed.IndexOfAny([' ', '\t']);
        string command = (space < 0 ? trimmed : trimmed[..space]).ToLowerInvariant();
        string rest = space < 0 ? string.Empty : trimmed[(space + 1)..].Trim();
        switch (command)
        {
            case "/capture":
                if (rest.Length == 0)
                {
                    ShowStatus("Type /capture <text>.", "red");
                }
                else
                {
                    await CaptureAsync(rest);
                }

                break;
            case "/open":
                string? found = rest.Length == 0 ? null : State.ResolveNote(rest);
                if (rest.Length == 0)
                {
                    ShowStatus("Type /open <note>.", "red");
                }
                else if (found is null)
                {
                    ShowStatus($"No note named {DesktopText.OneLine(rest)}.", "grey");
                }
                else
                {
                    await RequestOpen(found);
                }

                break;
            case "/find":
                // The attribute key, then the value: /find role Bereichsleiter. Read only.
                int keyEnd = rest.IndexOfAny([' ', '\t']);
                string? findKey = keyEnd < 0 ? null : AttributeParser.NormalizeKey(rest[..keyEnd]);
                string findValue = keyEnd < 0 ? string.Empty : TagParser.CollapseWhitespace(rest[(keyEnd + 1)..]);
                if (findKey is null || findValue.Length == 0)
                {
                    ShowStatus("Type /find <attribute> <value>.", "red");
                }
                else
                {
                    findShown = (findKey, findValue);
                    ShowStatus(string.Empty, string.Empty);
                }

                break;
            case "/search":
                // The text to look for in every plain note: /search budget 2027. Read only; SearchPanel shows the
                // hint for a blank text and the usage line for a bad one.
                ShowSearch(rest);
                break;
            case "/board":
                // A tag's board: /board launch. Read only until a card is moved.
                ShowBoard(rest);
                break;
            case "/decisions":
                // Every note's #!d decisions, or those of the notes with a tag: /decisions #work. Read only;
                // DecisionsPanel shows the usage line for an invalid tag.
                decisionsShown = rest;
                ShowStatus(string.Empty, string.Empty);
                break;
            case "/similar":
                // Pairs of notes that look like duplicates (job 268). Read only until a Keep button is confirmed.
                similarShown = true;
                ShowStatus(string.Empty, string.Empty);
                break;
            case "/share":
                // As /export: the target comes from the OS save dialog only, after the share dialog.
                await AskShare();
                break;
            case "/import":
                // What was typed after the command is ignored: the files come from the OS dialog only.
                if (notesPanel is not null)
                {
                    await notesPanel.Import();
                }

                break;
            case "/export":
                // As above: the target comes from the OS save dialog only.
                if (await ExportTarget() is { } chosen)
                {
                    running = true;
                    try
                    {
                        ShowExported(await Actions.ExportNote(chosen.Name, chosen.Target));
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            case "/new":
                (string Title, string Template)? fromTemplate = SplitTemplate(rest);
                if (rest.Length == 0)
                {
                    ShowStatus("Type /new <title>.", "red");
                }
                else if (fromTemplate is { } typed && (typed.Title.Length == 0 || typed.Template.Length == 0))
                {
                    ShowStatus("Type /new <title> --template <template>.", "red");
                }
                else if (!running)
                {
                    running = true;
                    ActionResult made;
                    try
                    {
                        made = fromTemplate is { } named
                            ? await Actions.CreateNoteFromTemplate(named.Title, named.Template)
                            : await Actions.CreateNote(rest);
                    }
                    finally
                    {
                        running = false;
                    }

                    if (made.Kind == ActionKind.Done)
                    {
                        await RequestOpen(made.Text);
                        ShowStatus($"Created {DesktopText.OneLine(made.Text)}", "accent");
                    }
                    else
                    {
                        ShowStatus(DesktopText.OneLine(made.Text), "red");
                    }
                }

                break;
            case "/save":
                if (editor is null || openName is null)
                {
                    ShowStatus("No note is open.", "grey");
                }
                else if (!running)
                {
                    running = true;
                    try
                    {
                        await editor.SaveAsync(false);
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            case "/review":
                // The argument is ignored.
                ShowReview();
                break;
            case "/settings":
                ShowSettings();
                break;
            case "/donelog":
                // The argument is ignored.
                ShowDone();
                break;
            case "/digest":
                // The argument is ignored.
                ShowMailDigest();
                break;
            case "/triage":
                // The argument is ignored.
                ShowTriage();
                break;
            case "/tags":
                if (rest.Length == 0)
                {
                    ShowTags();
                }
                else
                {
                    ShowTag(rest);
                }

                break;
            case "/briefing":
                // The argument is ignored. A dirty editor asks first, unless it already shows today's briefing.
                if (editor is not null && openName is not null
                    && !string.Equals(openName, Actions.BriefingName(), StringComparison.Ordinal)
                    && await KeptUnsaved())
                {
                    pendingName = null;
                    pendingPerson = null;
                    pendingLink = null;
                    pendingToday = false;
                    pendingPickedDay = null;
                    pendingMeeting = null;
                    pendingAppointment = null;
                    pendingBriefing = true;
                    discarding = true;
                    break;
                }

                if (!running)
                {
                    running = true;
                    ActionResult briefing;
                    try
                    {
                        briefing = await Actions.OpenBriefing();
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowDaily(briefing);
                }

                break;
            case "/today":
                // The argument is ignored; the same as the Today button.
                await ShowToday();
                break;
            case "/standup":
            {
                // The argument is ignored. With today's note open it runs the Standup item (unsaved text saved first);
                // otherwise the standup is written first (creating the note when missing) and today's note then opens
                // like /today, so its new editor loads the written section instead of racing the write.
                string todayName = Actions.DailyNoteName();
                if (page == Page.None && string.Equals(openName, todayName, StringComparison.Ordinal)
                    && Snapshot is { } shown && string.Equals(todayName, DailyNote.NameFor(shown.Today), StringComparison.Ordinal))
                {
                    await RunPageAction("standup");
                    break;
                }

                if (string.Equals(openName, todayName, StringComparison.Ordinal))
                {
                    // Today's note is open behind a page: close the page, keep the editor, then run the item.
                    await ShowToday();
                    await RunPageAction("standup");
                    break;
                }

                if (running || Snapshot is not { } current)
                {
                    break;
                }

                running = true;
                ActionResult standup;
                try
                {
                    standup = await Actions.WriteStandup(current.Today);
                }
                finally
                {
                    running = false;
                }

                await ShowToday();
                ShowStandup(standup);
                break;
            }
            case "/meeting":
                // The number of today's appointment in the snapshot's current view, numbered as `context current`.
                if (!MeetingNote.TryParseNumber(rest, out int meetingNumber))
                {
                    ShowStatus("Type /meeting <number>.", "red");
                    break;
                }

                Appointment? appointment = MeetingNote.Pick(
                    Snapshot?.Current?.Appointments ?? [], meetingNumber, out string? meetingError);
                if (appointment is null)
                {
                    ShowStatus(DesktopText.OneLine(meetingError ?? MeetingNote.NoAppointmentsText), "red");
                    break;
                }

                // A dirty editor asks first, unless it already shows this meeting's note.
                if (editor is not null && openName is not null
                    && !MeetingNote.IsNoteOf(appointment, openName)
                    && await KeptUnsaved())
                {
                    pendingName = null;
                    pendingPerson = null;
                    pendingLink = null;
                    pendingToday = false;
                    pendingPickedDay = null;
                    pendingBriefing = false;
                    pendingAppointment = null;
                    pendingMeeting = appointment;
                    discarding = true;
                    break;
                }

                if (!running)
                {
                    running = true;
                    ActionResult meetingNote;
                    try
                    {
                        meetingNote = await Actions.OpenMeetingNote(appointment);
                    }
                    finally
                    {
                        running = false;
                    }

                    ShowDaily(meetingNote);
                }

                break;
            case "/done":
                PickDone(rest);
                break;
            case "/todo":
                if (!TodoCommand.TryParse(rest, Snapshot?.Today ?? default, out TodoCommand? todo, out string todoUsage) || todo is null)
                {
                    ShowStatus("Type /" + todoUsage + ".", "red");
                    break;
                }

                if (!running)
                {
                    running = true;
                    try
                    {
                        ActionResult added = await Actions.AddTodo(todo.Text, todo.Due, todo.Repeat, todo.Time);
                        ShowStatus(
                            added.Kind == ActionKind.Done ? $"Added: {DesktopText.OneLine(added.Text)}" : DesktopText.OneLine(added.Text),
                            added.Kind == ActionKind.Done ? "accent" : "red");
                    }
                    finally
                    {
                        running = false;
                    }
                }

                break;
            default:
                ShowStatus("Unknown command.", "red");
                break;
        }
    }

    // /done <text>: picks the open todo by its text like context todo done and asks the todo panel's dialog to
