@inherits StateComponent
@* The appointment page in the main region: every note related to the shown day's appointments with this title
   (DesktopState.AppointmentPage: meeting prep with no cap, over the title and the union of their attendees). A note
   opens through OnOpen. Below them (or alone, with none) a link asks Main for the meeting note of the first such
   appointment; once that note exists (job 395) the link opens a title field instead, which creates a plain note like
   the notes bar's entry row (DesktopActions.CreateNote) and hands its name to OnCreated. It reloads whenever the state
   changes, keeping the shown rows. Above the notes, the open topics for the next 1:1 with
   the attendees (job 253) each have a checkbox that ticks the topic off in its note after a confirmation. Below them, the
   todos tied to these appointments (job 287, MeetingTodosPanel). *@

<section class="page appointment-page" aria-label="Appointment">
    <div class="panel-bar">
        <h2 class="cut" title="@Heading">@Heading</h2>
        <button type="button" class="close" aria-label="Close" title="Close" @onclick="() => OnClose.InvokeAsync()"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" /></svg></button>
    </div>
    @if (view is { IndexUnreadable: false, Topics.Count: > 0 })
    {
        <section class="topics" aria-labelledby="appointment-topics-heading">
            <h3 id="appointment-topics-heading">Topics</h3>
            <ul class="topics-list">
                @foreach (NoteTopic topic in view.Topics)
                {
                    string text = DesktopText.OneLine(topic.Person + ": " + topic.Text);
                    string noteName = DesktopText.OneLine(topic.Note);
                    <li class="topic">
                        <label class="topic-line">
                            <input type="checkbox" class="done" checked="@(askingTopic == topic)" disabled="@running"
                                   @onchange="() => AskTopic(topic)" />
                            <span class="text cut" title="@text">@text</span>
                        </label>
                        <button type="button" class="topic-note cut" title="@noteName" @onclick="() => OnOpen.InvokeAsync(topic.Note)">@noteName</button>
                    </li>
                }
            </ul>
        </section>
    }
    @if (topicResult is { Kind: not ActionKind.Done } failed)
    {
        <p class="red topic-result" role="status">@DesktopText.OneLine(failed.Text)</p>
    }
    <MeetingTodosPanel Day="Day" Title="@Title" />
    <h3 id="appointment-notes-heading">Notes</h3>
    @if (view is null)
    {
        <p class="grey" role="status">Loading…</p>
    }
    else if (view.IndexUnreadable)
    {
        <p class="red" role="status">Can't read the related notes.</p>
    }
    else
    {
        @if (view.Related.Count > 0)
        {
            <ul class="appointment-notes" aria-labelledby="appointment-notes-heading">
                @foreach (RelatedNote note in view.Related)
                {
                    string name = note.Name;
                    string shownName = DesktopText.OneLine(name);
                    string noteTitle = DesktopText.OneLine(NoteTitle(name));
                    string matches = DesktopText.OneLine(Matches(note));
                    <li>
                        <button type="button" class="note-button cut" title="@shownName" @onclick="() => OnOpen.InvokeAsync(name)">@noteTitle</button>
                        <span class="matches grey cut" title="@matches">@matches</span>
                    </li>
                }
            </ul>
        }
        else if (view.First is null)
        {
            <p class="grey" role="status">No related notes.</p>
        }
        @if (view.Related.Count > 0 || view.First is not null)
        {
            <button type="button" class="create-note-link" @ref="createLink" @onclick="CreateClicked">Create a new note</button>
        }
        @if (newTitle is not null)
        {
            <div class="create-note-entry">
                <input type="text" class="create-note-title" aria-label="Note title" placeholder="Note title" maxlength="200"
                       value="@newTitle" disabled="@creating" @ref="titleField" @oninput="TitleTyped" @onkeydown="TitleKey" />
                <button type="button" class="create-note-confirm" disabled="@creating" @onclick="CreateTitled">Create note</button>
                <button type="button" class="create-note-cancel" disabled="@creating" @onclick="CloseEntry">Cancel</button>
            </div>
            @if (createFailed is { } failedText)
            {
                <p class="red create-note-result" role="status" title="@failedText">@failedText</p>
            }
        }
    }
    @if (askingTopic is { } topicAsked)
    {
        <ConfirmDialog Question="@($"Mark this topic done? {topicAsked.Text}")" ConfirmLabel="Mark done"
                       Busy="running" OnConfirm="CompleteTopicAsked" OnCancel="CloseDialog" />
    }
</section>

@code {
    private AppointmentPageView? view;
    private NoteTopic? askingTopic;
    private ActionResult? topicResult;
    private bool running;
    private (string Title, DateOnly Day)? loaded;
    private int request;
    private ElementReference createLink;
    private ElementReference titleField;
    // The title field's text while it is open (job 395), else null; its red refusal text; a create running.
    private string? newTitle;
    private string? createFailed;
    private bool creating;
    private bool checkingLink;
    private bool focusField;
    private bool focusLink;

    // Tests: bUnit leaves a re-rendered element's reference attribute empty, so they compare these ids.
    internal ElementReference CreateLinkReference => createLink;

    internal ElementReference TitleFieldReference => titleField;

    /// <summary>The appointments' title (raw; ordinal equality picks the appointments).</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>The day of the appointments.</summary>
    [Parameter]
    [EditorRequired]
    public DateOnly Day { get; set; }

    /// <summary>Called with a related note's full name when it is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    /// <summary>
    /// Called when the create link is clicked; Main makes the meeting note of the day's first appointment with the
    /// title (Appointment is internal, so it can't be a public parameter type).
    /// </summary>
    [Parameter]
    public EventCallback OnCreate { get; set; }

    /// <summary>
    /// Called with the full name of a note the title field created (job 395); Main opens it like the notes bar's entry
    /// row does and shows <c>Created &lt;name&gt;</c>.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string Heading => DesktopText.OneLine(Title.Length == 0 ? "(no title)" : Title);

    protected override Task OnParametersSetAsync()
    {
        if (loaded == (Title, Day))
        {
            return Task.CompletedTask;
        }

        // Another appointment: its rows are not known yet, so the old ones go.
        loaded = (Title, Day);
        view = null;
        topicResult = null;
        newTitle = null;
        createFailed = null;
        return Load();
    }

    protected override async Task OnStateChangedAsync()
    {
        await Load();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusField)
        {
            focusField = false;
            await titleField.FocusAsync();
        }
        else if (focusLink)
        {
            focusLink = false;
            await createLink.FocusAsync();
        }
    }

    // The create link: while the first appointment's meeting note is missing, Main runs the /meeting steps (job 214);
    // once it exists, or with no such appointment, the title field opens, prefilled with the meeting note's title part.
    private async Task CreateClicked()
    {
        if (view is null || checkingLink || creating)
        {
            return;
        }

        if (newTitle is not null)
        {
            focusField = true;
            return;
        }

        Appointment? first = view.First;
        checkingLink = true;
        bool exists;
        try
        {
            exists = first is null || await State.MeetingNoteExists(first);
        }
        finally
        {
            checkingLink = false;
        }

        if (!exists)
        {
            await OnCreate.InvokeAsync();
            return;
        }

        DateTime midnight = Day.ToDateTime(TimeOnly.MinValue);
        newTitle = MeetingNote.TitlePartFor(first ?? new Appointment(Title, null, midnight, midnight, false));
        createFailed = null;
        focusField = true;
    }

    private void TitleTyped(ChangeEventArgs e)
    {
        newTitle = e.Value?.ToString() ?? string.Empty;
        createFailed = null;
    }

    private async Task TitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateTitled();
        }
        else if (e.Key == "Escape")
        {
            CloseEntry();
        }
    }

    private void CloseEntry()
    {
        if (creating || newTitle is null)
        {
            return;
        }

        newTitle = null;
        createFailed = null;
        focusLink = true;
    }

    // Create note and Enter: the notes bar entry row's action; a refusal keeps the field and its text.
    private async Task CreateTitled()
    {
        if (newTitle is not { } title || creating)
        {
            return;
        }

        creating = true;
        ActionResult made;
        try
        {
            made = await Actions.CreateNote(title);
        }
        finally
        {
            creating = false;
        }

        if (made.Kind != ActionKind.Done)
        {
            createFailed = DesktopText.OneLine(made.Text);
            focusField = true;
            return;
        }

        newTitle = null;
        createFailed = null;
        await OnCreated.InvokeAsync(made.Text);
    }

    private void AskTopic(NoteTopic topic)
    {
        if (!running)
        {
            askingTopic = topic;
        }
    }

    private void CloseDialog()
    {
        if (!running)
        {
            askingTopic = null;
        }
    }

    private async Task CompleteTopicAsked(Confirmation confirmed)
    {
        if (askingTopic is not { } topic || running)
        {
            return;
        }

        running = true;
        try
        {
            topicResult = await Actions.CompleteTopic(topic, confirmed);
        }
        finally
        {
            running = false;
            askingTopic = null;
        }
    }

    // The last segment of a full note name, as NoteInfo.Title.
    private static string NoteTitle(string name)
    {
        int slash = name.LastIndexOf('/');
        return slash < 0 ? name : name[(slash + 1)..];
    }

    private static string Matches(RelatedNote note) =>
        string.Join(' ', note.Tags.Select(TagParser.Format).Concat(note.Words));

    // Keeps the shown rows while it reloads. A result for another appointment, or an older request's result, is dropped.
    private async Task Load()
    {
        int mine = ++request;
        string title = Title;
        DateOnly day = Day;
        AppointmentPageView result = await State.AppointmentPage(title, day);
        if (mine == request && string.Equals(title, Title, StringComparison.Ordinal) && day == Day)
        {
            view = result;
        }
    }
}
