@inherits StateComponent
@* Every tag with its note count (DesktopState.Tags), in the index's order; clicking one shows its notes. It reads
   only, and reloads whenever the state changes. *@

<section class="tags-panel" aria-label="Tags">
    <div class="panel-bar">
        <h2>Tags</h2>
        <button type="button" class="close" @onclick="() => OnClose.InvokeAsync()">Close</button>
    </div>
    @if (view is null)
    {
        <p class="grey" role="status">Loading…</p>
    }
    else if (view.Kind == TagsViewKind.IndexUnreadable)
    {
        <p class="red" role="status">Can't read the tags.</p>
    }
    else if (view.Tags.Count == 0)
    {
        <p class="grey" role="status">No tags yet. Add #tag to a note to link it.</p>
    }
    else
    {
        <ul class="tag-list">
            @foreach (TagCount row in view.Tags)
            {
                string tag = row.Tag;
                string shown = DesktopText.OneLine(TagParser.Format(tag));
                bool pressed = string.Equals(tag, Selected, StringComparison.Ordinal);
                <li class="tag-row">
                    <button type="button" class="tag-button cut" title="@shown" aria-pressed="@(pressed ? "true" : "false")"
                            @onclick="() => OnTag.InvokeAsync(TagParser.Format(tag))">@shown</button>
                    <span class="count grey">@row.Count.ToString(CultureInfo.InvariantCulture)</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    private TagsView? view;
    private int request;

    /// <summary>The tag whose notes are shown below the list (as TagParser finds it, no <c>#</c>), or <c>null</c>.</summary>
    [Parameter]
    public string? Selected { get; set; }

    /// <summary>Called with a tag, formatted like TagParser.Format, when its button is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnTag { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override Task OnInitializedAsync() => Load();

    protected override async Task OnStateChangedAsync()
    {
        await Load();
        StateHasChanged();
    }

    // Keeps the shown tags while it reloads; only the newest request's result is used.
    private async Task Load()
    {
        int mine = ++request;
        TagsView result = await State.Tags();
        if (mine == request)
        {
            view = result;
        }
    }
}
