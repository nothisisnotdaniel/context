    // A theme button: a pressed one does nothing; otherwise stores the choice and, once saved, has the page apply it.
    // A failed save leaves the saved theme pressed and the page as it was.
    private async Task ChooseTheme(AppTheme chosen)
    {
        if (busy || theme is not AppTheme current || chosen == current)
        {
            return;
        }

        busy = true;
        ActionResult result;
        try
        {
            result = await Actions.SetTheme(chosen);
        }
        finally
        {
            busy = false;
        }

        if (result.Kind == ActionKind.Done)
        {
            theme = chosen;
            themeResultId = Bar.Update(themeResultId, DesktopActions.ThemeText(chosen), "accent");
            await OnThemeChanged.InvokeAsync();
        }
        else
        {
            themeResultId = Bar.Update(themeResultId, DesktopActions.SettingsNotSavedText, "red");
        }

        await Load();
    }

