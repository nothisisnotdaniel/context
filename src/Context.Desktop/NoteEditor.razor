@inherits StateComponent
@implements IAsyncDisposable
@* The note editor: the bundled ProseMirror editor (EditorInterop) in a host element, a Save button and a status
   line. Saving goes through DesktopActions.SaveNote only from the Save button and Ctrl/Cmd+S. Tag and link clicks
   come back from the page as events and only open things; the page's dirty flips only show or hide the dot next
   to the name (every decision still asks IsDirtyAsync). A sensitive note is read through DesktopState.ReadSensitive
   (the one place the OS is asked for the key); its text lives only in the SensitiveSession and in the page's editor,
   and the editor tells its parent when the session locked or sat idle. *@

<section class="note-editor" @onkeydown="e => Save(e)" @oninput="Used">
    <div class="editor-bar">
        <h2 class="note-title cut" title="@DisplayName">@DisplayName</h2>
        @if (dirty)
        {
            <span class="dirty-dot" role="img" aria-label="Unsaved changes" title="Unsaved changes"></span>
        }
        <button type="button" class="save" disabled="@(opened is null || saving)" @onclick="() => Save(null)">Save</button>
    </div>
    @if (unreadable)
    {
        <p class="red unreadable" role="alert">@(Sensitive ? "Can't unlock" : "Can't read") @DisplayName.</p>
    }
    @if (editorFailed)
    {
        <p class="red editor-failed" role="alert">The editor couldn't start. @DisplayName was not changed.</p>
    }
    @if (lossy)
    {
        <p class="grey lossy">Saving will reformat parts of this note.</p>
    }
    <p class="status @statusClass" role="status">@statusText</p>
    <div class="editor-host" @ref="host"></div>
</section>

@code {
    private ElementReference host;
    private EditableNote? opened;
    private bool mounted;
    private bool unreadable;
    private bool editorFailed;
    private bool lossy;
    private bool saving;
    private bool dirty;
    private string statusText = string.Empty;
    private string statusClass = string.Empty;

    /// <summary>The bridge to the page's editor; one per editor.</summary>
    [Inject]
    internal EditorInterop Interop { get; set; } = null!;

    /// <summary>The note to open (its name).</summary>
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Called with the tag (as found by TagParser) when a tag in the text is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnTag { get; set; }

    /// <summary>Called with the note's name when a link to an existing note is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnOpenNote { get; set; }

    /// <summary>True when <see cref="Name"/> is a sensitive note: it is unlocked instead of read.</summary>
    [Parameter]
    public bool Sensitive { get; set; }

    /// <summary>Called when the open sensitive note sat unused for too long; the parent saves and locks it.</summary>
    [Parameter]
    public EventCallback OnIdle { get; set; }

    /// <summary>Called when the open sensitive note was locked; the parent takes this editor down.</summary>
    [Parameter]
    public EventCallback OnLocked { get; set; }

    private string DisplayName => DesktopText.OneLine(Name);

    /// <summary>True when the text changed since it was opened or last saved.</summary>
    public async Task<bool> IsDirtyAsync() => mounted && await Interop.IsDirtyAsync(host);

    /// <summary>
    /// What a save writes: the note as opened and the editor's Markdown, or the text as opened when nothing was
    /// edited, so an unedited note is never reformatted. <c>null</c> while no note is open or a save runs.
    /// </summary>
    internal async Task<SaveRequest?> PrepareSaveAsync()
    {
        if (opened is not { } note || !mounted || saving)
        {
            return null;
        }

        bool dirty = await Interop.IsDirtyAsync(host);
        string text = dirty ? await Interop.GetMarkdownAsync(host) : note.Text;
        return new SaveRequest(note, text);
    }

    /// <summary>Shows how a save ended; after a save the saved text becomes the text as opened.</summary>
    internal async Task ApplySaveAsync(ActionResult result)
    {
        if (result.Kind == ActionKind.Done)
        {
            if (result.Note is { } saved)
            {
                opened = saved;
                lossy = !await Interop.IsLosslessAsync(saved.Text);
            }

            await Interop.MarkCleanAsync(host);
            dirty = false;
            ShowStatus($"Saved {DesktopText.OneLine(result.Text)}.", "accent");
        }
        else
        {
            ShowStatus(DesktopText.OneLine(result.Text), "red");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Reads the plain note again and mounts the editor with that text, without taking the focus: after something
    /// else (a capture) wrote the note while it was open without unsaved changes. A sensitive note, an editor that
    /// isn't mounted or a running save is left alone; a note that can't be read any more keeps what is shown.
    /// </summary>
    internal async Task ReloadAsync()
    {
        if (Sensitive || !mounted || saving)
        {
            return;
        }

        EditableNote? note = await State.ReadForEdit(Name);
        if (note is null)
        {
            return;
        }

        try
        {
            lossy = !await Interop.IsLosslessAsync(note.Text);
            await Interop.MountAsync(host, note.Text);
            opened = note;
            dirty = false;
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; the editor keeps what it has.
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (Sensitive)
        {
            // Leaving a sensitive note drops its text; the next open asks the OS again.
            State.Session.Locked -= SessionLocked;
            State.Session.IdleReached -= SessionIdle;
            State.Session.Close(Name);
        }

        Interop.TagClicked -= TagClicked;
        Interop.LinkClicked -= LinkClicked;
        Interop.DirtyChanged -= DirtyChanged;
        await Interop.DestroyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Sensitive)
        {
            State.Session.Locked += SessionLocked;
            State.Session.IdleReached += SessionIdle;
        }

        EditableNote? note = Sensitive ? await State.ReadSensitive(Name) : await State.ReadForEdit(Name);
        if (note is null)
        {
            unreadable = true;
            StateHasChanged();
            return;
        }

        try
        {
            lossy = !await Interop.IsLosslessAsync(note.Text);
            Interop.TagClicked += TagClicked;
            Interop.LinkClicked += LinkClicked;
            Interop.DirtyChanged += DirtyChanged;
            await Interop.MountAsync(host, note.Text);
            opened = note;
            mounted = true;
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The note was read; only the page's editor didn't start. Nothing is open, so nothing can be saved.
            editorFailed = true;
            lossy = false;
        }

        if (mounted)
        {
            try
            {
                await Interop.FocusAsync(host);
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
            {
                // The editor is mounted and works; it only didn't take the focus.
            }
        }

        StateHasChanged();
    }

    private async Task Save(KeyboardEventArgs? key)
    {
        Used();
        if (key is not null && !((key.CtrlKey || key.MetaKey) && string.Equals(key.Key, "s", StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        if (await PrepareSaveAsync() is not { } request)
        {
            return;
        }

        saving = true;
        try
        {
            ActionResult result = await Actions.SaveNote(request.Note, request.Text);
            await ApplySaveAsync(result);
        }
        finally
        {
            saving = false;
        }
    }

    // Typing, pasting and saving count as use of an open sensitive note.
    private void Used()
    {
        if (Sensitive)
        {
            State.Session.Touch();
        }
    }

    private void SessionLocked() => _ = InvokeAsync(() => OnLocked.InvokeAsync());

    private void SessionIdle() => _ = InvokeAsync(() => OnIdle.InvokeAsync());

    private Task TagClicked(string raw) => InvokeAsync(async () =>
    {
        IReadOnlyList<string> tags = TagParser.Parse(raw);
        if (tags.Count > 0)
        {
            await OnTag.InvokeAsync(tags[0]);
        }
    });

    private Task LinkClicked(string raw) => InvokeAsync(async () =>
    {
        IReadOnlyList<string> targets = NoteLinkParser.Parse(raw);
        if (targets.Count == 0)
        {
            return;
        }

        string? name = State.ResolveNote(targets[0]);
        if (name is null)
        {
            ShowStatus($"No note named {DesktopText.OneLine(targets[0])}.", "grey");
            StateHasChanged();
            return;
        }

        await OnOpenNote.InvokeAsync(name);
    });

    // Display only: shows or hides the dot; nothing is read or written.
    private Task DirtyChanged(bool changed) => InvokeAsync(() =>
    {
        if (dirty != changed)
        {
            dirty = changed;
            StateHasChanged();
        }
    });

    private void ShowStatus(string text, string cssClass)
    {
        statusText = text;
        statusClass = cssClass;
    }
}
