@inherits StateComponent
@using System.Text.Json
@implements IAsyncDisposable
@* The note editor: the bundled ProseMirror editor (EditorInterop) in a host element and a status line; no Save
   button. Every save goes through one serialized path to DesktopActions.SaveNote: on its own after the pause that
   follows the last edit (IAutoSavePause), from Ctrl/Cmd+S and /save, and from the parent before it leaves
   the note (SaveFirstAsync). Tag and link clicks
   come back from the page as events and only open things; the page's dirty flips only show or hide the dot next
   to the name (every decision still asks IsDirtyAsync). A sensitive note is read through DesktopState.ReadSensitive
   (the one place the OS is asked for the key); its text lives only in the SensitiveSession and in the page's editor,
   and the editor tells its parent when the session locked or sat idle. *@

<section class="note-editor" @onkeydown="e => Save(e)" @oninput="Used">
    <div class="editor-bar">
        <h2 class="note-title cut" title="@DisplayName">@ShownTitle</h2>
        @if (dirty)
        {
            <span class="dirty-dot" role="img" aria-label="Unsaved changes" title="Unsaved changes"></span>
        }
    </div>
    @if (attributeRows.Count > 0)
    {
        @* Collapsed on every open: Blazor never renders "open", so the user's toggle survives re-renders. *@
        <details class="note-attributes">
            <summary>Attributes (@attributeRows.Count)</summary>
            <ul class="attribute-rows">
                @for (int i = 0; i < attributeRows.Count; i++)
                {
                    int index = i;
                    string key = DesktopText.OneLine(attributeRows[i].Key);
                    <li class="attribute-row">
                        <span class="attribute-key cut" title="@key">@key</span>
                        <input type="text" class="attribute-value" maxlength="400" value="@DesktopText.OneLine(attributeRows[i].Value)"
                               aria-label="@($"{key} value")" @onchange="e => ChangeAttribute(index, e)" />
                        <button type="button" class="attribute-remove" aria-label="@($"Remove {key}")" title="@($"Remove {key}")"
                                @onclick="() => RemoveAttribute(index)">×</button>
                    </li>
                }
            </ul>
            <div class="attribute-add">
                <input type="text" class="attribute-new-key" maxlength="50" value="@newAttributeKey" aria-label="New attribute name"
                       placeholder="Name" @oninput="e => newAttributeKey = e.Value?.ToString() ?? string.Empty" />
                <input type="text" class="attribute-new-value" maxlength="400" value="@newAttributeValue" aria-label="New attribute value"
                       placeholder="Value" @oninput="e => newAttributeValue = e.Value?.ToString() ?? string.Empty" />
                <button type="button" class="attribute-add-button" @onclick="AddAttribute">Add</button>
            </div>
            @if (attributeKeyRefused)
            {
                <p class="red attribute-error" role="alert">Type an attribute name that starts with a letter.</p>
            }
        </details>
    }
    @if (unreadable)
    {
        <p class="red unreadable" role="alert">@(Sensitive ? "Can't unlock" : "Can't read") @DisplayName.</p>
    }
    @if (editorFailed)
    {
        <p class="red editor-failed" role="alert">The editor couldn't start. @DisplayName was not changed.</p>
    }
    <p class="status @statusClass" role="status">
        @if (statusLines.Count > 0)
        {
            @foreach ((string text, string css) in statusLines)
            {
                <span class="line cut @css" title="@text">@text</span>
            }
        }
        else
        {
            @statusText
        }
    </p>
    <div class="editor-host" @ref="host"></div>
</section>

@code {
    private ElementReference host;
    private EditableNote? opened;
    private bool mounted;
    private bool unreadable;
    private bool editorFailed;
    private bool saving;
    private bool dirty;
    private string statusText = string.Empty;
    private string statusClass = string.Empty;
    private List<(string Text, string Css)> statusLines = [];
    private readonly SemaphoreSlim saveGate = new(1, 1);
    private CancellationTokenSource? pause;
    private bool disposed;

    // The page-title lookups of links pasted into this mount (job 244): all cancelled by a remount or when the editor
    // goes away, so a late title never reaches another text.
    private CancellationTokenSource titleFetches = new();

    /// <summary>The latest pasted link's title lookup (finished when there was none); for tests to wait on.</summary>
    internal Task LastTitleFetch { get; private set; } = Task.CompletedTask;

    // The open document's headings, read from the mounted editor only (a sensitive note's never leave its memory but
    // as this list, reported through OnOutline); empty until mounted, and reported empty when this editor goes away or
    // locks.
    private IReadOnlyList<OutlineHeading> outline = [];

    // The rows of the open note's attribute block, read from the mounted editor only after every mount (a sensitive
    // note's stay in the unlocked editor and here, and go away on lock); empty until mounted.
    private IReadOnlyList<NoteAttribute> attributeRows = [];
    private string newAttributeKey = string.Empty;
    private string newAttributeValue = string.Empty;
    private bool attributeKeyRefused;

    /// <summary>The bridge to the page's editor; one per editor.</summary>
    [Inject]
    internal EditorInterop Interop { get; set; } = null!;

    /// <summary>The pause after the last edit before the editor saves on its own.</summary>
    [Inject]
    internal IAutoSavePause Pause { get; set; } = null!;

    /// <summary>The note to open (its name).</summary>
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Called with the tag (as found by TagParser) when a tag in the text is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnTag { get; set; }

    /// <summary>Called with the note's name when a link to an existing note is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnOpenNote { get; set; }

    /// <summary>
    /// Called with the note's name and the heading when a <c>[[Note#Heading]]</c> link to another existing note is
    /// clicked; without a delegate such a link goes to <see cref="OnOpenNote"/>.
    /// </summary>
    [Parameter]
    public EventCallback<(string Name, string Heading)> OnOpenHeading { get; set; }

    /// <summary>
    /// Called with the link's target as written (no brackets, e.g. <c>Ghost#Goals</c>) when a link to a note that
    /// doesn't exist is clicked and the target has a note part; without a delegate the editor shows
    /// <c>No note named &lt;target&gt;.</c>
    /// </summary>
    [Parameter]
    public EventCallback<string> OnCreateNote { get; set; }

    /// <summary>The heading (raw link text) to jump to once the note is mounted; read on the first mount only.</summary>
    [Parameter]
    public string? Heading { get; set; }

    /// <summary>Called with the person's name (as found by PersonParser) when a mention in the text is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnPerson { get; set; }

    /// <summary>Called once per drop of files onto the editor; the parent stores them and calls <see cref="ShowAttachedAsync"/>.</summary>
    [Parameter]
    public EventCallback<DroppedFiles> OnAttach { get; set; }

    /// <summary>Called with the href of a clicked attachment PDF link; the parent opens it.</summary>
    [Parameter]
    public EventCallback<string> OnOpenAttachment { get; set; }

    /// <summary>True when <see cref="Name"/> is a sensitive note: it is unlocked instead of read.</summary>
    [Parameter]
    public bool Sensitive { get; set; }

    /// <summary>Called when the open sensitive note sat unused for too long; the parent saves and locks it.</summary>
    [Parameter]
    public EventCallback OnIdle { get; set; }

    /// <summary>Called when the open sensitive note was locked; the parent takes this editor down.</summary>
    [Parameter]
    public EventCallback OnLocked { get; set; }

    /// <summary>
    /// Called with the open note's headings (in document order) each time they are read from the mounted editor: after
    /// the mount, every Done save, a reload and a shown restore; an empty list when there are none or they can't be
    /// read, and when this editor is disposed or its sensitive note locks. The parent shows them as the outline.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<OutlineHeading>> OnOutline { get; set; }

    private string DisplayName => DesktopText.NoteName(Name);

    /// <summary>
    /// The title text: only the page's own name (the part of <see cref="Name"/> after its last <c>/</c>), cleaned like
    /// <see cref="DisplayName"/>. The breadcrumb above shows the ancestors, and the full name stays in the tooltip.
    /// </summary>
    private string ShownTitle => DesktopText.NoteName(Name[(Name.LastIndexOf('/') + 1)..]);

    /// <summary>True when the text changed since it was opened or last saved.</summary>
    public async Task<bool> IsDirtyAsync() => mounted && !disposed && await Interop.IsDirtyAsync(host);

    /// <summary>
    /// True (without asking the page) while the editor shows unsaved changes, a save runs or an automatic save is
    /// pending: the window close asks this from its own thread.
    /// </summary>
    internal bool HasUnsaved => mounted && !disposed && (dirty || saving || pause is not null);

    /// <summary>True when a note is open in the mounted editor and no save runs: a save can start at once.</summary>
    internal bool IsReady => opened is not null && mounted && !saving;

    /// <summary>
    /// Before the parent leaves the note: waits for a running save, then saves what is still unsaved. True when
    /// nothing unsaved is left; false when that save was refused or failed (its red text is shown).
    /// </summary>
    public async Task<bool> SaveFirstAsync()
    {
        await SaveAsync(true);
        return !await IsDirtyAsync();
    }

    /// <summary>
    /// The one save path, never overlapping: cancels the pending pause, waits for a running save, then saves the
    /// editor's Markdown (or the text as opened when nothing was edited) and shows grey <c>Saving…</c> meanwhile. An
    /// <paramref name="auto"/> save does nothing when nothing is unsaved, ends with grey <c>Saved.</c>, and when it
    /// was refused as busy leaves the status as it was and waits for the next pause; an explicit one ends with accent
    /// <c>Saved &lt;name&gt;.</c>. A refusal or failure shows its red text and keeps the editor's text as it is. A
    /// save keeps the editor clean only when its text is still what was saved. <c>null</c> when nothing was saved.
    /// </summary>
    internal async Task<ActionResult?> SaveAsync(bool auto)
    {
        CancelPause();
        await saveGate.WaitAsync();
        try
        {
            if (disposed || opened is not { } note || !mounted)
            {
                return null;
            }

            Used();
            bool edited = await Interop.IsDirtyAsync(host);
            if (auto && !edited)
            {
                return null;
            }

            string text = edited ? await Interop.GetMarkdownAsync(host) : note.Text;
            (string Text, string Css, List<(string Text, string Css)> Lines) before = (statusText, statusClass, statusLines);
            saving = true;
            ShowStatus("Saving…", "grey");
            StateHasChanged();
            ActionResult result = await Actions.SaveNote(note, text, auto);
            if (disposed)
            {
                return result;
            }

            if (auto && result.Kind == ActionKind.Refused && result.Reason == ActionReason.Busy)
            {
                (statusText, statusClass, statusLines) = before;
                RestartPause();
            }
            else if (result.Kind == ActionKind.Done)
            {
                if (result.Note is { } saved)
                {
                    opened = saved;
                }

                if (edited)
                {
                    // Compared and marked in one turn of the page: what was typed during the save stays unsaved.
                    dirty = !await Interop.MarkCleanIfAsync(host, text);
                    if (dirty)
                    {
                        RestartPause();
                    }
                }

                // Nothing was edited, so the page is already clean; it is not marked clean again, so text typed while
                // this save ran stays unsaved and its own pause saves it.

                ShowStatus(auto ? "Saved." : $"Saved {DesktopText.OneLine(result.Text)}.", auto ? "grey" : "accent");
                await LoadOutlineAsync();
            }
            else
            {
                ShowStatus(DesktopText.OneLine(result.Text), "red");
            }

            return result;
        }
        finally
        {
            saving = false;
            saveGate.Release();
            if (!disposed)
            {
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// What a save writes: the note as opened and the editor's Markdown, or the text as opened when nothing was
    /// edited, so an unedited note is never reformatted. <c>null</c> while no note is open or a save runs.
    /// </summary>
    internal async Task<SaveRequest?> PrepareSaveAsync()
    {
        if (opened is not { } note || !mounted || saving)
        {
            return null;
        }

        bool dirty = await Interop.IsDirtyAsync(host);
        string text = dirty ? await Interop.GetMarkdownAsync(host) : note.Text;
        return new SaveRequest(note, text);
    }

    /// <summary>
    /// Shows how a drop ended: inserts the link of every stored file at the drop position, in drop order (the editor
    /// becomes dirty), and one status line per file (accent when stored, red otherwise), or the one red refusal.
    /// </summary>
    internal async Task ShowAttachedAsync(ActionResult result)
    {
        if (result.Attached is not { } lines)
        {
            ShowStatus(DesktopText.OneLine(result.Text), "red");
            StateHasChanged();
            return;
        }

        List<(string Text, string Css)> shown = [];
        foreach (AttachmentLine line in lines)
        {
            string css = line.Kind == ActionKind.Done ? "accent" : "red";
            if (line.Kind == ActionKind.Done && line.Src is { } src && line.Name is { } stored && mounted)
            {
                try
                {
                    await Interop.InsertAttachmentAsync(host, src, stored, line.IsImage, line.Mime ?? string.Empty, line.Base64);
                }
                catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
                {
                    // The page is gone; the file is stored, only its link wasn't inserted.
                }
            }

            shown.Insert(shown.Count, (DesktopText.OneLine(line.Text), css));
        }

        statusText = string.Empty;
        statusClass = string.Empty;
        statusLines = shown;
        StateHasChanged();
    }

    /// <summary>
    /// Reads the plain note again and mounts the editor with that text, without taking the focus: after something
    /// else (a capture) wrote the note while it was open without unsaved changes. A sensitive note, an editor that
    /// isn't mounted or a running save is left alone; a note that can't be read any more keeps what is shown.
    /// </summary>
    internal async Task ReloadAsync()
    {
        if (Sensitive || !mounted || saving)
        {
            return;
        }

        CancelPause();
        CancelTitleFetches();

        EditableNote? note = await State.ReadForEdit(Name);
        if (note is null)
        {
            return;
        }

        try
        {
            await Interop.MountAsync(host, note.Text, await State.InlineImages(Name, note.Text), Name);
            opened = note;
            dirty = false;
            await LoadAttributesAsync();
            await LoadOutlineAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; the editor keeps what it has.
        }

        StateHasChanged();
    }

    /// <summary>
    /// Mounts <paramref name="saved"/> (the note as a restore saved it, plain or sensitive) without taking the focus;
    /// it becomes the text as opened. An editor that isn't mounted or a running save is left alone.
    /// </summary>
    internal async Task ShowSavedAsync(EditableNote saved)
    {
        if (!mounted || saving)
        {
            return;
        }

        CancelPause();
        CancelTitleFetches();
        try
        {
            await Interop.MountAsync(host, saved.Text, Sensitive ? [] : await State.InlineImages(Name, saved.Text), Name);
            opened = saved;
            dirty = false;
            ShowStatus(string.Empty, string.Empty);
            await LoadAttributesAsync();
            await LoadOutlineAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; the editor keeps what it has.
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        CancelPause();
        CancelTitleFetches();
        await ClearOutlineAsync();
        Dispose();
        if (Sensitive)
        {
            // Leaving a sensitive note drops its text; the next open asks the OS again.
            State.Session.Locked -= SessionLocked;
            State.Session.IdleReached -= SessionIdle;
            State.Session.Close(Name);
        }

        Interop.TagClicked -= TagClicked;
        Interop.LinkClicked -= LinkClicked;
        Interop.PersonClicked -= PersonClicked;
        Interop.DirtyChanged -= DirtyChanged;
        Interop.FilesDropped -= FilesDropped;
        Interop.AttachmentClicked -= AttachmentClicked;
        Interop.LinkPasted -= LinkPasted;
        Interop.Changed -= EditorChanged;
        await Interop.DestroyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Sensitive)
        {
            State.Session.Locked += SessionLocked;
            State.Session.IdleReached += SessionIdle;
        }

        EditableNote? note = Sensitive ? await State.ReadSensitive(Name) : await State.ReadForEdit(Name);
        if (note is null)
        {
            unreadable = true;
            StateHasChanged();
            return;
        }

        try
        {
            Interop.TagClicked += TagClicked;
            Interop.LinkClicked += LinkClicked;
            Interop.PersonClicked += PersonClicked;
            Interop.DirtyChanged += DirtyChanged;
            Interop.FilesDropped += FilesDropped;
            Interop.AttachmentClicked += AttachmentClicked;
            Interop.LinkPasted += LinkPasted;
            Interop.Changed += EditorChanged;

            // A sensitive note shows no images: nothing next to it is read.
            IReadOnlyList<InlineImage> images = Sensitive ? [] : await State.InlineImages(Name, note.Text);
            await Interop.MountAsync(host, note.Text, images, Name);
            opened = note;
            mounted = true;
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The note was read; only the page's editor didn't start. Nothing is open, so nothing can be saved.
            editorFailed = true;
        }

        if (mounted)
        {
            try
            {
                await Interop.FocusAsync(host);
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
            {
                // The editor is mounted and works; it only didn't take the focus.
            }

            await LoadAttributesAsync();
            await LoadOutlineAsync();
            if (Heading is { } heading)
            {
                await JumpToHeadingAsync(heading);
            }
        }

        StateHasChanged();
    }

    // Reads the mounted editor's headings for the outline; a page that is gone or a malformed list shows none.
    private async Task LoadOutlineAsync()
    {
        if (!mounted || disposed)
        {
            outline = [];
            return;
        }

        try
        {
            outline = OutlineHeading.Parse(await Interop.HeadingsAsync(host));
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            outline = [];
        }

        if (!disposed)
        {
            await OnOutline.InvokeAsync(outline);
        }
    }

    // Reads the mounted editor's attribute rows for the box; a page that is gone or a malformed list shows none.
    private async Task LoadAttributesAsync()
    {
        attributeKeyRefused = false;
        if (!mounted || disposed)
        {
            attributeRows = [];
            return;
        }

        try
        {
            attributeRows = NoteAttribute.Parse(await Interop.AttributesAsync(host));
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            attributeRows = [];
        }
    }

    // A row's value field changed: that row gets the new value (trimmed, whitespace runs as one space).
    private Task ChangeAttribute(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= attributeRows.Count)
        {
            return Task.CompletedTask;
        }

        string value = AttributeValue(e.Value?.ToString());
        List<(int Line, string Key, string Value)> edits = Unchanged();
        edits[index] = (index, attributeRows[index].Key, value);
        return ApplyAttributesAsync(edits);
    }

    // A row's Remove button: every other row stays as it is.
    private Task RemoveAttribute(int index)
    {
        if (index < 0 || index >= attributeRows.Count)
        {
            return Task.CompletedTask;
        }

        List<(int Line, string Key, string Value)> edits = Unchanged();
        edits.RemoveAt(index);
        return ApplyAttributesAsync(edits);
    }

    // The add row: a name AttributeParser accepts becomes a new row (normalized key) after the last one.
    private async Task AddAttribute()
    {
        if (AttributeParser.NormalizeKey(newAttributeKey) is not { } key)
        {
            attributeKeyRefused = true;
            return;
        }

        attributeKeyRefused = false;
        List<(int Line, string Key, string Value)> edits = [.. Unchanged(), (-1, key, AttributeValue(newAttributeValue))];
        if (await ApplyAttributesAsync(edits))
        {
            newAttributeKey = string.Empty;
            newAttributeValue = string.Empty;
        }
    }

    // A typed value trimmed, whitespace runs as one space, and held to AttributeParser.MaxValueLength here too, not only by
    // the field's maxlength.
    private static string AttributeValue(string? typed)
    {
        string value = TagParser.CollapseWhitespace(typed ?? string.Empty);
        return value.Length > AttributeParser.MaxValueLength ? value[..AttributeParser.MaxValueLength].TrimEnd() : value;
    }

    // Every row as read: its index, key and value, so the editor keeps its bytes.
    private List<(int Line, string Key, string Value)> Unchanged() =>
        attributeRows.Select((row, i) => (i, row.Key, row.Value)).ToList();

    // Sends the edits (JSON [{line,key,value}], built here) to the editor, then reads the rows and the dirty state again
    // and restarts the pause, so the next save writes the new block. False when nothing was applied.
    private async Task<bool> ApplyAttributesAsync(List<(int Line, string Key, string Value)> edits)
    {
        if (!mounted || disposed)
        {
            return false;
        }

        Used();
        bool applied = false;
        try
        {
            applied = await Interop.SetAttributesAsync(host, AttributeEditsJson(edits));
            if (applied)
            {
                dirty = await Interop.IsDirtyAsync(host);
            }

            await LoadAttributesAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; the editor keeps what it has.
        }

        if (applied)
        {
            RestartPause();
        }

        return applied;
    }

    private static string AttributeEditsJson(List<(int Line, string Key, string Value)> edits)
    {
        using MemoryStream stream = new MemoryStream();
        using (Utf8JsonWriter json = new Utf8JsonWriter(stream))
        {
            json.WriteStartArray();
            foreach ((int line, string key, string value) in edits)
            {
                json.WriteStartObject();
                json.WriteNumber("line", line);
                json.WriteString("key", key);
                json.WriteString("value", value);
                json.WriteEndObject();
            }

            json.WriteEndArray();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    // Drops the outline and tells the parent: this editor is going away or its note locked.
    private async Task ClearOutlineAsync()
    {
        outline = [];
        try
        {
            await OnOutline.InvokeAsync(outline);
        }
        catch (ObjectDisposedException)
        {
            // The parent is gone too; nothing shows the outline any more.
        }
    }

    /// <summary>
    /// Moves the cursor to the first heading of the open note whose text matches <paramref name="heading"/>
    /// (<see cref="OutlineHeading.IndexOf"/>) and scrolls to it, keeping unsaved text; without such a heading, says so
    /// in grey and stays where it is.
    /// </summary>
    internal async Task JumpToHeadingAsync(string heading)
    {
        if (!mounted || disposed)
        {
            return;
        }

        try
        {
            int index = OutlineHeading.IndexOf(OutlineHeading.Parse(await Interop.HeadingsAsync(host)), heading);
            if (index < 0)
            {
                ShowStatus($"{DisplayName} has no heading {DesktopText.OneLine(heading)}.", "grey");
                return;
            }

            await Interop.ScrollToHeadingAsync(host, index);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; the editor stays where it is.
        }
    }

    /// <summary>
    /// An outline button: moves to the <paramref name="index"/>-th heading of the mounted editor (by index only) and
    /// scrolls to it, keeping unsaved text and the focus; nothing when the editor isn't mounted or is gone.
    /// </summary>
    public async Task JumpToIndexAsync(int index)
    {
        if (!mounted || disposed)
        {
            return;
        }

        Used();
        try
        {
            await Interop.ScrollToHeadingAsync(host, index);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // The page is gone; the editor stays where it is.
        }
    }

    // Ctrl/Cmd+S saves at once; every other key only counts as use.
    private async Task Save(KeyboardEventArgs key)
    {
        Used();
        if ((key.CtrlKey || key.MetaKey) && string.Equals(key.Key, "s", StringComparison.OrdinalIgnoreCase))
        {
            await SaveAsync(false);
        }
    }

    // Every change of the text starts the pause again; only the last one before a quiet pause leads to a save.
    private Task EditorChanged() => InvokeAsync(RestartPause);

    private void RestartPause()
    {
        CancelPause();
        if (disposed || !mounted)
        {
            return;
        }

        pause = new CancellationTokenSource();
        _ = AutoSaveAsync(pause.Token);
    }

    private void CancelPause()
    {
        if (pause is { } pending)
        {
            pause = null;
            pending.Cancel();
            pending.Dispose();
        }
    }

    // Waits for the pause, then saves on the renderer's thread unless the pause was cancelled meanwhile.
    private async Task AutoSaveAsync(CancellationToken cancel)
    {
        try
        {
            await Pause.WaitAsync(cancel);
            await InvokeAsync(async () =>
            {
                if (!cancel.IsCancellationRequested && !disposed)
                {
                    await SaveAsync(true);
                }
            });
        }
        catch (Exception e) when (e is OperationCanceledException or JSException or JSDisconnectedException or ObjectDisposedException)
        {
            // Cancelled by a newer edit, a save or the editor going away; or the page is gone.
        }
    }

    // Typing, pasting and saving count as use of an open sensitive note.
    private void Used()
    {
        if (Sensitive)
        {
            State.Session.Touch();
        }
    }

    private void SessionLocked() => _ = InvokeAsync(async () =>
    {
        attributeRows = [];
        StateHasChanged();
        await ClearOutlineAsync();
        await OnLocked.InvokeAsync();
    });

    private void SessionIdle() => _ = InvokeAsync(() => OnIdle.InvokeAsync());

    private Task TagClicked(string raw) => InvokeAsync(async () =>
    {
        IReadOnlyList<string> tags = TagParser.Parse(raw);
        if (tags.Count > 0)
        {
            await OnTag.InvokeAsync(tags[0]);
        }
    });

    private Task LinkClicked(string raw) => InvokeAsync(async () =>
    {
        IReadOnlyList<string> targets = NoteLinkParser.Parse(raw);
        if (targets.Count == 0)
        {
            return;
        }

        // The whole target names a note first ("C# notes"), then the part before the first # with its heading.
        NoteLinkTarget? link = State.ResolveLink(targets[0]);
        string? heading = link?.Heading;
        if (link is null)
        {
            NoteLinkTarget split = NoteLinkParser.Split(targets[0]);
            heading = split.Note.Length == 0 ? split.Heading : null;
        }

        if (heading is not null && (link is null || string.Equals(link.Note, Name, StringComparison.Ordinal)))
        {
            // "[[#Goals]]", or a heading of this note: a jump in place, unsaved text kept.
            await JumpToHeadingAsync(heading);
            StateHasChanged();
            return;
        }

        if (link is null && OnCreateNote.HasDelegate && NoteLinkParser.Split(targets[0]).Note.Length > 0)
        {
            // A link to a missing note: the parent saves this note first, then creates and opens the new one.
            await OnCreateNote.InvokeAsync(targets[0]);
            return;
        }

        if (link is null)
        {
            ShowStatus($"No note named {DesktopText.OneLine(targets[0])}.", "grey");
            StateHasChanged();
            return;
        }

        if (heading is not null && OnOpenHeading.HasDelegate)
        {
            await OnOpenHeading.InvokeAsync((link.Note, heading));
            return;
        }

        await OnOpenNote.InvokeAsync(link.Note);
    });

    private Task PersonClicked(string raw) => InvokeAsync(async () =>
    {
        IReadOnlyList<string> people = PersonParser.Parse(raw);
        if (people.Count > 0)
        {
            await OnPerson.InvokeAsync(people[0]);
        }
    });

    // Display only: shows or hides the dot; nothing is read or written.
    private Task DirtyChanged(bool changed) => InvokeAsync(() =>
    {
        if (dirty != changed)
        {
            dirty = changed;
            StateHasChanged();
        }
    });

    // A drop goes to the parent, which stores the files (the action refuses a sensitive note).
    private Task FilesDropped(DroppedFiles dropped) => InvokeAsync(() => OnAttach.InvokeAsync(dropped));

    private Task AttachmentClicked(string href) => InvokeAsync(() => OnOpenAttachment.InvokeAsync(href));

    // A lone link was pasted: in a plain note, its page title is looked up in the background (DesktopState.PageTitle
    // asks nothing while the setting is off). A sensitive note's links never leave it.
    private Task LinkPasted(string url) => InvokeAsync(() =>
    {
        if (Sensitive || disposed || !mounted)
        {
            return;
        }

        LastTitleFetch = FetchTitleAsync(url, titleFetches.Token);
    });

    // Hands a found title to the editor, which applies it only while the pasted URL text is still untouched.
    private async Task FetchTitleAsync(string url, CancellationToken cancel)
    {
        string? title = await State.PageTitle(url, cancel);
        if (title is null || cancel.IsCancellationRequested)
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                if (cancel.IsCancellationRequested || disposed || !mounted)
                {
                    return;
                }

                await Interop.SetLinkTitleAsync(host, url, title);
            });
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The page or the editor is gone; the URL stays as pasted.
        }
    }

    private void CancelTitleFetches()
    {
        titleFetches.Cancel();
        titleFetches.Dispose();
        titleFetches = new CancellationTokenSource();
    }

    private void ShowStatus(string text, string cssClass)
    {
        statusText = text;
        statusClass = cssClass;
        statusLines = [];
    }
}
