@using System.Globalization
@inherits StateComponent
@* The !d decisions of every note, or of the notes with a tag (DesktopState.Decisions, jobs 343 and 349), newest
   first, each with its date, label (Decision 1234, Decision ab12-1234), note, people, headline, Copy reference and the
   other notes that hold a copy (Also in); the full paragraph unfolds below. Clicking the label or the headline opens the
   note at the decision, the note button at the top. It reads only (Copy reference writes the clipboard), and reloads
   whenever the state changes. *@

<section class="decisions-panel" aria-label="Decisions">
    <div class="panel-bar">
        <h2 class="cut" title="@Heading">@Heading</h2>
        <button type="button" class="close" @onclick="() => OnClose.InvokeAsync()">Close</button>
    </div>
    @if (!Valid)
    {
        <p class="red" role="status">Type /decisions [tag].</p>
    }
    else if (view is null)
    {
        <p class="grey" role="status">Loading…</p>
    }
    else if (view.Kind is DecisionsViewKind.IndexUnreadable)
    {
        <p class="red" role="status">Can't read the decisions.</p>
    }
    else if (view.Kind is DecisionsViewKind.InvalidTag)
    {
        <p class="red" role="status">Type /decisions [tag].</p>
    }
    else if (view.Decisions.Count == 0)
    {
        <p class="grey" role="status">@Empty</p>
    }
    else
    {
        <ul class="decision-rows">
            @foreach (Decision decision in view.Decisions.Take(MaxRows))
            {
                string name = decision.Note;
                string full = DesktopText.OneLine(name);
                string title = DesktopText.NoteName(decision.Title);
                string people = DesktopText.OneLine(string.Join(", ", decision.People));
                string headline = DesktopText.OneLine(decision.Headline);
                (string Note, int Line) key = (decision.Note, decision.Line);
                bool open = expanded.Contains(key);
                string? label = decision.Label;
                <li>
                    <span class="date grey">@decision.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                    @if (label is string shown)
                    {
                        string marker = $"Decision {shown}";
                        <span class="decision-number"><button type="button" title="Open @marker" @onclick="() => Jump(name, label)">@marker</button></span>
                    }
                    else
                    {
                        <span class="decision-number grey">unnumbered</span>
                    }
                    <button type="button" class="note-button cut" title="@full" @onclick="() => OnOpen.InvokeAsync(name)">@title</button>
                    @if (people.Length > 0)
                    {
                        <span class="people grey cut" title="@people">@people</span>
                    }
                    <span class="text cut" title="@headline"><button type="button" class="cut" @onclick="() => Jump(name, label)">@headline</button></span>
                    @if (label is string copy)
                    {
                        <button type="button" class="decision-copy" aria-label="Copy reference to Decision @copy" title="Copy reference to Decision @copy" @onclick="() => Copy(copy)">Copy</button>
                    }
                    <button type="button" class="decision-expand" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(key)">@(open ? "Hide full text" : "Show full text")</button>
                    @if (decision.Places.Count > 0)
                    {
                        string also = DesktopText.OneLine(string.Join(", ", decision.Places.Select(p => p.Note).Distinct(StringComparer.Ordinal)));
                        <span class="decision-places grey cut" title="@also">Also in: @also</span>
                    }
                    @if (open)
                    {
                        <p class="decision-full">@FullText(decision.Text)</p>
                    }
                </li>
            }
        </ul>
        @if (view.Decisions.Count > MaxRows)
        {
            <p class="grey more">@More(view.Decisions.Count)</p>
        }
    }
</section>

@code {
    /// <summary>At most this many decisions are shown; a grey <c>… N more</c> line follows when there are more.</summary>
    internal const int MaxRows = 100;

    private DecisionsView? view;

    // The rows whose full text is shown, by note and line.
    private HashSet<(string Note, int Line)> expanded = [];
    private string? loaded;
    private int request;

    /// <summary>The tag as typed after <c>/decisions</c>; blank for every note.</summary>
    [Parameter]
    public string Tag { get; set; } = string.Empty;

    /// <summary>Called with a note's name when it is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    /// <summary>
    /// Called with a note's name and the decision's marker token there (<c>ab12-1234</c>) when the label or headline is
    /// clicked (jobs 343 and 349).
    /// </summary>
    [Parameter]
    public EventCallback<(string Name, string Decision)> OnOpenDecision { get; set; }

    [Inject]
    private EditorInterop Interop { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    // A numbered decision opens its note at it (the marker's token from the index); an unnumbered one, one the index no
    // longer knows (or without a delegate) opens the note at the top.
    private async Task Jump(string name, string? label)
    {
        if (label is not null && OnOpenDecision.HasDelegate && DecisionParser.TryParseReference(label, out DecisionRef reference)
            && await State.DecisionNote(reference) is { } found && string.Equals(found.Note, name, StringComparison.Ordinal))
        {
            await OnOpenDecision.InvokeAsync((name, found.Token));
            return;
        }

        await OnOpen.InvokeAsync(name);
    }

    // Job 349: copies the row's reference (#!d1234, #!dab12-1234), rebuilt from its parsed parts, through copyText.
    private async Task Copy(string label)
    {
        if (!DecisionParser.TryParseReference(label, out DecisionRef reference))
        {
            return;
        }

        string text = DecisionParser.Format(reference.Prefix, reference.Number);
        bool ok;
        try
        {
            ok = await Interop.CopyTextAsync(text);
        }
        catch (Exception e) when (e is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException or TaskCanceledException)
        {
            ok = false;
        }

        // Job 455: the Copy reference line goes to the status bar (grey Copied #!d<ref>., red when the clipboard refused).
        Bar.Show(ok ? $"Copied {text}." : $"Can't copy {text}.", ok ? "grey" : "red");
    }

    private void Toggle((string Note, int Line) key)
    {
        // Shown state only (no data is written): a new set with the row added, or the row removed.
        if (!expanded.Remove(key))
        {
            expanded = [.. expanded, key];
        }
    }

    // The paragraph's lines, each through OneLine, joined with line breaks (shown with white-space: pre-wrap).
    private static string FullText(string text) => string.Join('\n', text.Split('\n').Select(DesktopText.OneLine));

    private bool Valid => DecisionsView.TryNormalizeTag(Tag, out _);

    private string Normalized => DecisionsView.TryNormalizeTag(Tag, out string tag) ? tag : string.Empty;

    private string Heading => Normalized.Length == 0
        ? "Decisions"
        : $"Decisions: {DesktopText.OneLine(TagParser.Format(Normalized))}";

    private string Empty => Normalized.Length == 0
        ? "No decisions yet."
        : $"No decisions in notes tagged {DesktopText.OneLine(TagParser.Format(Normalized))}.";

    private static string More(int count) =>
        $"{CurrentView.Outside} {(count - MaxRows).ToString(CultureInfo.InvariantCulture)} more";

    protected override Task OnParametersSetAsync()
    {
        if (string.Equals(loaded, Tag, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        // Another tag: its rows are not known yet, so the old ones go.
        loaded = Tag;
        view = null;
        return Load();
    }

    protected override async Task OnStateChangedAsync()
    {
        await Load();
        StateHasChanged();
    }

    // Keeps the shown rows while it reloads. A result for another tag, or an older request's result, is dropped. An
    // invalid tag reads nothing.
    private async Task Load()
    {
        int mine = ++request;
        string tag = Tag;
        if (!DecisionsView.TryNormalizeTag(tag, out _))
        {
            return;
        }

        DecisionsView result = await State.Decisions(tag);
        if (mine == request && string.Equals(tag, Tag, StringComparison.Ordinal))
        {
            view = result;
        }
    }
}
