@inherits StateComponent

<section class="todos">
    <h2>Todos</h2>
    @if (Snapshot is { } snapshot)
    {
        @if (snapshot.TodosUnreadable)
        {
            <p class="red">Can't read todos.json</p>
        }
        else if (snapshot.Todos.Count == 0)
        {
            <p class="grey">No todos yet</p>
        }
        else
        {
            <ul class="todo-list">
                @foreach (TodoItem todo in snapshot.Todos)
                {
                    string text = DesktopText.OneLine(todo.Text);
                    IReadOnlyList<PersonSegment> segments = PersonParser.Segments(text);
                    string when = todo.Due < snapshot.Today ? "overdue" : todo.Due == snapshot.Today ? "today" : "later";
                    <li class="todo">
                        <label class="todo-line">
                            <input type="checkbox" class="done" checked="@(asking?.Id == todo.Id)"
                                   disabled="@(asking is not null || running || adding)" @onchange="() => Ask(todo)" />
                            <span class="date @when">@todo.Due.ToString(DesktopText.DateFormat, CultureInfo.InvariantCulture)</span>
                            @if (todo.Time is { } time)
                            {
                                @(" ")<span class="time">@time.ToString(TodoStore.StoredTimeFormat, CultureInfo.InvariantCulture)</span>
                            }
                            @* A code block drops the whitespace around it, so the space before the text is written out. *@
                            @(" ")
                            @* A mention opens the person's page; its click stops there, so the checkbox never ticks. *@
                            <span class="text cut" title="@text">@if (segments.Any(s => s.IsMention))
                                {
                                    @foreach (PersonSegment segment in segments)
                                    {
                                        @if (segment.Name is { } mentioned)
                                        {
                                            <button type="button" class="mention" title="@segment.Text"
                                                    @onclick="() => OnPerson.InvokeAsync(mentioned)"
                                                    @onclick:preventDefault="true" @onclick:stopPropagation="true">@segment.Text</button>
                                        }
                                        else
                                        {
                                            <span class="plain">@segment.Text</span>
                                        }
                                    }
                                }
                                else
                                {
                                    @text
                                }</span>
                            @if (todo.Repeat is { } repeat)
                            {
                                <span class="repeat" title="@repeat.Label">@repeat.Label</span>
                            }
                        </label>
                    </li>
                }
            </ul>
        }
    }
    @if (result is { } shown)
    {
        @if (shown.Kind == ActionKind.Done)
        {
            @if (shown.NextDue is { } nextDue)
            {
                <p class="result accent" role="status">Done: @(DesktopText.OneLine(shown.Text)). Next due @(nextDue.ToString(DesktopText.DateFormat, CultureInfo.InvariantCulture)).</p>
            }
            else
            {
                <p class="result accent" role="status">Done: @DesktopText.OneLine(shown.Text)</p>
            }
        }
        else
        {
            <p class="result red" role="status">@shown.Text</p>
        }
    }
    else
    {
        <p class="result" role="status"></p>
    }
    @if (Snapshot is { } open)
    {
        DateOnly shownDue = due ?? open.Today;
        bool entryOff = adding || running;
        <div class="todo-entry">
            <input type="text" class="todo-text" value="@newText" maxlength="@DesktopActions.MaxTodoLength"
                   disabled="@entryOff" aria-label="New todo" placeholder="New todo" @ref="textField" @oninput="TextTyped" @onkeydown="e => Add(e)" />
            <input type="date" class="todo-due" value="@shownDue.ToString(DesktopText.DateFormat, CultureInfo.InvariantCulture)"
                   disabled="@entryOff" aria-label="Due date" @onchange="DueChosen" @onkeydown="e => Add(e)" />
            <input type="time" class="todo-time" value="@(dueTime?.ToString(TodoStore.StoredTimeFormat, CultureInfo.InvariantCulture) ?? string.Empty)"
                   disabled="@entryOff" aria-label="Due time" @onchange="TimeChosen" @onkeydown="e => Add(e)" />
            <button type="button" class="due-today" disabled="@entryOff" @onclick="() => due = open.Today">Today</button>
            <button type="button" class="due-tomorrow" disabled="@entryOff" @onclick="() => due = open.Today.AddDays(1)">Tomorrow</button>
        </div>
        @if (added is { } addShown)
        {
            @if (addShown.Kind == ActionKind.Done)
            {
                <p class="add-result accent" role="status">Added: @DesktopText.OneLine(addShown.Text)</p>
            }
            else
            {
                <p class="add-result red" role="status">@addShown.Text</p>
            }
        }
    }
    @if (asking is { } todoAsked)
    {
        <ConfirmDialog Question="@($"Mark this todo done? {todoAsked.Text}")" ConfirmLabel="Mark done"
                       Busy="running" OnConfirm="CompleteAsked" OnCancel="CloseDialog" />
    }
</section>

@code {
    private TodoItem? asking;

    /// <summary>Called with the normalized name of a person mention clicked in a todo's text.</summary>
    [Parameter]
    public EventCallback<string> OnPerson { get; set; }

    private bool running;
    private ActionResult? result;
    private string newText = string.Empty;
    private DateOnly? due;
    private TimeOnly? dueTime;
    private bool adding;
    private ActionResult? added;
    private ElementReference textField;
    private bool refocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // An add started with Enter disables the field while it runs; give the focus back once it is enabled again.
        if (refocus && !adding && !running)
        {
            refocus = false;
            await textField.FocusAsync();
        }
    }

    private void TextTyped(ChangeEventArgs e) => newText = e.Value?.ToString() ?? string.Empty;

    private void DueChosen(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(
            e.Value?.ToString(), DesktopText.DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly chosen))
        {
            due = chosen;
        }
    }

    // An empty or unreadable value means no time; a browser's HH:mm:ss (with a seconds step) keeps HH:mm.
    private void TimeChosen(ChangeEventArgs e)
    {
        string value = e.Value?.ToString() ?? string.Empty;
        if (value.Length == 8 && value[5] == ':')
        {
            value = value[..5];
        }

        dueTime = TodoInput.TryParseTime(value, out TimeOnly chosen) ? chosen : null;
    }

    private async Task Add(KeyboardEventArgs? key)
    {
        if ((key is not null && key.Key != "Enter") || adding || running || Snapshot is not { } snapshot)
        {
            return;
        }

        adding = true;
        try
        {
            added = await Actions.AddTodo(newText, due ?? snapshot.Today, null, dueTime);
            if (added.Kind == ActionKind.Done)
            {
                newText = string.Empty;
                due = null;
                dueTime = null;
            }
        }
        finally
        {
            adding = false;
            refocus = key is not null;
        }
    }

    private void Ask(TodoItem todo)
    {
        if (!running)
        {
            asking = todo;
        }
    }

    /// <summary>
    /// Opens the same <c>Mark this todo done?</c> dialog a ticked checkbox opens, for the todo the palette's
    /// <c>/done</c> picked. Nothing is written until the user confirms.
    /// </summary>
    internal void AskDone(TodoItem todo)
    {
        if (!running && asking is null)
        {
            asking = todo;
            StateHasChanged();
        }
    }

    private void CloseDialog()
    {
        if (!running)
        {
            asking = null;
        }
    }

    private async Task CompleteAsked(Confirmation confirmed)
    {
        if (asking is not { } todoAsked || running)
        {
            return;
        }

        running = true;
        try
        {
            result = await Actions.CompleteTodo(todoAsked, confirmed);
        }
        finally
        {
            running = false;
            asking = null;
        }
    }
}
