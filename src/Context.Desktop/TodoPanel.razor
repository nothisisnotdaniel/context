@inherits StateComponent

<section class="todos">
    <h2>Todos</h2>
    @if (Snapshot is { } snapshot)
    {
        @if (snapshot.TodosUnreadable)
        {
            <p class="red">Can't read todos.json</p>
        }
        else if (snapshot.Todos.Count == 0)
        {
            <p class="grey">No todos yet</p>
        }
        else
        {
            <ol class="todo-list">
                @for (int i = 0; i < snapshot.Todos.Count; i++)
                {
                    TodoItem todo = snapshot.Todos[i];
                    int position = i + 1;
                    string number = position.ToString(CultureInfo.InvariantCulture);
                    string text = DesktopText.OneLine(todo.Text);
                    string when = todo.Due < snapshot.Today ? "overdue" : todo.Due == snapshot.Today ? "today" : "later";
                    <li class="todo">
                        <span class="number">@number</span>
                        <span class="date @when">@todo.Due.ToString(DesktopText.DateFormat, CultureInfo.InvariantCulture)</span>
                        <span class="text cut" title="@text">@text</span>
                        @if (!snapshot.Locked)
                        {
                            <button type="button" class="done" aria-label="@($"Mark todo {number} done")"
                                    disabled="@(asking is not null || running)" @onclick="() => Ask(position, todo)">Done</button>
                        }
                    </li>
                }
            </ol>
        }
    }
    @if (result is { } shown)
    {
        @if (shown.Kind == ActionKind.Done)
        {
            <p class="result accent" role="status">Done: @DesktopText.OneLine(shown.Text)</p>
        }
        else
        {
            <p class="result red" role="status">@shown.Text</p>
        }
    }
    else
    {
        <p class="result" role="status"></p>
    }
    @if (asking is { } todoAsked)
    {
        <ConfirmDialog Question="@($"Mark this todo done? {todoAsked.Item.Text}")" ConfirmLabel="Mark done"
                       Busy="running" OnConfirm="CompleteAsked" OnCancel="CloseDialog" />
    }
</section>

@code {
    private Asked? asking;
    private bool running;
    private ActionResult? result;

    private void Ask(int number, TodoItem todo)
    {
        if (!running)
        {
            asking = new Asked(number, todo);
        }
    }

    private void CloseDialog()
    {
        if (!running)
        {
            asking = null;
        }
    }

    private async Task CompleteAsked(Confirmation confirmed)
    {
        if (asking is not { } todoAsked || running)
        {
            return;
        }

        running = true;
        try
        {
            result = await Actions.CompleteTodo(todoAsked.Number, todoAsked.Item, confirmed);
        }
        finally
        {
            running = false;
            asking = null;
        }
    }

    private sealed class Asked
    {
        public Asked(int number, TodoItem item)
        {
            Number = number;
            Item = item;
        }

        public int Number { get; }

        public TodoItem Item { get; }
    }
}
