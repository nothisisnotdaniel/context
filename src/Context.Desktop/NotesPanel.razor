@inherits StateComponent

<section class="notes">
    <div class="notes-bar">
        <h2>Notes</h2>
        <div class="notes-bar-buttons">
            <button type="button" class="tags-open" @onclick="() => OnTags.InvokeAsync()">Tags</button>
            <button type="button" class="settings-open" @onclick="() => OnSettings.InvokeAsync()">Settings</button>
        </div>
    </div>
    @if (Snapshot is { } snapshot)
    {
        @if (snapshot.NotesUnreadable)
        {
            <p class="red">Can't read the notes folder.</p>
        }
        else if (snapshot.Notes.Count == 0 && snapshot.Sensitive.Count == 0)
        {
            <p class="grey">No notes yet</p>
        }
        else
        {
            <ul class="note-list">
                @foreach ((NoteInfo note, bool locked) in Listed(snapshot))
                {
                    string name = DesktopText.OneLine(note.Name);
                    <li class="note">
                        <button type="button" class="name cut" title="@name" @onclick="() => OnOpen.InvokeAsync(note.Name)">@name</button>
                        @if (locked)
                        {
                            <span class="locked grey">locked</span>
                        }
                        <span class="time grey">@note.Modified.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span>
                    </li>
                }
            </ul>
        }
        <div class="note-entry">
            <input type="text" class="note-new-title" value="@newTitle" maxlength="200" disabled="@creating"
                   aria-label="New note" placeholder="New note title" @oninput="TitleTyped" @onkeydown="e => Create(e)" />
            <button type="button" class="note-new" disabled="@creating" @onclick="() => Create(null)">New note</button>
        </div>
        <div class="note-import">
            <button type="button" class="import" disabled="@importing" @onclick="Import">Import</button>
        </div>
        <div class="import-result" role="status">
            @foreach (ImportLine line in importLines)
            {
                @if (line.Text is { } lineText)
                {
                    <p class="import-line cut @line.Css" title="@lineText">@lineText</p>
                }
            }
        </div>
        @if (replaceQuestion is { } question)
        {
            <ConfirmDialog Question="@question" ConfirmLabel="Replace" Busy="importing"
                           OnConfirm="ReplaceConfirmed" OnCancel="ReplaceCancelled" />
        }
        @if (snapshot.SensitiveSupported)
        {
            <div class="sensitive-entry">
                @if (!snapshot.RecoveryReady)
                {
                    <button type="button" class="sensitive-setup-open" @onclick="OpenSetup">Set up sensitive notes</button>
                }
                <button type="button" class="sensitive-restore-open" @onclick="OpenRestore">Restore from recovery file</button>
            </div>
            @if (sensitiveDone.Length > 0)
            {
                <p class="sensitive-result accent" role="status" title="@sensitiveDone">@sensitiveDone</p>
            }
        }
        @if (setupOpen)
        {
            <SensitiveSetup Restore="restoring" OnDone="SetupDone" OnCancel="CloseSetup" />
        }
        @if (created is { } shown)
        {
            @if (shown.Kind == ActionKind.Done)
            {
                string createdText = $"Created {DesktopText.OneLine(shown.Text)}";
                <p class="note-entry-result accent" role="status" title="@createdText">@createdText</p>
            }
            else
            {
                string failedText = DesktopText.OneLine(shown.Text);
                <p class="note-entry-result red" role="status" title="@failedText">@failedText</p>
            }
        }
    }
</section>

@code {
    private string newTitle = string.Empty;
    private bool creating;
    private ActionResult? created;
    private bool setupOpen;
    private bool restoring;
    private string sensitiveDone = string.Empty;

    /// <summary>The most files one import takes.</summary>
    public const int MaxImportFiles = 100;

    public const string TooManyFilesText = "Choose at most 100 files.";

    private IReadOnlyList<ImportLine> importLines = [];
    private bool importing;
    private string? replaceQuestion;

    /// <summary>The OS file dialogs.</summary>
    [Inject]
    internal IFileDialog Dialog { get; set; } = null!;

    /// <summary>Called with a note's name when it is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    /// <summary>Called when the Tags button is clicked.</summary>
    [Parameter]
    public EventCallback OnTags { get; set; }

    /// <summary>Called when the Settings button is clicked.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    // Plain and sensitive notes in one list, by name (ignoring case, then exact); a sensitive one is marked locked.
    private static IEnumerable<(NoteInfo Note, bool Locked)> Listed(DesktopSnapshot snapshot) =>
        snapshot.Notes.Select(n => (Note: n, Locked: false))
            .Concat(snapshot.Sensitive.Select(n => (Note: n, Locked: true)))
            .OrderBy(n => n.Note.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(n => n.Note.Name, StringComparer.Ordinal);

    private void OpenSetup()
    {
        restoring = false;
        setupOpen = true;
        sensitiveDone = string.Empty;
    }

    private void OpenRestore()
    {
        restoring = true;
        setupOpen = true;
        sensitiveDone = string.Empty;
    }

    private void CloseSetup() => setupOpen = false;

    private void SetupDone(string text)
    {
        setupOpen = false;
        sensitiveDone = DesktopText.OneLine(text);
    }

    private void TitleTyped(ChangeEventArgs e)
    {
        newTitle = e.Value?.ToString() ?? string.Empty;
        created = null;
    }

    // Enter in the field or the New note button: creates the note, then opens it through OnOpen (Main asks first
    // when the open note has unsaved changes).
    private async Task Create(KeyboardEventArgs? key)
    {
        if ((key is not null && key.Key != "Enter") || creating)
        {
            return;
        }

        creating = true;
        ActionResult result;
        try
        {
            result = await Actions.CreateNote(newTitle);
            created = result;
        }
        finally
        {
            creating = false;
        }

        if (result.Kind == ActionKind.Done)
        {
            newTitle = string.Empty;
            await OnOpen.InvokeAsync(result.Text);
        }
    }

    // The button, and the palette's /import (Main calls this from its own event handler): asks the OS for Markdown
    // files and stores each as a note. A file that would replace a note is left for the question afterwards.
    internal async Task Import()
    {
        if (importing || replaceQuestion is not null)
        {
            return;
        }

        IReadOnlyList<string> chosen = Dialog.OpenMarkdownFiles();
        if (chosen.Count == 0)
        {
            return;
        }

        if (chosen.Count > MaxImportFiles)
        {
            importLines = [new ImportLine { Text = TooManyFilesText, Css = "red" }];
            StateHasChanged();
            return;
        }

        List<ImportLine> lines = chosen.Select(c => new ImportLine { Source = c }).ToList();
        importLines = lines;
        importing = true;
        try
        {
            foreach (ImportLine line in lines)
            {
                ActionResult result = await Actions.ImportNote(line.Source, null);
                if (result.Reason == ActionReason.NotConfirmed)
                {
                    line.Replaces = result.Text;
                }
                else
                {
                    line.Show(result);
                }

                StateHasChanged();
            }
        }
        finally
        {
            importing = false;
        }

        List<string> names = lines
            .Where(l => l.Replaces is not null)
            .Select(l => l.Replaces!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (names.Count == 1)
        {
            replaceQuestion = $"Replace {names[0]}?";
        }
        else if (names.Count > 1)
        {
            replaceQuestion = $"Replace {names.Count} notes? {string.Join(", ", names)}";
        }

        StateHasChanged();
    }

    // Confirmed in the dialog: the waiting files replace their notes.
    private async Task ReplaceConfirmed(Confirmation confirmed)
    {
        if (importing)
        {
            return;
        }

        importing = true;
        try
        {
            foreach (ImportLine line in importLines.Where(l => l.Text is null))
            {
                line.Show(await Actions.ImportNote(line.Source, confirmed));
            }
        }
        finally
        {
            importing = false;
            replaceQuestion = null;
        }
    }

    // Cancel or Esc in the dialog: the waiting files are dropped and their notes stay as they are.
    private void ReplaceCancelled()
    {
        if (importing)
        {
            return;
        }

        foreach (ImportLine line in importLines.Where(l => l.Text is null))
        {
            line.Text = $"Not replaced: {DesktopText.OneLine(line.Replaces ?? string.Empty)}";
            line.Css = "grey";
        }

        replaceQuestion = null;
    }

    // One chosen file: where it is, the note it would replace (while that waits for the question) and its result line.
    private sealed class ImportLine
    {
        public string Source { get; init; } = string.Empty;

        public string? Replaces { get; set; }

        public string? Text { get; set; }

        public string Css { get; set; } = string.Empty;

        public void Show(ActionResult result)
        {
            Text = DesktopText.OneLine(result.Text);
            Css = result.Kind == ActionKind.Done ? "accent" : "red";
        }
    }
}
