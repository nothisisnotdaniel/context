@* The slim bar across the top of the main area: Capture (a "T" with a text caret), Today (home) and Pick a day
   (calendar). Capture opens a small popover with one text field; Return hands the text to the parent, which captures
   it to the inbox and answers in the main status line. The pick opens a small popover with one native date input; a
   valid date is handed to the parent, which decides (unsaved changes) what to show. At most one popover is open. *@

<div class="top-bar" @onkeydown="Key">
    <div class="top-bar-start"></div>
    <div class="top-bar-buttons">
        <button type="button" class="capture-open" aria-label="Capture" title="Capture" aria-expanded="@(captureOpen ? "true" : "false")" @onclick="ToggleCapture"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h10"/><path d="M9 6v13"/><path d="M19 4v16"/><path d="M17 4h4"/><path d="M17 20h4"/></svg></button>
        <button type="button" class="today-open" aria-label="Today" title="Today" @onclick="() => OnToday.InvokeAsync()"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg></button>
        <button type="button" class="day-pick-open" aria-label="Pick a day" title="Pick a day" aria-expanded="@(open ? "true" : "false")" @onclick="Toggle"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></button>
    </div>
    @if (captureOpen)
    {
        <div class="capture-pop-backdrop" @onclick="Close"></div>
        <div class="capture-pop">
            <input type="text" aria-label="Capture" placeholder="Capture to inbox" maxlength="1000" @ref="captureField"
                   value="@captureText" @oninput="CaptureInput" @onchange="CaptureInput" @onkeydown="CaptureKey" />
        </div>
    }
    @if (open)
    {
        <div class="day-pick-backdrop" @onclick="Close"></div>
        <div class="day-pick">
            <input type="date" aria-label="Day" @ref="field" min="1900-01-01" max="2100-12-31" @onchange="Picked" />
        </div>
    }
</div>

@code {
    private const string Format = "yyyy-MM-dd";

    private bool open;
    private bool focusField;
    private ElementReference field;
    private bool captureOpen;
    private bool focusCapture;
    private bool capturing;
    private string captureText = string.Empty;
    private ElementReference captureField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The popover just opened: the date input takes the focus, so Esc and typing work at once.
        if (focusField && open)
        {
            focusField = false;
            await field.FocusAsync();
        }

        // The capture popover just opened: its text field takes the focus.
        if (focusCapture && captureOpen)
        {
            focusCapture = false;
            await captureField.FocusAsync();
        }
    }

    /// <summary>Called when Today is clicked.</summary>
    [Parameter]
    public EventCallback OnToday { get; set; }

    /// <summary>Called with a valid picked day (1900..2100).</summary>
    [Parameter]
    public EventCallback<DateOnly> OnPick { get; set; }

    /// <summary>Called with the typed text on Return in the capture popover; true when it was captured.</summary>
    [Parameter]
    public Func<string, Task<bool>>? OnCapture { get; set; }

    private void Toggle()
    {
        open = !open;
        focusField = open;
        captureOpen = false;
    }

    private void ToggleCapture()
    {
        captureOpen = !captureOpen;
        focusCapture = captureOpen;
        open = false;
    }

    private void Close()
    {
        open = false;
        captureOpen = false;
    }

    private void Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    private void CaptureInput(ChangeEventArgs e) => captureText = e.Value?.ToString() ?? string.Empty;

    // Return captures the typed text; the popover closes and the field empties only when the capture was done.
    private async Task CaptureKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || capturing || OnCapture is null)
        {
            return;
        }

        capturing = true;
        bool done;
        try
        {
            done = await OnCapture(captureText);
        }
        finally
        {
            capturing = false;
        }

        if (done)
        {
            captureText = string.Empty;
            captureOpen = false;
        }
    }

    private async Task Picked(ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), Format, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly day)
            || day.Year < 1900 || day.Year > 2100)
        {
            return;
        }

        open = false;
        await OnPick.InvokeAsync(day);
    }
}
