<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The RIDs release.yml publishes, so a locked restore has their runtime packages in packages.lock.json. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Context" />
    <InternalsVisibleTo Include="Context.Tests" />
    <InternalsVisibleTo Include="Context.Desktop" />
    <InternalsVisibleTo Include="Context.Desktop.Tests" />
  </ItemGroup>

</Project>
