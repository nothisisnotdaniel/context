<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Every project writes and commits a packages.lock.json (direct and transitive packages, pinned by content hash). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- On GitHub Actions (CI=true) restore fails when a lock file doesn't match; local restores update the lock files. -->
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Strong name by public signing: Context.snk holds only the public key (no private key exists anywhere).
         It gives every assembly an identity with a public key, so InternalsVisibleTo can name friends by name and key
         and an assembly that only copies a friend's name gets no access. It is not a security boundary: .NET does not
         verify strong-name signatures, and anyone can public-sign with this key. -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Context.snk</AssemblyOriginatorKeyFile>
    <!-- The bytes of Context.snk as lower-case hex, for the Key of every InternalsVisibleTo item. -->
    <ContextPublicKey></ContextPublicKey>
  </PropertyGroup>
</Project>
