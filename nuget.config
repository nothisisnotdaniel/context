<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: no machine-wide or user feed can serve a package of this repo. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Every package (Velopack, the vpk tool and the rest) comes from nuget.org. A second source must get its own
       patterns here, or restore can't take a package from it. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
