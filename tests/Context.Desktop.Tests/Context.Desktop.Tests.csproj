<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A test that runs longer than 60 s aborts the run and the log names it (VSTest hang blame, job 491).
         No memory dump is written, so no fixture text lands in a file. -->
    <VSTestBlameHang>true</VSTestBlameHang>
    <VSTestBlameHangTimeout>60s</VSTestBlameHangTimeout>
    <VSTestBlameHangDumpType>none</VSTestBlameHangDumpType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.13.3" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Context.Tests\FakeHttpHandler.cs" Link="FakeHttpHandler.cs" />
    <Compile Include="..\Context.Tests\RemovedFeature.cs" Link="RemovedFeature.cs" />
    <Compile Include="..\Context.Tests\FakeCommitLog.cs" Link="FakeCommitLog.cs" />
    <Compile Include="..\Context.Tests\TodoArchiveFile.cs" Link="TodoArchiveFile.cs" />
    <Compile Include="..\Context.Tests\TestLicences.cs" Link="TestLicences.cs" />
    <Compile Include="..\Context.Tests\FakeLicenceStore.cs" Link="FakeLicenceStore.cs" />
    <Compile Include="..\Context.Tests\FakeTimesRunner.cs" Link="FakeTimesRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Context.Desktop\Context.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Context.Core\Context.Core.csproj" />
  </ItemGroup>

</Project>
