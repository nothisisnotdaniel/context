<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A test that runs longer than 60 s aborts the run and the log names it (VSTest hang blame, job 491).
         No memory dump is written, so no fixture text lands in a file. -->
    <VSTestBlameHang>true</VSTestBlameHang>
    <VSTestBlameHangTimeout>60s</VSTestBlameHangTimeout>
    <VSTestBlameHangDumpType>none</VSTestBlameHangDumpType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Context\Context.csproj" />
    <ProjectReference Include="..\..\src\Context.Core\Context.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Context.Desktop.Tests\FileSnapshot.cs" Link="FileSnapshot.cs" />
  </ItemGroup>

</Project>
